// Prisma schema — ชื่อตาราง/คอลัมน์ snake_case ตาม docs/01 (T-15); model PascalCase; field camelCase
// ทุกตาราง business มี tenant_id + RLS (migration เรียก tms_enable_tenant_rls) — harness ใน test/isolation ตรวจทุกตาราง

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED

  @@map("tenant_status")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE

  @@map("company_status")
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED

  @@map("job_status")
}

/// tenant = ลูกค้าของแพลตฟอร์ม 1 ราย (RLS: เห็นเฉพาะแถวของตัวเอง)
model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  status    TenantStatus @default(TRIAL)
  yearStyle String       @default("BE") @map("year_style") /// BE = พ.ศ., CE = ค.ศ. (D-30)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tenant")
}

/// นิติบุคคลใน tenant (docs/01 §3.1) — ST0 ใช้เป็น resource ตัวอย่างของ plumbing; ST1 ขยายต่อ
model Company {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  legalName     String        @map("legal_name")
  legalNameEn   String?       @map("legal_name_en")
  taxId         String        @map("tax_id") @db.Char(13)
  vatRegistered Boolean       @default(true) @map("vat_registered")
  status        CompanyStatus @default(ACTIVE)
  externalId    String?       @map("external_id")
  version       Int           @default(1)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, taxId])
  @@unique([tenantId, externalId])
  @@index([tenantId, updatedAt, id])
  @@map("company")
}

/// docs/01 §3.7 — (tenant_id, key, path) PK, เก็บ 24 ชม.
model IdempotencyKey {
  tenantId       String    @map("tenant_id") @db.Uuid
  key            String
  path           String
  requestHash    String    @map("request_hash")
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)

  @@id([tenantId, key, path])
  @@index([expiresAt])
  @@map("idempotency_key")
}

/// docs/01 §3.7 — ทุก transition ในหัวข้อ 4 เขียนที่นี่
model DocStatusHistory {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  docType      String   @map("doc_type")
  docId        String   @map("doc_id") @db.Uuid
  fromStatus   String   @map("from_status")
  toStatus     String   @map("to_status")
  event        String
  actorId      String?  @map("actor_id")
  reasonCodeId String?  @map("reason_code_id") @db.Uuid
  note         String?
  at           DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenantId, docType, docId, at])
  @@map("doc_status_history")
}

/// docs/01 §3.7 — แหล่งเดียวของ webhook payload และ audit timeline
model DomainEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  type               String
  version            Int      @default(1)
  occurredAt         DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  entityType         String   @map("entity_type")
  localId            String   @map("local_id") @db.Uuid
  snapshot           Json
  previousAttributes Json?    @map("previous_attributes")
  requestId          String?  @map("request_id")
  actorId            String?  @map("actor_id")

  @@index([tenantId, occurredAt])
  @@index([tenantId, entityType, localId])
  @@map("domain_event")
}

/// งาน async (ST0-T11) — worker หยิบแบบ round-robin ต่อ tenant
model Job {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  type        String
  status      JobStatus @default(PENDING)
  payload     Json      @default("{}")
  progress    Int       @default(0) /// 0–100
  result      Json?
  error       Json?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  runAt       DateTime  @default(dbgenerated("now()")) @map("run_at") @db.Timestamptz(6) /// ฐานข้อมูลใส่เอง — กันนาฬิกาเครื่อง app/DB ไม่ตรงกัน
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, runAt])
  @@index([tenantId, createdAt])
  @@map("job")
}

// =====================================================================
// Schema v0 (ST0-T19) — ตาม docs/01 §3 + plan/11-reconcile-decisions.md
// ST1–ST2: freeze · ST3–ST4: ร่าง (รอ D-07, D-24) · ST5–ST6: ยังไม่ใส่ (รอนักบัญชี)
// ทุกตารางมี tenant_id + RLS (migration 0004) — เงิน numeric(14,2), เวลา timestamptz
// =====================================================================

// ---------- ST1 Platform ----------
enum UserStatus {
  INVITED
  ACTIVE
  DISABLED

  @@map("user_status")
}

/// ผู้ใช้ภายใน tenant (A2: ผู้ใช้หลายบริษัท = P1)
model AppUser {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  email        String
  name         String
  phone        String?
  passwordHash String?    @map("password_hash") /// argon2id (T-04)
  totpSecret   String?    @map("totp_secret") /// เข้ารหัสด้วย FieldCipher
  totpEnabledAt DateTime? @map("totp_enabled_at") @db.Timestamptz(6) /// ตั้ง 2FA สำเร็จ (ST1-T05)
  totpLastStep  BigInt?   @map("totp_last_step") /// time-step ล่าสุดที่ใช้แล้ว — กันใช้รหัสเดิมซ้ำ
  tokenVersion Int        @default(0) @map("token_version")
  status       UserStatus @default(INVITED)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(6)
  version      Int        @default(1)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, email])
  @@map("app_user")
}

/// role ของ tenant (ชุดระบบ 8 role — plan/11 ข้อ 11) — permission แบบ `resource:verb`
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String
  nameTh      String   @map("name_th")
  nameEn      String?  @map("name_en")
  permissions String[]
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, code])
  @@map("role")
}

model UserRole {
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  companyId String?  @map("company_id") @db.Uuid /// null = ทุกนิติบุคคล
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  id        String   @id @default(uuid()) @db.Uuid

  @@unique([tenantId, userId, roleId, companyId])
  @@map("user_role")
}

/// สถานประกอบการตาม ภ.พ.20 (docs/01 §3.1)
model Branch {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  branchCode      String   @map("branch_code") @db.Char(5)
  branchLabel     String   @map("branch_label")
  address         Json
  hqPrintsForAll  Boolean  @default(false) @map("hq_prints_for_all")
  isDefaultIssuer Boolean  @default(false) @map("is_default_issuer")
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// + partial unique `branch_one_default_issuer_per_company` (company_id) WHERE is_default_issuer (migration 0008)
  @@unique([tenantId, companyId, branchCode])
  @@map("branch")
}

enum DocType {
  SO
  TRIP
  DO
  BN
  INV
  TXINV
  RCP
  CN
  DN
  STL
  WHT
  WO
  INC

  @@map("doc_type")
}

enum ResetPolicy {
  MONTHLY
  YEARLY
  NEVER

  @@map("reset_policy")
}

/// เลขรันต่อ (tenant, ประเภท, สาขา, งวด) — ออกเลขตอน finalize ด้วย FOR UPDATE (docs/01 §3.5)
model DocumentSequence {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  docType        DocType     @map("doc_type")
  branchId       String?     @map("branch_id") @db.Uuid
  periodKey      String      @map("period_key")
  resetPolicy    ResetPolicy @default(MONTHLY) @map("reset_policy")
  prefixTemplate String      @map("prefix_template")
  padding        Int         @default(4)
  nextValue      BigInt      @default(1) @map("next_value")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// ⚠ index จริงเป็น NULLS NOT DISTINCT (migration 0007) — Prisma แสดงไม่ได้; ห้ามให้ migrate diff สร้างใหม่ทับ (test/schema-constraints.test.ts)
  @@unique([tenantId, docType, branchId, periodKey])
  @@map("document_sequence")
}

/// ชุดเลขเอกสารต่อประเภท (ST1-T15) — ค่าที่ผู้ใช้ตั้งในหน้า "เลขที่เอกสาร"; ตัวนับจริงอยู่ที่ document_sequence ต่อ (สาขา × งวด)
/// prefix รองรับ {BR} = รหัสสาขา; ส่วนงวดต่อท้ายตาม reset_policy (MONTHLY = {YY}{MM}-, YEARLY = {YY}-)
model DocumentSeries {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  docType     DocType     @map("doc_type")
  prefix      String
  resetPolicy ResetPolicy @default(MONTHLY) @map("reset_policy")
  padding     Int         @default(4)
  /// เอกสารภาษี: ตัวนับแยกต่อสาขาผู้ออก (บังคับมีสาขา)
  perBranch   Boolean     @default(false) @map("per_branch")
  version     Int         @default(1)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, docType])
  @@map("document_series")
}

/// audit log (J: เก็บ 5 ปี) — append-only สำหรับ role แอป
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  at         DateTime @default(now()) @db.Timestamptz(6)
  actorId    String?  @map("actor_id")
  actAs      String?  @map("act_as") /// impersonate (claim act)
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  reason     String?
  requestId  String?  @map("request_id")
  ip         String?
  /// ลำดับเขียน (bigserial) — ใช้เรียง/แบ่งหน้า เพราะ at ของแถวใน transaction เดียวเท่ากัน
  seq        BigInt   @default(autoincrement())

  @@index([tenantId, entityType, entityId, at])
  @@index([tenantId, at])
  @@index([tenantId, seq])
  @@index([tenantId, entityType, entityId, seq])
  @@map("audit_log")
}

// ---------- ST2 Master data + Fleet P0 ----------
enum ActiveStatus {
  ACTIVE
  INACTIVE

  @@map("active_status")
}

enum BillingCycle {
  PER_DO
  WEEKLY
  MONTHLY
  MANUAL

  @@map("billing_cycle")
}

enum TaxInvoiceMode {
  ON_PAYMENT
  ON_ISSUE

  @@map("tax_invoice_mode")
}

model Customer {
  id                      String         @id @default(uuid()) @db.Uuid
  tenantId                String         @map("tenant_id") @db.Uuid
  code                    String
  externalId              String?        @map("external_id")
  legalName               String         @map("legal_name")
  taxId                   String?        @map("tax_id") @db.Char(13)
  branchCode              String?        @map("branch_code") @db.Char(5)
  billingAddress          Json           @map("billing_address")
  billingCycle            BillingCycle   @default(MONTHLY) @map("billing_cycle")
  paymentTermDays         Int            @default(30) @map("payment_term_days")
  taxInvoiceMode          TaxInvoiceMode @default(ON_PAYMENT) @map("tax_invoice_mode")
  defaultVatType          VatType?       @map("default_vat_type") /// D-28 ค่าตั้งต้น — ค่าจริงอยู่ที่บรรทัด
  whtExpectedRate         Decimal?       @map("wht_expected_rate") @db.Decimal(5, 2)
  creditLimit             Decimal?       @map("credit_limit") @db.Decimal(14, 2)
  podRequirements         Json           @default("{}") @map("pod_requirements")
  defaultBillingCompanyId String?        @map("default_billing_company_id") @db.Uuid
  status                  ActiveStatus   @default(ACTIVE)
  version                 Int            @default(1)
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, code])
  @@unique([tenantId, externalId])
  @@index([tenantId, updatedAt, id])
  @@map("customer")
}

enum GeocodeStatus {
  OK
  PENDING
  FAILED

  @@map("geocode_status")
}

/// จุดรับ/ส่ง (UI: "สถานที่ / จุดรับส่ง")
model CustomerSite {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  customerId         String?       @map("customer_id") @db.Uuid /// null = จุดของบริษัทเอง (คลัง/ปั๊ม/จุดพัก)
  name               String
  address            Json
  lat                Decimal?      @db.Decimal(9, 6)
  lng                Decimal?      @db.Decimal(9, 6)
  geocodeStatus      GeocodeStatus @default(PENDING) @map("geocode_status")
  aliases            String[]
  openTime           String?       @map("open_time")
  closeTime          String?       @map("close_time")
  vehicleTypeAllowed String[]      @map("vehicle_type_allowed")
  avgDwellMin        Int?          @map("avg_dwell_min")
  freeTimeMin        Int?          @map("free_time_min")
  contact            Json?
  externalId         String?       @map("external_id")
  status             ActiveStatus  @default(ACTIVE)
  version            Int           @default(1)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, externalId])
  @@index([tenantId, customerId])
  @@index([tenantId, updatedAt, id])
  @@map("customer_site")
}

enum CarrierEntityType {
  INDIVIDUAL
  JURISTIC

  @@map("carrier_entity_type")
}

/// รถร่วม — แยกจาก driver เด็ดขาด
model Carrier {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  code            String
  externalId      String?           @map("external_id")
  legalName       String            @map("legal_name")
  entityType      CarrierEntityType @map("entity_type")
  taxIdEnc        String?           @map("tax_id_enc") /// บุคคลธรรมดา = เลขบัตร → FieldCipher
  taxIdLast4      String?           @map("tax_id_last4")
  branchCode      String?           @map("branch_code") @db.Char(5)
  whtRateDefault  Decimal           @default(1.00) @map("wht_rate_default") @db.Decimal(5, 2)
  bankAccountEnc  String?           @map("bank_account_enc") /// FieldCipher
  paymentTermDays Int               @default(30) @map("payment_term_days")
  requirePodToPay Boolean           @default(true) @map("require_pod_to_pay")
  phone           String?
  lineContact     String?           @map("line_contact")
  score           Json              @default("{}")
  status          ActiveStatus      @default(ACTIVE)
  version         Int               @default(1)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, code])
  @@unique([tenantId, externalId])
  @@index([tenantId, updatedAt, id])
  @@map("carrier")
}

/// ประเภทรถ (master — D-29 ผสม: docs ใช้ enum, UI มีหน้าประเภทรถ)
model VehicleType {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  code            String /// PICKUP / 6W / 10W / TRAILER / REEFER …
  nameTh          String       @map("name_th")
  capacityKg      Decimal?     @map("capacity_kg") @db.Decimal(10, 2)
  capacityCbm     Decimal?     @map("capacity_cbm") @db.Decimal(10, 2)
  minLicenceClass String?      @map("min_licence_class") /// ท.2 / ท.3 / ท.4 (LEG-17 รอตาราง)
  status          ActiveStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, code])
  @@map("vehicle_type")
}

enum Ownership {
  OWN
  SUBCONTRACT

  @@map("ownership")
}

enum VehicleStatus {
  READY
  MAINTENANCE
  PARKED
  RETIRED

  @@map("vehicle_status")
}

model Vehicle {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  plate           String
  plateProvince   String        @map("plate_province")
  vehicleTypeId   String        @map("vehicle_type_id") @db.Uuid
  ownership       Ownership
  carrierId       String?       @map("carrier_id") @db.Uuid /// บังคับเมื่อ SUBCONTRACT (CHECK ใน migration)
  capacityKg      Decimal?      @map("capacity_kg") @db.Decimal(10, 2)
  capacityCbm     Decimal?      @map("capacity_cbm") @db.Decimal(10, 2)
  gpsProvider     String?       @map("gps_provider")
  gpsDeviceId     String?       @map("gps_device_id")
  chassisNo       String?       @map("chassis_no")
  engineNo        String?       @map("engine_no")
  brand           String?
  model           String?
  year            Int?
  color           String?
  fuelType        String?       @map("fuel_type")
  odometerKm      Decimal?      @map("odometer_km") @db.Decimal(10, 1)
  pairedVehicleId String?       @map("paired_vehicle_id") @db.Uuid /// หัวลาก ↔ หาง
  purchaseCost    Decimal?      @map("purchase_cost") @db.Decimal(14, 2)
  purchasedOn     DateTime?     @map("purchased_on") @db.Date
  status          VehicleStatus @default(READY)
  externalId      String?       @map("external_id")
  version         Int           @default(1)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, plate, plateProvince])
  @@unique([tenantId, externalId])
  @@index([tenantId, updatedAt, id])
  @@map("vehicle")
}

enum EmploymentType {
  EMPLOYEE_SALARIED
  EMPLOYEE_PER_TRIP
  CARRIER_DRIVER

  @@map("employment_type")
}

model Driver {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  name             String
  phone            String?
  licenceNo        String?        @map("licence_no")
  licenceClass     String?        @map("licence_class")
  licenceExpiresAt DateTime?      @map("licence_expires_at") @db.Date
  employmentType   EmploymentType @map("employment_type")
  carrierId        String?        @map("carrier_id") @db.Uuid /// บังคับเมื่อ CARRIER_DRIVER
  defaultVehicleId String?        @map("default_vehicle_id") @db.Uuid
  status           ActiveStatus   @default(ACTIVE)
  externalId       String?        @map("external_id")
  version          Int            @default(1)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, externalId])
  @@index([tenantId, updatedAt, id])
  @@map("driver")
}

enum VehicleDocType {
  INSURANCE
  ACT
  ANNUAL_TAX
  INSPECTION
  OPERATING_LICENCE
  GPS_DLT
  OTHER

  @@map("vehicle_doc_type")
}

/// เอกสารรถ — ต่ออายุ = แถวใหม่อ้างฉบับเก่า (ST2-T17)
model VehicleDocument {
  id            String         @id @default(uuid()) @db.Uuid
