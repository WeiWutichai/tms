// Prisma schema — ชื่อตาราง/คอลัมน์ snake_case ตาม docs/01 (T-15); model PascalCase; field camelCase
// ทุกตาราง business มี tenant_id + RLS (migration เรียก tms_enable_tenant_rls) — harness ใน test/isolation ตรวจทุกตาราง

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED

  @@map("tenant_status")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE

  @@map("company_status")
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED /// ST1-T18: tenant ปิดฟีเจอร์ของงานนี้แล้ว — ไม่ได้รัน
  SUCCEEDED_WITH_ERRORS /// ST7-T10: ทำครบแต่บางรายการไม่ผ่าน (bulk — ผลรายรายการใน result)

  @@map("job_status")
}

/// tenant = ลูกค้าของแพลตฟอร์ม 1 ราย (RLS: เห็นเฉพาะแถวของตัวเอง)
model Tenant {
  id               String       @id @default(uuid()) @db.Uuid
  name             String
  status           TenantStatus @default(TRIAL)
  yearStyle        String       @default("BE") @map("year_style") /// BE = พ.ศ., CE = ค.ศ. (D-30)
  vehicleQuota     Int?         @map("vehicle_quota") /// ST1-T24 จำนวนรถตามสัญญา (ตั้งจาก Console; null = ยังไม่กำหนด) — บังคับใช้ใน ST2
  planCode         String       @default("std") @map("plan_code") /// ST1-T18 แพ็กเกจ (FK → plan.code, migration 0017) — ตั้งจาก Platform Console (T24)
  rateLimitProfile String?      @map("rate_limit_profile") @db.VarChar(20) /// ST7-T08 ทับโปรไฟล์ rate limit ของแพ็กเกจ (null = ตามแพ็กเกจ) — standard | high (CHECK)
  plan             Plan         @relation(fields: [planCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  /// ST7-T09 live = บริษัทจริง · test = sandbox ของบริษัท `liveTenantId` (แถวแยก ข้อมูลแยกด้วย RLS — migration 0107; แก้ไม่ได้)
  mode             String       @default("live") @db.VarChar(8)
  liveTenantId     String?      @unique @map("live_tenant_id") @db.Uuid
  liveTenant       Tenant?      @relation("TenantSandbox", fields: [liveTenantId], references: [id], onDelete: Restrict)
  sandbox          Tenant?      @relation("TenantSandbox")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("tenant")
}

/// นิติบุคคลใน tenant (docs/01 §3.1) — ST0 ใช้เป็น resource ตัวอย่างของ plumbing; ST1 ขยายต่อ
model Company {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  legalName     String        @map("legal_name")
  legalNameEn   String?       @map("legal_name_en")
  taxId         String        @map("tax_id") @db.Char(13)
  vatRegistered Boolean       @default(true) @map("vat_registered")
  status        CompanyStatus @default(ACTIVE)
  externalId    String?       @map("external_id")
  version       Int           @default(1)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  salesOrders SalesOrder[]
  settlements CarrierSettlement[]

  invoices     Invoice[]
  /// ST5-T11 ใบวางบิล
  billingNotes BillingNote[]

  @@unique([tenantId, taxId])
  @@unique([tenantId, externalId])
  @@index([tenantId, updatedAt, id])
  @@map("company")
}

/// docs/01 §3.7 — (tenant_id, key, path) PK, เก็บ 24 ชม.
model IdempotencyKey {
  tenantId        String    @map("tenant_id") @db.Uuid
  key             String
  path            String
  requestHash     String    @map("request_hash")
  responseStatus  Int?      @map("response_status")
  responseBody    Json?     @map("response_body")
  /// header ที่ต้อง replay คู่กับ body (เช่น ETag) — ST3-T03
  responseHeaders Json?     @map("response_headers")
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)

  @@id([tenantId, key, path])
  @@index([expiresAt])
  @@map("idempotency_key")
}

/// docs/01 §3.7 — ทุก transition ในหัวข้อ 4 เขียนที่นี่
model DocStatusHistory {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  docType      String   @map("doc_type")
  docId        String   @map("doc_id") @db.Uuid
  fromStatus   String   @map("from_status")
  toStatus     String   @map("to_status")
  event        String
  actorId      String?  @map("actor_id")
  reasonCodeId String?  @map("reason_code_id") @db.Uuid
  note         String?
  at           DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenantId, docType, docId, at])
  @@map("doc_status_history")
}

/// docs/01 §3.7 — แหล่งเดียวของ webhook payload และ audit timeline
model DomainEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  type               String
  version            Int      @default(1)
  occurredAt         DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  entityType         String   @map("entity_type")
  localId            String   @map("local_id") @db.Uuid
  snapshot           Json
  previousAttributes Json?    @map("previous_attributes")
  requestId          String?  @map("request_id")
  actorId            String?  @map("actor_id")

  @@index([tenantId, occurredAt])
  @@index([tenantId, entityType, localId])
  @@map("domain_event")
}

/// งาน async (ST0-T11) — worker หยิบแบบ round-robin ต่อ tenant
model Job {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  type        String
  status      JobStatus @default(PENDING)
  payload     Json      @default("{}")
  progress    Int       @default(0) /// 0–100
  result      Json?
  error       Json?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  runAt       DateTime  @default(dbgenerated("now()")) @map("run_at") @db.Timestamptz(6) /// ฐานข้อมูลใส่เอง — กันนาฬิกาเครื่อง app/DB ไม่ตรงกัน
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, runAt])
  @@index([tenantId, createdAt])
  @@map("job")
}

// =====================================================================
// Schema v0 (ST0-T19) — ตาม docs/01 §3 + plan/11-reconcile-decisions.md
// ST1–ST2: freeze · ST3–ST4: ร่าง (รอ D-07, D-24) · ST5–ST6: ยังไม่ใส่ (รอนักบัญชี)
// ทุกตารางมี tenant_id + RLS (migration 0004) — เงิน numeric(14,2), เวลา timestamptz
// =====================================================================

// ---------- ST1 Platform ----------
enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
  DELETED /// ST1-T10: ลบ = anonymize ข้อมูลส่วนตัว เก็บแถวไว้ให้ audit อ้างถึงได้ (ไม่มี hard delete)

  @@map("user_status")
}

/// ผู้ใช้ภายใน tenant (A2: ผู้ใช้หลายบริษัท = P1)
model AppUser {
  id                  String     @id @default(uuid()) @db.Uuid
  tenantId            String     @map("tenant_id") @db.Uuid
  email               String
  name                String
  phone               String?
  passwordHash        String?    @map("password_hash") /// argon2id (T-04)
  totpSecret          String?    @map("totp_secret") /// เข้ารหัสด้วย FieldCipher
  totpEnabledAt       DateTime?  @map("totp_enabled_at") @db.Timestamptz(6) /// ตั้ง 2FA สำเร็จ (ST1-T05)
  totpLastStep        BigInt?    @map("totp_last_step") /// time-step ล่าสุดที่ใช้แล้ว — กันใช้รหัสเดิมซ้ำ
  tokenVersion        Int        @default(0) @map("token_version")
  status              UserStatus @default(INVITED)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(6)
  deletedAt           DateTime?  @map("deleted_at") @db.Timestamptz(6)
  locale              String     @default("th") /// ST1-T09 ภาษา UI: th / en / zh
  timezone            String     @default("Asia/Bangkok")
  signatureDocumentId String?    @map("signature_document_id") @db.Uuid /// ลายเซ็นบนเอกสาร/50 ทวิ (stored_document kind SIGNATURE)
  version             Int        @default(1)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  invitations        UserInvitation[]
  orderLocks         OrderEditLock[]
  orderLockReleases  OrderEditLockRelease[] @relation("OrderLockReleaseHolder")
  orderLocksReleased OrderEditLockRelease[] @relation("OrderLockReleaseBy")
  preferences        UserPreference[]
  savedViews         SavedView[]

  @@unique([tenantId, email])
  @@map("app_user")
}

/// ค่าที่ผู้ใช้เลือกไว้ต่อหน้าจอ (ST3-T13: มุมมอง/field การ์ดบนกระดานวางแผน — docs/04 D2 "View" จำต่อผู้ใช้)
/// 1 แถวต่อ (ผู้ใช้, key) · value = JSON ที่ API ตรวจรูปแบบตาม key (ไม่ใช่เอกสาร — แทนค่าได้ ไม่มี audit)
model UserPreference {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  version   Int      @default(1)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, key])
  @@index([tenantId])
  @@map("user_preference")
}

/// มุมมองที่บันทึกไว้ (saved view) ของตาราง/รายงาน ต่อผู้ใช้ (ST9-T11; docs/04 I UI pattern มาตรฐาน, H บันทึก filter)
/// แชร์ในทีม = P1 (docs/04 H) — เฟส 0 เห็นเฉพาะเจ้าของ · ลบ = soft (deleted_at)
model SavedView {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  user          AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// key ของหน้า เช่น `orders`, `orders.hold`, `vehicles`
  page          String
  name          String
  /// ตัวกรอง/แท็บของหน้า (object แบน — ค่า string/number/boolean/null)
  state         Json
  /// คอลัมน์ที่ซ่อน (string[]) · null = ตามค่าเริ่มต้นของตาราง
  hiddenColumns Json?     @map("hidden_columns")
  isDefault     Boolean   @default(false) @map("is_default")
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([tenantId, userId, page])
  @@map("saved_view")
}

/// role ของ tenant (ชุดระบบ 8 role — plan/11 ข้อ 11) — permission แบบ `resource:verb`
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String
  nameTh      String   @map("name_th")
  nameEn      String?  @map("name_en")
  permissions String[]
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, code])
  @@map("role")
}

model UserRole {
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  companyId String?  @map("company_id") @db.Uuid /// null = ทุกนิติบุคคล
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  id        String   @id @default(uuid()) @db.Uuid

  @@unique([tenantId, userId, roleId, companyId])
  @@map("user_role")
}

/// สถานประกอบการตาม ภ.พ.20 (docs/01 §3.1)
model Branch {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  branchCode      String   @map("branch_code") @db.Char(5)
  branchLabel     String   @map("branch_label")
  address         Json
  hqPrintsForAll  Boolean  @default(false) @map("hq_prints_for_all")
  isDefaultIssuer Boolean  @default(false) @map("is_default_issuer")
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// + partial unique `branch_one_default_issuer_per_company` (company_id) WHERE is_default_issuer (migration 0008)
  invoices     Invoice[]
  /// ST5-T11 ใบวางบิล
  billingNotes BillingNote[]

  @@unique([tenantId, companyId, branchCode])
  @@map("branch")
}

enum DocType {
  SO
  TRIP
  DO
  BN
  INV
  TXINV
  RCP
  CN
  DN
  STL
  WHT
  WO
  INC
  /// ST5-T13 เลขภายในของการรับชำระ (spec/05 §4 `docNo` series PAY — ไม่ใช่ใบเสร็จ D-56)
  PAY

  @@map("doc_type")
}

enum ResetPolicy {
  MONTHLY
  YEARLY
  NEVER

  @@map("reset_policy")
}

/// เลขรันต่อ (tenant, ประเภท, สาขา, งวด) — ออกเลขตอน finalize ด้วย FOR UPDATE (docs/01 §3.5)
model DocumentSequence {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  docType        DocType     @map("doc_type")
  branchId       String?     @map("branch_id") @db.Uuid
  periodKey      String      @map("period_key")
  resetPolicy    ResetPolicy @default(MONTHLY) @map("reset_policy")
  prefixTemplate String      @map("prefix_template")
  padding        Int         @default(4)
  nextValue      BigInt      @default(1) @map("next_value")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// ⚠ index จริงเป็น NULLS NOT DISTINCT (migration 0007) — Prisma แสดงไม่ได้; ห้ามให้ migrate diff สร้างใหม่ทับ (test/schema-constraints.test.ts)
  @@unique([tenantId, docType, branchId, periodKey])
  @@map("document_sequence")
}

/// ชุดเลขเอกสารต่อประเภท (ST1-T15) — ค่าที่ผู้ใช้ตั้งในหน้า "เลขที่เอกสาร"; ตัวนับจริงอยู่ที่ document_sequence ต่อ (สาขา × งวด)
/// prefix รองรับ {BR} = รหัสสาขา; ส่วนงวดต่อท้ายตาม reset_policy (MONTHLY = {YY}{MM}-, YEARLY = {YY}-)
model DocumentSeries {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  docType     DocType     @map("doc_type")
  prefix      String
  resetPolicy ResetPolicy @default(MONTHLY) @map("reset_policy")
  padding     Int         @default(4)
  /// เอกสารภาษี: ตัวนับแยกต่อสาขาผู้ออก (บังคับมีสาขา)
  perBranch   Boolean     @default(false) @map("per_branch")
  version     Int         @default(1)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, docType])
  @@map("document_series")
}

/// audit log (J: เก็บ 5 ปี) — append-only สำหรับ role แอป
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  at         DateTime @default(now()) @db.Timestamptz(6)
  actorId    String?  @map("actor_id")
  actAs      String?  @map("act_as") /// impersonate (claim act)
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  reason     String?
  requestId  String?  @map("request_id")
  ip         String?
  /// ลำดับเขียน (bigserial) — ใช้เรียง/แบ่งหน้า เพราะ at ของแถวใน transaction เดียวเท่ากัน
  seq        BigInt   @default(autoincrement())

  @@index([tenantId, entityType, entityId, at])
  @@index([tenantId, at])
  @@index([tenantId, seq])
  @@index([tenantId, entityType, entityId, seq])
  @@map("audit_log")
}

// ---------- ST2 Master data + Fleet P0 ----------
enum ActiveStatus {
  ACTIVE
  INACTIVE

  @@map("active_status")
}

enum BillingCycle {
  PER_DO
  WEEKLY
  MONTHLY
  MANUAL

  @@map("billing_cycle")
}

enum TaxInvoiceMode {
  ON_PAYMENT
  ON_ISSUE

  @@map("tax_invoice_mode")
}

model Customer {
  id                      String          @id @default(uuid()) @db.Uuid
  tenantId                String          @map("tenant_id") @db.Uuid
  code                    String
  externalId              String?         @map("external_id")
  legalName               String          @map("legal_name")
  taxId                   String?         @map("tax_id") @db.Char(13)
  branchCode              String?         @map("branch_code") @db.Char(5)
  billingAddress          Json?           @map("billing_address") /// null = ยังไม่กรอก (ออกใบกำกับภาษีไม่ได้จนกว่าจะกรอก — ST5 ตรวจ)
  contacts                Json            @default("[]") /// [{name, phone, email, isPrimary}] — ST2-T01
  vatRegistered           Boolean         @default(true) @map("vat_registered") /// ลูกค้าจด VAT หรือไม่ (docs/04 B)
  etaxCapable             Boolean         @default(false) @map("etax_capable") /// รับ e-Tax Invoice ได้ไหม (docs/04 B)
  freeTimeMin             Int?            @map("free_time_min") /// free time ค่ารอ (นาที) — null = ใช้ค่าตั้งองค์กร
  salesOwnerUserId        String?         @map("sales_owner_user_id") @db.Uuid
  deletedAt               DateTime?       @map("deleted_at") @db.Timestamptz(6) /// MD-004 soft delete (เฉพาะรายการที่ไม่เคยถูกอ้างอิง)
  deletedExternalId       String?         @map("deleted_external_id") /// externalId เดิมของรายการที่ลบ (ปล่อย externalId ให้ระบบต้นทางส่งใหม่ได้)
  billingCycle            BillingCycle    @default(MONTHLY) @map("billing_cycle")
  paymentTermDays         Int             @default(30) @map("payment_term_days")
  taxInvoiceMode          TaxInvoiceMode  @default(ON_PAYMENT) @map("tax_invoice_mode")
  defaultVatType          VatType?        @map("default_vat_type") /// D-28 ค่าตั้งต้น — ค่าจริงอยู่ที่บรรทัด
  whtExpectedRate         Decimal?        @map("wht_expected_rate") @db.Decimal(5, 2)
  creditLimit             Decimal?        @map("credit_limit") @db.Decimal(14, 2)
  podRequirements         Json            @default("{}") @map("pod_requirements")
  /// ST4-T10 (docs/04 E2 "วางบิลตามยอดส่งจริงได้ (ตั้งต่อลูกค้า)") — true = ค่าขนส่งที่คิดตามน้ำหนัก/ปริมาตร/หน่วยนับ ใช้ปริมาณส่งจริง
  billByActualQty         Boolean         @default(false) @map("bill_by_actual_qty")
  /// ST5-T04 "ไม่มี POD ไม่วางบิล" (docs/04 F3; spec/05 §1 requirePodForBilling) — true = DO ต้องมีหลักฐานส่งครบตาม checklist ก่อนขึ้นคิวพร้อมวางบิล
  requirePodToBill        Boolean         @default(true) @map("require_pod_to_bill")
  defaultBillingCompanyId String?         @map("default_billing_company_id") @db.Uuid
  status                  ActiveStatus    @default(ACTIVE)
  version                 Int             @default(1)
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  sites                   CustomerSite[]
  products                Product[]
  aliases                 CustomerAlias[]

  rateCards      RateCard[]
  salesOrders    SalesOrder[]
  deliveryOrders DeliveryOrder[]

  invoices     Invoice[]
  payments     Payment[]
  /// ST5-T11 ใบวางบิล
  billingNotes BillingNote[]

  @@unique([tenantId, code])
  @@unique([tenantId, externalId])
  @@index([tenantId, updatedAt, id])
  @@map("customer")
}

enum GeocodeStatus {
  OK
  PENDING
  FAILED

  @@map("geocode_status")
}

/// ประเภทสถานที่ (ต้นแบบ TMS v4: ต้นทาง / ปลายทาง / คลัง / ศูนย์กระจาย — ST2-T02)
enum SiteKind {
  PICKUP
  DROPOFF
  WAREHOUSE

  @@map("site_kind")
}

/// จุดรับ/ส่ง (UI: "สถานที่ / จุดรับส่ง") — ST2-T02; docs/01 §3.2, spec/02 §2
model CustomerSite {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  code               String /// LOC-00001 (MD-002) — unique ไม่สนตัวพิมพ์
  customerId         String?       @map("customer_id") @db.Uuid /// null = จุดของบริษัทเอง (คลัง/ปั๊ม/จุดพัก)
  customer           Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  kind               SiteKind      @default(DROPOFF)
  name               String
  address            Json
  lat                Decimal?      @db.Decimal(9, 6)
  lng                Decimal?      @db.Decimal(9, 6)
  geocodeStatus      GeocodeStatus @default(PENDING) @map("geocode_status") /// OK = มีพิกัด (กรอกเอง/ยืนยันแล้ว) · PENDING = ยังไม่มีพิกัด (มี geocode_lat = รอคนยืนยัน) · FAILED = geocode ไม่พบ/คนปฏิเสธ
  geocodeLat         Decimal?      @map("geocode_lat") @db.Decimal(9, 6) /// พิกัดที่ geocode เสนอ รอคนยืนยัน (ST2-T03) — ยืนยันแล้วย้ายไป lat/lng
  geocodeLng         Decimal?      @map("geocode_lng") @db.Decimal(9, 6)
  geocodeConfidence  Decimal?      @map("geocode_confidence") @db.Decimal(3, 2) /// 0–1
  geocodeProvider    String?       @map("geocode_provider") /// ผู้ให้บริการที่เสนอ (mock/none/…)
  geocodedAt         DateTime?     @map("geocoded_at") @db.Timestamptz(6) /// เวลาที่ geocode ครั้งล่าสุด (สำเร็จหรือไม่พบ)
  geocodeSeq         Int           @default(0) @map("geocode_seq") /// เลขคำขอ geocode ล่าสุด — job เขียนผลได้เฉพาะเมื่อเลขตรง (กัน job เก่าทับผล/การปฏิเสธของคน)
  geofenceRadiusM    Int           @default(200) @map("geofence_radius_m") /// 50–2,000 ม.
  aliases            String[]      @default([]) /// ข้อความที่ใช้เรียกจุดนี้ (จับคู่อัตโนมัติ ST3-T06)
  aliasSearch        String        @default("") @map("alias_search") /// aliases ตัวเล็กครอบ/คั่นด้วย \n — trigger ในฐานข้อมูลเขียนเอง (0036) ห้ามเขียนจากแอป
  addressSearch      String        @default("") @map("address_search") /// ที่อยู่ตัวเล็ก — trigger ในฐานข้อมูลเขียนเอง (0036)
  openTime           String?       @map("open_time") /// HH:MM (ว่าง = 24 ชม.)
  closeTime          String?       @map("close_time") /// HH:MM (< open = ข้ามเที่ยงคืน)
  vehicleTypeAllowed String[]      @default([]) @map("vehicle_type_allowed") /// (ไม่ใช้ — ST2-T04 เลือกจำกัดด้วย max_vehicle_class เทียบ vehicle_type.vehicle_class)
  maxVehicleClass    String?       @map("max_vehicle_class") /// รถเข้าได้สูงสุด 6W/10W/TRAILER/SEMI_TRAILER (null = ไม่จำกัด) — เทียบลำดับกับ vehicle_type.vehicle_class (ST2-T04)
  avgDwellMin        Int?          @map("avg_dwell_min") /// service time (นาที)
  freeTimeMin        Int?          @map("free_time_min")
  dockCount          Int?          @map("dock_count") /// ช่องโหลด (spec/02 §2 dockCount ≥ 0) — ใช้กับคลัง/ต้นทาง (ST2-T09)
  contact            Json?
  notes              String?
  externalId         String?       @map("external_id")
  deletedExternalId  String?       @map("deleted_external_id")
  status             ActiveStatus  @default(ACTIVE)
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamptz(6) /// MD-004 soft delete (เฉพาะที่ไม่เคยถูกอ้างอิง)
  version            Int           @default(1)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  routesFrom Route[] @relation("RouteOrigin")
  routesTo   Route[] @relation("RouteDestination")

  rateCardsFrom RateCard[]       @relation("RateCardOrigin")
  rateCardsTo   RateCard[]       @relation("RateCardDestination")
  orderStops    SalesOrderStop[]
  doOrigins     DeliveryOrder[]  @relation("DoOrigin")
  doDests       DeliveryOrder[]  @relation("DoDest")
  tripStops     TripStop[]

  @@unique([tenantId, externalId])
  @@unique([tenantId, code])
  @@index([tenantId, customerId])
  @@index([tenantId, updatedAt, id])
  @@index([tenantId, kind], map: "customer_site_tenant_kind_idx")
  @@index([tenantId, geocodeStatus], map: "customer_site_tenant_geocode_idx")
  @@map("customer_site")
}

/// ข้อความ/รหัสลูกค้าจากต้นทางที่คนเคยจับคู่ไว้ (ST3-T06 "เรียนรู้ alias" docs/04 C) — order ถัดไปจับคู่เอง
/// EXTERNAL_ID = รหัสลูกค้าของระบบต้นทาง ขอบเขตต่อช่องทาง (`source` เช่น `ERP:krs`, `API`, `EXCEL`) · NAME = ชื่อตามต้นทาง (ทุกช่องทาง, source = '')
/// `value_key` = รหัสตรงตัว (EXTERNAL_ID) หรือ matchKey ของชื่อ (NAME) · คนจับคู่ใหม่ = ย้ายไปลูกค้าใหม่ (audit) · ST7-T15 external_mapping มาแทนส่วน connector ได้
model CustomerAlias {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  kind       String /// EXTERNAL_ID / NAME (CHECK)
  source     String   @default("")
  value      String /// ข้อความตามต้นทาง (ล้างแล้ว)
  valueKey   String   @map("value_key")
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, kind, source, valueKey])
  @@index([tenantId, customerId])
  @@map("customer_alias")
}

/// เส้นทาง (OD pair) — ST2-T09; docs/04 B เส้นทาง "key สำหรับ rate card และจับคู่ order"
/// ต้นทาง/ปลายทางอ้าง customer_site (key เดียวกับ rate_card.origin_site_id/dest_site_id) · ทิศทางมีผล (A→B ≠ B→A)
/// คู่ต้นทาง–ปลายทางห้ามซ้ำใน tenant (ไม่นับที่ลบ — partial unique index ใน migration 0046)
model Route {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  code              String /// RT-0001 (MD-002) — เก็บตัวใหญ่, unique ไม่สนตัวพิมพ์
  originSiteId      String       @map("origin_site_id") @db.Uuid
  origin            CustomerSite @relation("RouteOrigin", fields: [originSiteId], references: [id], onDelete: Restrict)
  destSiteId        String       @map("dest_site_id") @db.Uuid
  dest              CustomerSite @relation("RouteDestination", fields: [destSiteId], references: [id], onDelete: Restrict)
  distanceKm        Decimal      @map("distance_km") @db.Decimal(8, 1) /// ระยะทางอ้างอิง (กม.) — pricing ต่อ กม. ใช้ค่านี้ (ST2-T15)
  standardMinutes   Int?         @map("standard_minutes") /// เวลาเดินทางมาตรฐาน (นาที)
  tollAmount        Decimal?     @map("toll_amount") @db.Decimal(14, 2) /// ค่าผ่านทางต่อเที่ยว (บาท)
  notes             String?
  externalId        String?      @map("external_id")
  deletedExternalId String?      @map("deleted_external_id")
  status            ActiveStatus @default(ACTIVE)
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz(6) /// MD-004 soft delete
  version           Int          @default(1)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, code])
  @@unique([tenantId, externalId])
  @@index([tenantId, originSiteId])
  @@index([tenantId, destSiteId])
  @@index([tenantId, updatedAt, id])
  @@map("route")
}

enum CarrierEntityType {
  INDIVIDUAL
  JURISTIC

  @@map("carrier_entity_type")
}

/// รถร่วม / ผู้รับเหมา (UI: "ผู้รับเหมา") — ST2-T05; docs/04 B Carrier, docs/01 §3.2, spec/10 Carrier
/// entity แยกจาก driver เด็ดขาด · เป็น principal แยกของ portal/magic link (A3 — ไม่นับ seat, ไม่มีแถวใน app_user)
/// เลขบัตรประชาชน (บุคคลธรรมดา) และเลขบัญชีธนาคารเก็บแบบเข้ารหัส (FieldCipher) + 4 หลักท้าย — API ไม่คืนค่าเต็ม
model Carrier {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  code              String /// SUB-0001 (MD-002) — เก็บตัวใหญ่, unique ไม่สนตัวพิมพ์
  externalId        String?           @map("external_id")
  deletedExternalId String?           @map("deleted_external_id")
  legalName         String            @map("legal_name")
  entityType        CarrierEntityType @map("entity_type") /// INDIVIDUAL → ภ.ง.ด.3 · JURISTIC → ภ.ง.ด.53
  taxId             String?           @map("tax_id") @db.Char(13) /// นิติบุคคลเท่านั้น (เลขเปิดเผยได้) — บุคคลธรรมดาเก็บที่ tax_id_enc
  taxIdEnc          String?           @map("tax_id_enc") /// บุคคลธรรมดา = เลขบัตรประชาชน → FieldCipher (DM-018)
  taxIdLast4        String?           @map("tax_id_last4") @db.Char(4)
  taxIdHash         String?           @map("tax_id_hash") /// blind index (HMAC — BLIND_INDEX_KEY) ของเลขบัตรบุคคลธรรมดา ใช้กันซ้ำ
  branchCode        String?           @map("branch_code") @db.Char(5)
  address           Json? /// ที่อยู่ (ใช้บน 50 ทวิ) {line1, …} — null = ยังไม่กรอก
  whtRateDefault    Decimal           @default(1.00) @map("wht_rate_default") @db.Decimal(5, 2) /// ค่าตั้งต้น — ค่าจริงอยู่ที่บรรทัด settlement
  bankCode          String?           @map("bank_code") /// รหัสธนาคาร (KBANK, SCB …)
  bankAccountEnc    String?           @map("bank_account_enc") /// เลขบัญชี → FieldCipher
  bankAccountLast4  String?           @map("bank_account_last4") @db.Char(4)
  bankAccountName   String?           @map("bank_account_name")
  paymentTermDays   Int               @default(30) @map("payment_term_days")
  requirePodToPay   Boolean           @default(true) @map("require_pod_to_pay")
  phone             String?
  lineContact       String?           @map("line_contact")
  parentCarrierId   String?           @map("parent_carrier_id") @db.Uuid /// กลุ่มรถร่วม (ห้ามวน)
  parent            Carrier?          @relation("CarrierParent", fields: [parentCarrierId], references: [id], onDelete: Restrict)
  children          Carrier[]         @relation("CarrierParent")
  billingCompanyId  String?           @map("billing_company_id") @db.Uuid /// "จ้างในนาม" (Tender As — docs/04 A4) null = ค่าเริ่มต้นองค์กร
  maxTripsPerDay    Int?              @map("max_trips_per_day") /// เพดานเที่ยว/วัน (cascade P1)
  priority          Int? /// ลำดับใน cascade (1 = เสนอก่อน)
  score             Json              @default("{}")
  status            ActiveStatus      @default(ACTIVE) /// INACTIVE = "ระงับชั่วคราว" (ต้นแบบ)
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz(6) /// MD-004 soft delete
  version           Int               @default(1)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  vehicles          Vehicle[]
  drivers           Driver[]

  rateCards      RateCard[]
  docSubmissions CarrierDocSubmission[]
  subconOffers   SubconOffer[]
  trips          Trip[]
  settlements    CarrierSettlement[]

  @@unique([tenantId, code])
  @@unique([tenantId, externalId])
  @@index([tenantId, updatedAt, id])
  @@index([tenantId, parentCarrierId])
  @@map("carrier")
}

/// ประเภทรถ (master — D-29 ผสม: docs ใช้ enum, UI มีหน้าประเภทรถ)
/// ประเภทรถ (UI: "ประเภทรถ") — ST2-T04; spec/02 §4 + plan/00a (master ตาม spec, ชั้นรถตาม enum ของ docs)
/// ค่าเริ่มต้นภาษาไทยเขียนตอนสร้าง tenant (`ensureDefaultVehicleTypes` — bootstrap ขั้น vehicle-types)
model VehicleType {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  code              String /// 4W / 6W / 10W / TRL / TRC / REF6 / VT-0001 (MD-002) — เก็บตัวใหญ่, unique ไม่สนตัวพิมพ์
  nameTh            String       @map("name_th") /// ชื่อที่ผู้ใช้เห็น — ห้ามซ้ำใน tenant (ไม่สนตัวพิมพ์, ไม่นับที่ลบ)
  vehicleClass      String       @map("vehicle_class") /// ชั้นรถ 4W/6W/10W/TRAILER/SEMI_TRAILER — เทียบกับ customer_site.max_vehicle_class
  capacityKg        Decimal?     @map("capacity_kg") @db.Decimal(10, 2) /// น้ำหนักบรรทุกมาตรฐาน (กก.) — API บังคับ (spec payloadKg)
  capacityCbm       Decimal?     @map("capacity_cbm") @db.Decimal(10, 2) /// ปริมาตร (ลบ.ม.)
  minLicenceClass   String?      @map("min_licence_class") /// PERSONAL/T1/T2/T3/T4 (OPEN-MD-4 / LEG-17 รอตารางกฎหมาย) — API บังคับ
  capabilityTags    String[]     @default([]) @map("capability_tags") /// REFRIGERATED/CRANE/CONTAINER/HAZMAT (docs/04 B capability tags)
  tempMinC          Decimal?     @map("temp_min_c") @db.Decimal(4, 1) /// ห้องเย็น: อุณหภูมิต่ำสุด/สูงสุด (มีเฉพาะเมื่อมีป้าย REFRIGERATED)
  tempMaxC          Decimal?     @map("temp_max_c") @db.Decimal(4, 1)
  systemKey         String?      @map("system_key") /// แถวค่าเริ่มต้นของระบบ (th.4w …) — กัน bootstrap สร้างซ้ำเมื่อผู้ใช้แก้รหัส/ชื่อ/ลบ
  externalId        String?      @map("external_id")
  deletedExternalId String?      @map("deleted_external_id")
  status            ActiveStatus @default(ACTIVE)
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz(6) /// MD-004 soft delete (เฉพาะที่ไม่เคยถูกอ้างอิง)
  version           Int          @default(1)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  vehicles Vehicle[]

  rateCards   RateCard[]
  salesOrders SalesOrder[]
  trips       Trip[]

  @@unique([tenantId, code])
  @@unique([tenantId, externalId])
  @@unique([tenantId, systemKey])
  @@index([tenantId, updatedAt, id])
  @@map("vehicle_type")
}

/// หน่วยนับ (ST2-T10; docs/04 B สินค้า/หน่วย, spec/02 §3 Unit) — master ต่อ tenant
/// kind COUNT (ชิ้น ถุง พาเลท …) / WEIGHT (to_kg บังคับ) / VOLUME (to_cbm บังคับ)
/// ชุดเริ่มต้นของระบบ (`system_key`) ลบไม่ได้ แก้รหัส/ชนิด/ตัวแปลงไม่ได้ — ปิดใช้ได้ (spec/02 §3)
model Unit {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  code      String /// PCS / BAG / PLT / TON … — เก็บตัวใหญ่, unique ไม่สนตัวพิมพ์
  nameTh    String       @map("name_th") /// ชื่อที่ผู้ใช้เห็น (ถุง พาเลท ตัน …) — ห้ามซ้ำ (ไม่สนตัวพิมพ์, ไม่นับที่ลบ)
  kind      String /// COUNT / WEIGHT / VOLUME
  toKg      Decimal?     @map("to_kg") @db.Decimal(14, 6) /// WEIGHT: 1 หน่วย = ? กก. (ตัน = 1000)
  toCbm     Decimal?     @map("to_cbm") @db.Decimal(14, 6) /// VOLUME: 1 หน่วย = ? ลบ.ม. (ลิตร = 0.001)
  systemKey String?      @map("system_key") /// th.pcs … — แถวค่าเริ่มต้นของระบบ
  status    ActiveStatus @default(ACTIVE)
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz(6)
  version   Int          @default(1)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]
  altUnits ProductAltUnit[]

  rateCards  RateCard[]
  orderLines SalesOrderLine[]

  @@unique([tenantId, code])
  @@unique([tenantId, systemKey])
  @@index([tenantId, updatedAt, id])
  @@map("unit")
}

/// สินค้า (ST2-T10; docs/04 B สินค้า/หน่วย, spec/02 §3 Product) — ใช้คำนวณ load และ compatibility (ST2-T16)
/// น้ำหนัก/ปริมาตรต่อ "หน่วยหลัก"; อุณหภูมิเทียบกับ vehicle_type.temp_min_c/temp_max_c (MD-072), อันตรายเทียบป้าย HAZMAT (MD-071)
model Product {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  code              String /// P-0001 หรือรหัสสินค้าของลูกค้า (MD-002) — เก็บตัวใหญ่, unique ไม่สนตัวพิมพ์
  nameTh            String       @map("name_th")
  customerId        String?      @map("customer_id") @db.Uuid /// null = สินค้าใช้ได้ทุกลูกค้า
  customer          Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  baseUnitId        String       @map("base_unit_id") @db.Uuid
  baseUnit          Unit         @relation(fields: [baseUnitId], references: [id], onDelete: Restrict)
  weightPerUnitKg   Decimal?     @map("weight_per_unit_kg") @db.Decimal(12, 3) /// บังคับเมื่อหน่วยเป็น COUNT
  volumePerUnitCbm  Decimal?     @map("volume_per_unit_cbm") @db.Decimal(12, 4)
  fragile           Boolean      @default(false)
  hazardous         Boolean      @default(false)
  unNumber          String?      @map("un_number") /// 4 หลัก (บังคับเมื่อ hazardous)
  hazardClass       String?      @map("hazard_class") /// 1–9 (+ division เช่น 2.1)
  tempControlled    Boolean      @default(false) @map("temp_controlled")
  tempMinC          Decimal?     @map("temp_min_c") @db.Decimal(4, 1) /// บังคับเมื่อ temp_controlled, −40…+30, min < max
  tempMaxC          Decimal?     @map("temp_max_c") @db.Decimal(4, 1)
  stackable         Boolean      @default(true)
  barcode           String?
  externalId        String?      @map("external_id")
  deletedExternalId String?      @map("deleted_external_id")
  status            ActiveStatus @default(ACTIVE)
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz(6)
  version           Int          @default(1)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  altUnits   ProductAltUnit[]
  orderLines SalesOrderLine[]

  @@unique([tenantId, code])
  @@unique([tenantId, externalId])
  @@index([tenantId, customerId])
  @@index([tenantId, baseUnitId])
  @@index([tenantId, updatedAt, id])
  @@map("product")
}

/// หน่วยแปลงของสินค้า (spec/02 §3 altUnits: 1 พาเลท = 40 ถุง → factor_to_base 40)
model ProductAltUnit {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitId       String   @map("unit_id") @db.Uuid
  unit         Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  factorToBase Decimal  @map("factor_to_base") @db.Decimal(14, 6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([productId, unitId])
  @@index([tenantId, unitId])
  @@map("product_alt_unit")
}

/// ค่าเริ่มต้นของ tenant ที่ bootstrap จัดการแล้ว 1 แถวต่อรายการ (ST2-T04) — กันใส่ซ้ำ/ใส่ภายหลัง
/// INSERTED = สร้างแล้ว (ผู้ใช้ลบ/แก้ภายหลังก็ไม่สร้างใหม่) · SKIPPED = ข้ามเพราะชนรหัส/ชื่อที่ tenant มีอยู่ (ไม่ใส่ภายหลัง)
model TenantDefault {
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String /// เช่น vehicle_type:th.4w
  outcome   String /// INSERTED / SKIPPED
  detail    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([tenantId, key])
  @@map("tenant_default")
}

enum Ownership {
  OWN
  SUBCONTRACT

  @@map("ownership")
}

enum VehicleStatus {
  READY
  MAINTENANCE
  PARKED
  RETIRED

  @@map("vehicle_status")
}

/// รถ (ST2-T06; docs/01 §3.2 + §3.8, docs/04 B รถ + B2.1 ส่วน 1, spec/06 FLT-A)
/// ทะเบียน unique ต่อ tenant แบบ normalize (`plate_key` = ทะเบียนตัดช่องว่าง/ขีด/จุด + จังหวัด) เฉพาะคันที่ยังไม่ปลดระวาง/ลบ (FLT-001)
/// หัวลาก ↔ หาง เก็บสองฝั่ง (`paired_vehicle_id` ชี้หากัน) — service เขียนพร้อมกันใน transaction เดียว
model Vehicle {
  id                 String                   @id @default(uuid()) @db.Uuid
  tenantId           String                   @map("tenant_id") @db.Uuid
  plate              String /// ทะเบียนตามที่กรอก (ตัดช่องว่างซ้อน) เช่น "70-1234"
  plateProvince      String                   @map("plate_province") /// รหัสจังหวัด ISO 3166-2 (TH-10 = กรุงเทพมหานคร)
  plateKey           String                   @map("plate_key") /// normalize: ทะเบียนไม่มีช่องว่าง/ขีด/จุด + "|" + จังหวัด
  plateNorm          String                   @map("plate_norm") /// ทะเบียนอย่างเดียว normalize (เลขไทย → อารบิก, ตัดช่องว่าง/ขีด/จุด) — ใช้ค้นหา
  vehicleTypeId      String                   @map("vehicle_type_id") @db.Uuid
  vehicleType        VehicleType              @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)
  unitRole           String                   @default("SINGLE") @map("unit_role") /// SINGLE / TRACTOR (หัวลาก) / TRAILER (หาง)
  ownership          Ownership
  carrierId          String?                  @map("carrier_id") @db.Uuid /// บังคับเมื่อ SUBCONTRACT (CHECK ใน migration)
  carrier            Carrier?                 @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  capacityKg         Decimal?                 @map("capacity_kg") @db.Decimal(10, 2) /// น้ำหนักบรรทุก (payload) — ไม่ส่ง = ค่าของประเภทรถ
  capacityCbm        Decimal?                 @map("capacity_cbm") @db.Decimal(10, 2)
  tareWeightKg       Decimal?                 @map("tare_weight_kg") @db.Decimal(10, 2) /// น้ำหนักรถเปล่า
  grossWeightKg      Decimal?                 @map("gross_weight_kg") @db.Decimal(10, 2) /// น้ำหนักรวมตามทะเบียน
  gpsProvider        String?                  @map("gps_provider")
  gpsDeviceId        String?                  @map("gps_device_id")
  chassisNo          String?                  @map("chassis_no") /// เลขตัวถัง (vin) — unique ต่อ tenant (ไม่สนตัวพิมพ์)
  chassisNorm        String?                  @map("chassis_norm") /// เลขตัวถัง normalize (ตัดช่องว่าง/ขีด/จุด/ทับ ตัวใหญ่) — unique ต่อ tenant
  engineNo           String?                  @map("engine_no")
  brand              String?
  model              String?
  year               Int?
  color              String?
  fuelType           String?                  @map("fuel_type") /// DIESEL / GASOLINE / NGV / LPG / EV / HYBRID
  tankCapacityL      Int?                     @map("tank_capacity_l")
  odometerKm         Decimal?                 @map("odometer_km") @db.Decimal(10, 1) /// เลขไมล์ปัจจุบัน = reading ACCEPTED ล่าสุด
  odometerSource     String?                  @map("odometer_source") /// MANUAL / TRIP / GPS / FUEL_LOG / WORK_ORDER
  odometerUpdatedAt  DateTime?                @map("odometer_updated_at") @db.Timestamptz(6)
  pairedVehicleId    String?                  @unique @map("paired_vehicle_id") @db.Uuid /// หัวลาก ↔ หาง (ชี้หากันทั้งสองฝั่ง)
  paired             Vehicle?                 @relation("VehiclePair", fields: [pairedVehicleId], references: [id], onDelete: Restrict)
  pairedBy           Vehicle?                 @relation("VehiclePair")
  purchaseCost       Decimal?                 @map("purchase_cost") @db.Decimal(14, 2)
  purchasedOn        DateTime?                @map("purchased_on") @db.Date
  depreciationMethod String?                  @map("depreciation_method") /// STRAIGHT_LINE (เฟสแรกวิธีเดียว — job ST2-T22)
  depreciationYears  Int?                     @map("depreciation_years")
  salvageValue       Decimal?                 @map("salvage_value") @db.Decimal(14, 2)
  photoDocumentIds   String[]                 @default([]) @map("photo_document_ids") @db.Uuid /// รูปรถ (stored_document ST1-T08)
  status             VehicleStatus            @default(READY)
  statusReason       String?                  @map("status_reason")
  retiredAt          DateTime?                @map("retired_at") @db.Timestamptz(6)
  externalId         String?                  @map("external_id")
  deletedExternalId  String?                  @map("deleted_external_id")
  deletedAt          DateTime?                @map("deleted_at") @db.Timestamptz(6) /// soft delete เฉพาะที่ไม่เคยถูกอ้างอิง (FLT-008)
  version            Int                      @default(1)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  odometerReadings   VehicleOdometerReading[]
  documents          VehicleDocument[]
  docSubmissions     CarrierDocSubmission[]
  costs              VehicleCost[]
  defaultDrivers     Driver[]                 @relation("DriverDefaultVehicle")
  scheduleEntries    ScheduleEntry[]
  trips              Trip[]                   @relation("TripVehicle")
  trailerTrips       Trip[]                   @relation("TripTrailer")
  acceptedOffers     SubconOffer[]            @relation("SubconOfferVehicle")

  @@unique([tenantId, externalId])
  @@index([tenantId, updatedAt, id])
  @@index([tenantId, plateKey, id])
  @@index([tenantId, plateNorm])
  @@index([tenantId, vehicleTypeId])
  @@index([tenantId, carrierId])
  @@map("vehicle")
}

/// ประวัติเลขไมล์ (spec/06 FLT-O; ST2-T06 = บันทึกมือ/แก้ไข — แหล่งอื่น (เที่ยว/GPS/น้ำมัน) ใช้ตารางเดียวกันใน ST4+)
/// แก้ไม่ทับค่าเดิม: แถวใหม่ `originalReadingId` + แถวเดิม SUPERSEDED (FLT-285)
model VehicleOdometerReading {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  vehicleId         String   @map("vehicle_id") @db.Uuid
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  readingKm         Decimal  @map("reading_km") @db.Decimal(10, 1)
  readAt            DateTime @map("read_at") @db.Timestamptz(6) /// เวลาที่อ่านเลขไมล์ (occurredAt)
  source            String /// MANUAL / CORRECTION (ST2-T06) · TRIP / GPS / FUEL_LOG / WORK_ORDER / PRETRIP / IMPORT ภายหลัง
  status            String   @default("ACCEPTED") /// ACCEPTED / SUPERSEDED
  reasonType        String?  @map("reason_type") /// แก้ไข: TYPO / METER_REPLACED / GPS_ERROR / MISSED_ENTRY / OTHER
  note              String?
  originalReadingId String?  @map("original_reading_id") @db.Uuid
  createdBy         String?  @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6) /// receivedAt

  @@index([tenantId, vehicleId, readAt])
  @@map("vehicle_odometer_reading")
}

enum EmploymentType {
  EMPLOYEE_SALARIED
  EMPLOYEE_PER_TRIP
  CARRIER_DRIVER

  @@map("employment_type")
}

/// สถานะคนขับ (ST2-T08): ACTIVE = พร้อมใช้ · ON_LEAVE = ลาพัก (ต้นแบบ) · INACTIVE = ปิดใช้งาน (พ้นสภาพ/เลิกจ้าง — spec/06 FLT-P resigned/suspended)
enum DriverStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE

  @@map("driver_status")
}

/// คนขับ (ST2-T08; docs/01 §3.2, docs/04 B คนขับ, spec/06 FLT-P) — ไม่ใช่ผู้ใช้/seat (แอปคนขับ = เฟส 2)
model Driver {
  id                String                 @id @default(uuid()) @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  code              String /// DRV-0001 (MD-002) — เก็บตัวใหญ่, unique ต่อ tenant
  name              String
  phone             String /// เบอร์ตามที่กรอก (ใช้ login แอปคนขับภายหลัง — M1)
  phoneNorm         String                 @map("phone_norm") /// 0XXXXXXXXX (ตัด +66/ขีด/ช่องว่าง) — ห้ามซ้ำในคนขับที่ยังไม่ปิดใช้งาน
  nationalIdEnc     String?                @map("national_id_enc") /// เลขบัตรประชาชน → FieldCipher (docs/04 B "บัตรประชาชน (เข้ารหัส)")
  nationalIdLast4   String?                @map("national_id_last4") @db.Char(4)
  nationalIdHash    String?                @map("national_id_hash") /// blind index (HMAC — BLIND_INDEX_KEY) กันคนขับซ้ำ
  licenceNo         String?                @map("licence_no")
  licenceClass      String?                @map("licence_class") /// PERSONAL / T1–T4 (ท.1–ท.4) — ชุดเดียวกับ vehicle_type.min_licence_class
  licenceExpiresAt  DateTime?              @map("licence_expires_at") @db.Date
  employmentType    EmploymentType         @map("employment_type")
  carrierId         String?                @map("carrier_id") @db.Uuid /// บังคับเมื่อ CARRIER_DRIVER (CHECK ทั้งสองทาง)
  carrier           Carrier?               @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  defaultVehicleId  String?                @map("default_vehicle_id") @db.Uuid /// รถประจำ = ค่าเริ่มต้นตอนจัดรถเท่านั้น (เที่ยวเก็บ snapshot เอง — FLT-305)
  defaultVehicle    Vehicle?               @relation("DriverDefaultVehicle", fields: [defaultVehicleId], references: [id], onDelete: Restrict)
  status            DriverStatus           @default(ACTIVE)
  statusReason      String?                @map("status_reason")
  externalId        String?                @map("external_id")
  deletedExternalId String?                @map("deleted_external_id")
  deletedAt         DateTime?              @map("deleted_at") @db.Timestamptz(6) /// soft delete เฉพาะที่ไม่เคยถูกอ้างอิง (MD-004)
  version           Int                    @default(1)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  docSubmissions    CarrierDocSubmission[]
  trips             Trip[]                 @relation("TripDriver")
  reliefTrips       Trip[]                 @relation("TripReliefDriver")
  acceptedOffers    SubconOffer[]          @relation("SubconOfferDriver")
  scheduleEntries   ScheduleEntry[]

  @@unique([tenantId, externalId])
  @@unique([tenantId, code])
  @@index([tenantId, updatedAt, id])
  @@index([tenantId, carrierId])
  @@index([tenantId, defaultVehicleId])
  @@index([tenantId, licenceExpiresAt])
  @@map("driver")
}

/// ชนิดรายการในตารางรถ/คนขับรายวัน (ST3-T19): LEAVE = วันลาคนขับ · NOTE = โน้ตรายวันของรถหรือคนขับ
enum ScheduleEntryKind {
  LEAVE
  NOTE

  @@map("schedule_entry_kind")
}

/// ตารางรถ/คนขับรายวัน (ST3-T19; docs/04 D2 "คลิกขวาใส่วันลา/โน้ต", spec/06 FLT-302 "on_leave ตามช่วงวันที่")
/// ช่วงวันที่ (วันไทย, รวมสองปลาย) ของคนขับ (LEAVE/NOTE) หรือรถ (NOTE) · ไม่ลบ — ยกเลิกพร้อมเหตุผล + audit
model ScheduleEntry {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  kind         ScheduleEntryKind
  driverId     String?           @map("driver_id") @db.Uuid
  driver       Driver?           @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicleId    String?           @map("vehicle_id") @db.Uuid
  vehicle      Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  startsOn     DateTime          @map("starts_on") @db.Date
  endsOn       DateTime          @map("ends_on") @db.Date
  /// เหตุผลการลา / ข้อความโน้ต
  note         String
  cancelledAt  DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  cancelReason String?           @map("cancel_reason")
  version      Int               @default(1)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tenantId, startsOn, endsOn])
  @@index([tenantId, driverId])
  @@index([tenantId, vehicleId])
  @@map("schedule_entry")
}

/// docs/01 §3.8 (ST2-T17 เปลี่ยนชื่อจาก schema v0: ACT → COMPULSORY_ACT, OPERATING_LICENCE → TRANSPORT_LICENSE, GPS_DLT → GPS_DLT_CERT)
enum VehicleDocType {
  INSURANCE
  COMPULSORY_ACT
  ANNUAL_TAX
  INSPECTION
  TRANSPORT_LICENSE
  GPS_DLT_CERT
  OTHER

  @@map("vehicle_doc_type")
}

/// เอกสารรถ — ต่ออายุ = แถวใหม่อ้างฉบับเก่า (ST2-T17; docs/01 §3.8, spec/06 FLT-C)
/// ชื่อคอลัมน์คงตาม schema v0 (ref_no = doc_no, starts_on/expires_on = valid_from/valid_to, renews_id = renews_document_id)
model VehicleDocument {
  id                    String            @id @default(uuid()) @db.Uuid
  tenantId              String            @map("tenant_id") @db.Uuid
  vehicleId             String            @map("vehicle_id") @db.Uuid
  vehicle               Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  docType               VehicleDocType    @map("doc_type")
  /// ชื่อเอกสาร — ใช้กับ OTHER (ตั้งชื่อเอง)
  title                 String?
  issuer                String?
  refNo                 String?           @map("ref_no")
  coverageClass         String?           @map("coverage_class")
  sumInsured            Decimal?          @map("sum_insured") @db.Decimal(14, 2)
  premium               Decimal?          @db.Decimal(14, 2)
  /// ค่าใช้จ่ายของฉบับนี้ → vehicle_cost category DOCUMENT (รถบริษัท)
  costAmount            Decimal?          @map("cost_amount") @db.Decimal(14, 2)
  startsOn              DateTime          @map("starts_on") @db.Date
  expiresOn             DateTime          @map("expires_on") @db.Date
  fileDocumentIds       String[]          @default([]) @map("file_document_ids") @db.Uuid
  renewsId              String?           @map("renews_id") @db.Uuid
  renews                VehicleDocument?  @relation("VehicleDocRenewal", fields: [renewsId], references: [id], onDelete: Restrict)
  renewedBy             VehicleDocument[] @relation("VehicleDocRenewal")
  /// ACTIVE / EXPIRING / EXPIRED (job รายวัน ST2-T18 ตั้ง — API คำนวณจากวันหมดเสมอ) / SUPERSEDED / CANCELLED
  status                String            @default("ACTIVE")
  isRequiredForDispatch Boolean           @default(false) @map("is_required_for_dispatch")
  /// {d60, d30, d7: timestamptz} กันเตือนซ้ำ (ST2-T18)
  reminderSent          Json              @default("{}") @map("reminder_sent")
  note                  String?
  cancelReason          String?           @map("cancel_reason")
  cancelledAt           DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  createdBy             String?           @map("created_by")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tenantId, vehicleId, docType, expiresOn])
  @@index([tenantId, expiresOn, id])
  @@map("vehicle_document")
}

/// เอกสารที่รถร่วมส่งเองผ่านลิงก์ (ST2-T21; docs/04 B2.1 "carrier อัปโหลดเอกสารเองผ่านลิงก์ LINE ได้")
/// ยังไม่ใช่เอกสารรถ/ใบขับขี่จนกว่า admin อนุมัติ (ไม่นับใน isAssignable) — อนุมัติ → vehicle_document ใหม่หรือต่ออายุฉบับปัจจุบัน
/// / อัปเดตใบขับขี่ของคนขับ · ไม่อนุมัติ = เหตุผลบังคับ · ไม่มีการลบ (เก็บเป็นหลักฐาน)
model CarrierDocSubmission {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  carrierId        String    @map("carrier_id") @db.Uuid
  carrier          Carrier   @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  /// ลิงก์ที่ใช้ส่ง (magic_link purpose carrier_docs)
  magicLinkId      String?   @map("magic_link_id") @db.Uuid
  /// เอกสารรถ — คู่กับ doc_type ของ vehicle_document
  vehicleId        String?   @map("vehicle_id") @db.Uuid
  vehicle          Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  /// ใบขับขี่ — doc_type = DRIVER_LICENCE
  driverId         String?   @map("driver_id") @db.Uuid
  driver           Driver?   @relation(fields: [driverId], references: [id], onDelete: Restrict)
  /// INSURANCE / COMPULSORY_ACT / ANNUAL_TAX / INSPECTION / TRANSPORT_LICENSE / GPS_DLT_CERT / OTHER / DRIVER_LICENCE
  docType          String    @map("doc_type")
  /// เอกสารรถฉบับที่จะต่ออายุ (OTHER ระบุฉบับ; ประเภทอื่น = ฉบับปัจจุบันของประเภทนั้นตอนอนุมัติ)
  targetDocumentId String?   @map("target_document_id") @db.Uuid
  title            String?
  docNo            String?   @map("doc_no")
  issuer           String?
  startsOn         DateTime? @map("starts_on") @db.Date
  expiresOn        DateTime  @map("expires_on") @db.Date
  fileDocumentIds  String[]  @default([]) @map("file_document_ids") @db.Uuid
  note             String?
  /// PENDING_REVIEW / APPROVED / REJECTED
  status           String    @default("PENDING_REVIEW")
  reviewedBy       String?   @map("reviewed_by")
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewReason     String?   @map("review_reason")
  /// vehicle_document ที่เกิดจากการอนุมัติ
  resultDocumentId String?   @map("result_document_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tenantId, carrierId, status, createdAt])
  @@index([tenantId, vehicleId, docType])
  @@index([tenantId, driverId])
  @@map("carrier_doc_submission")
}

/// ledger ต้นทุนต่อคัน (plan/11 ข้อ 15) — append-only (แก้ = แถวกลับรายการ)
model VehicleCost {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  vehicleId   String    @map("vehicle_id") @db.Uuid
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  category    String /// DOCUMENT / DEPRECIATION / FUEL / REPAIR / INCIDENT / OTHER
  amount      Decimal   @db.Decimal(14, 2)
  occurredOn  DateTime  @map("occurred_on") @db.Date
  sourceType  String?   @map("source_type") /// vehicle_document (ST2-T17) · depreciation (ST2-T22)
  sourceId    String?   @map("source_id") @db.Uuid
  periodMonth DateTime? @map("period_month") @db.Date /// วันที่ 1 ของเดือนที่คิดค่าเสื่อม — บังคับเฉพาะ DEPRECIATION (CHECK), unique ต่อรถต่อเดือน (ST2-T22)
  note        String?
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, vehicleId, category, periodMonth])
  @@index([tenantId, vehicleId, occurredOn])
  @@index([tenantId, sourceType, sourceId])
  @@map("vehicle_cost")
}

enum VatType {
  VAT_7
  EXEMPT_TRANSPORT
  ZERO_RATED

  @@map("vat_type")
}

/// ฝั่งที่ใช้รายการได้ (ST2-T11; docs/04 B Accessorial "ฝั่ง (ขาย/ซื้อ/ทั้งคู่)", spec/02 §6 appliesTo)
enum ServiceItemSide {
  SELL
  BUY
  BOTH

  @@map("service_item_side")
}

/// catalog รายการบนเอกสาร (ST2-T11 ค่าบริการเสริม; docs/01 §3.2, spec/02 §6)
/// vat_type/wht_rate/ราคา ถูก snapshot ลงบรรทัดเอกสาร (service-items/snapshot.ts) — แก้ catalog แล้วเอกสารเดิมไม่เปลี่ยน
/// ชุดเริ่มต้นของระบบ (`system_key`) — รหัสสงวน FREIGHT/EXTRA_STOP/FSC ปิดใช้/ลบ/เปลี่ยนรหัสไม่ได้ (MD-158)
model ServiceItem {
  id                 String          @id @default(uuid()) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  code               String /// FREIGHT / WAIT / AX-0001 (MD-002) — เก็บตัวใหญ่, unique ไม่สนตัวพิมพ์
  nameTh             String          @map("name_th") /// พิมพ์บนเอกสาร — ห้ามซ้ำ (ไม่สนตัวพิมพ์, ไม่นับที่ลบ)
  nameEn             String?         @map("name_en")
  vatType            VatType         @map("vat_type")
  whtRate            Decimal         @map("wht_rate") @db.Decimal(5, 2) /// 0.00 / 1.00 / 3.00 (%)
  calcUnit           String          @map("calc_unit") /// PER_TRIP/PER_HOUR/PER_NIGHT/PER_STOP/PERCENT_OF_FREIGHT/ACTUAL
  unitLabel          String          @map("unit_label") /// ข้อความหน่วยบนเอกสาร (เที่ยว ชั่วโมง …) — ระบบเติมตาม calc_unit
  defaultPrice       Decimal?        @map("default_price") @db.Decimal(14, 2) /// บาทก่อน VAT หรือ % (PERCENT_OF_FREIGHT); ACTUAL = null
  fuelRefPrice       Decimal?        @map("fuel_ref_price") @db.Decimal(14, 2) /// ราคาน้ำมันอ้างอิง ฿/ลิตร (PERCENT_OF_FREIGHT)
  conditionText      String?         @map("condition_text") /// เงื่อนไข เช่น "ฟรี 2 ชม. แรก"
  side               ServiceItemSide @default(BOTH)
  isSurcharge        Boolean         @default(false) @map("is_surcharge")
  defaultAccountCode String?         @map("default_account_code")
  systemKey          String?         @map("system_key")
  externalId         String?         @map("external_id")
  deletedExternalId  String?         @map("deleted_external_id")
  status             ActiveStatus    @default(ACTIVE)
  deletedAt          DateTime?       @map("deleted_at") @db.Timestamptz(6)
  version            Int             @default(1)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  rateCards            RateCard[]
  rateCardAccessorials RateCardAccessorial[]
  orderCharges         SalesOrderCharge[]
  revenueLines         RevenueLine[]
  erpCodeMappings      ErpCodeMapping[]

  invoiceLines InvoiceLine[]

  @@unique([tenantId, code])
  @@unique([tenantId, externalId])
  @@unique([tenantId, systemKey])
  @@index([tenantId, updatedAt, id])
  @@map("service_item")
}

enum RateSide {
  SELL
  BUY

  @@map("rate_side")
}

enum PricingModel {
  PER_TRIP
  PER_KM
  PER_TON
  PER_CBM
  PER_UNIT
  PER_DAY

  @@map("pricing_model")
}

enum RateStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  RETIRED

  @@map("rate_status")
}

/// Rate card (ST2-T13 ขาขาย; ST2-T14 ขาซื้อใช้ตารางเดียวกัน `side = BUY`) — docs/01 §3.2, docs/04 B Rate card, spec/02 §5
/// โครงแถวเดียวต่อราคา (key = ฝั่ง + ลูกค้า/รถร่วม + ต้นทาง + ปลายทาง + ประเภทรถ) ตามต้นแบบ TMS v4 specRate [OPEN D-29 — spec/12 §3]
/// สถานะในฐาน DRAFT → APPROVED → RETIRED (plan/11 ข้อ 3 — PENDING_APPROVAL ใช้เมื่อเปิดการอนุมัติ P1)
/// "หมดอายุ" (EXPIRED) คำนวณจาก valid_to < วันนี้ (เวลาไทย) ไม่เก็บ — API/lookup ไม่ใช้ rate หมดอายุ
/// ช่วงวันของ rate ที่ใช้งาน (APPROVED/PENDING_APPROVAL) ใน key เดียวกันห้ามทับ — exclusion constraint `rate_card_no_overlap` (migration 0053, btree_gist)
/// แก้ rate ที่ใช้งานแล้ว = ฉบับแก้ไข (revision ใหม่ code เดิม, parent_id ชี้ฉบับเดิม — MD-118)
model RateCard {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  side              RateSide
  code              String /// RC-S-0001 / RC-B-0001 — ฉบับแก้ไขใช้รหัสเดิม (unique ต่อ code + revision ไม่สนตัวพิมพ์)
  revision          Int                   @default(1) /// ฉบับที่ (MD-118) — 1 = ฉบับแรก
  parentId          String?               @map("parent_id") @db.Uuid /// ฉบับก่อนหน้า (ฉบับแก้ไข)
  parent            RateCard?             @relation("RateCardRevision", fields: [parentId], references: [id], onDelete: Restrict)
  revisions         RateCard[]            @relation("RateCardRevision")
  parentClosed      Boolean               @default(false) @map("parent_closed") /// ตอนอนุมัติฉบับนี้ ระบบปิดฉบับเดิม (ตัดวันหมด/ถูกแทน) — ยกเลิกฉบับนี้แล้วคืนค่าเดิมให้ฉบับเดิม
  parentPrevValidTo DateTime?             @map("parent_prev_valid_to") @db.Date /// วันหมดเดิมของฉบับเดิมก่อนถูกปิด (null = ไม่มีวันหมด)
  parentPrevStatus  RateStatus?           @map("parent_prev_status") /// สถานะเดิมของฉบับเดิมก่อนถูกปิด
  customerId        String?               @map("customer_id") @db.Uuid
  customer          Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  carrierId         String?               @map("carrier_id") @db.Uuid
  carrier           Carrier?              @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  originSiteId      String?               @map("origin_site_id") @db.Uuid
  origin            CustomerSite?         @relation("RateCardOrigin", fields: [originSiteId], references: [id], onDelete: Restrict)
  destSiteId        String?               @map("dest_site_id") @db.Uuid
  dest              CustomerSite?         @relation("RateCardDestination", fields: [destSiteId], references: [id], onDelete: Restrict)
  originZone        String?               @map("origin_zone") /// โซน (MD-124 — P1/เฟส 2) ยังไม่ใช้
  destZone          String?               @map("dest_zone")
  vehicleTypeId     String                @map("vehicle_type_id") @db.Uuid
  vehicleType       VehicleType           @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)
  pricingModel      PricingModel          @map("pricing_model")
  unitPrice         Decimal               @map("unit_price") @db.Decimal(14, 2) /// ราคาต่อหน่วยของสูตร (บาท)
  unitId            String?               @map("unit_id") @db.Uuid /// PER_UNIT: หน่วยนับ (ชิ้น พาเลท …)
  unit              Unit?                 @relation(fields: [unitId], references: [id], onDelete: Restrict)
  minCharge         Decimal?              @map("min_charge") @db.Decimal(14, 2) /// ขั้นต่ำ (B1 PER_DISTANCE / PER_UNIT)
  extraStopPrice    Decimal?              @map("extra_stop_price") @db.Decimal(14, 2) /// เกิน N จุดคิดเพิ่มต่อจุด
  includedStops     Int                   @default(2) @map("included_stops") /// N — จุดที่รวมในราคา (MD-115 ค่าเริ่มต้น 2 = รับ 1 + ส่ง 1)
  fuelSurchargePct  Decimal?              @map("fuel_surcharge_pct") @db.Decimal(5, 2) /// FSC (P1) ยังไม่ใช้
  serviceItemId     String                @map("service_item_id") @db.Uuid /// รายการบนเอกสาร (vat_type/wht_rate) — ค่าเริ่มต้น FREIGHT
  serviceItem       ServiceItem           @relation(fields: [serviceItemId], references: [id], onDelete: Restrict)
  validFrom         DateTime              @map("valid_from") @db.Date
  validTo           DateTime?             @map("valid_to") @db.Date /// null = ไม่มีวันหมด
  status            RateStatus            @default(DRAFT)
  approvedAt        DateTime?             @map("approved_at") @db.Timestamptz(6)
  approvedById      String?               @map("approved_by_id") @db.Uuid
  notes             String?
  externalId        String?               @map("external_id")
  deletedExternalId String?               @map("deleted_external_id")
  deletedAt         DateTime?             @map("deleted_at") @db.Timestamptz(6) /// ลบได้เฉพาะร่าง (MD-004)
  version           Int                   @default(1)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  accessorials      RateCardAccessorial[]
  orderCharges      SalesOrderCharge[]

  @@unique([tenantId, externalId])
  @@index([tenantId, side, customerId, carrierId])
  @@index([tenantId, updatedAt, id])
  @@index([tenantId, originSiteId, destSiteId, vehicleTypeId])
  @@map("rate_card")
}

/// ราคาค่าบริการเสริมเฉพาะ rate นี้ (ต้นแบบ drawer rate "ค่าบริการเพิ่ม (accessorial)") — แทนราคาตั้งต้นของ catalog
/// เก็บเฉพาะรายการที่กำหนดราคา · ราคาถูก snapshot ลงเอกสารภายหลัง (MD-117)
model RateCardAccessorial {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  rateCardId    String      @map("rate_card_id") @db.Uuid
  rateCard      RateCard    @relation(fields: [rateCardId], references: [id], onDelete: Restrict)
  serviceItemId String      @map("service_item_id") @db.Uuid
  serviceItem   ServiceItem @relation(fields: [serviceItemId], references: [id], onDelete: Restrict)
  price         Decimal     @db.Decimal(14, 2)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([rateCardId, serviceItemId])
  @@index([tenantId, serviceItemId])
  @@map("rate_card_accessorial")
}

enum ReasonCategory {
  ORDER_HOLD
  DELIVERY_FAILED
  REJECTED_BY_RECEIVER
  POD_MISSING
  CREDIT_NOTE
  DEBIT_NOTE
  SETTLEMENT_DISPUTE
  OVERRIDE
  CANCEL
  DELAY /// ล่าช้า (docs/04 B Reason master, docs/01 §3.9 stop_event) — ST2-T12

  @@map("reason_category")
}

/// เหตุผลมาตรฐาน (ST2-T12; docs/01 §3.2, docs/04 B Reason master, spec/02 §9) — ใช้ทุกจุดที่บังคับเลือกเหตุผล
/// ข้อความ + ธงถูก snapshot ลงงาน (src/modules/reason-codes/snapshot.ts) แก้ master ไม่ย้อนแก้งานเก่า
model ReasonCode {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  category          ReasonCategory /// เปลี่ยนไม่ได้หลังสร้าง
  code              String /// ตัวใหญ่, unique ต่อหมวด (รวมที่ลบ) — รหัสระบบเปลี่ยนไม่ได้
  labelTh           String         @map("label_th") /// ห้ามซ้ำในหมวด (ไม่สนตัวพิมพ์, ไม่นับที่ลบ)
  labelEn           String?        @map("label_en")
  requiresNote      Boolean        @default(false) @map("requires_note")
  requiresPhoto     Boolean        @default(false) @map("requires_photo")
  autoReschedule    Boolean        @default(false) @map("auto_reschedule") /// เฉพาะ DELIVERY_FAILED (CHECK)
  showOnTracking    Boolean        @default(false) @map("show_on_tracking")
  etdaCode          String?        @map("etda_code") /// ใบลดหนี้/เพิ่มหนี้ (ST5) — ยังไม่เปิดใน API
  isSystem          Boolean        @default(false) @map("is_system") /// รหัสที่ state machine/ระบบใช้ — ลบ/ปิดใช้/เปลี่ยนรหัสไม่ได้
  systemKey         String?        @map("system_key") /// แถวค่าเริ่มต้น (bootstrap) — `CATEGORY:CODE`
  sortOrder         Int            @default(0) @map("sort_order")
  externalId        String?        @map("external_id")
  deletedExternalId String?        @map("deleted_external_id")
  status            ActiveStatus   @default(ACTIVE)
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(6)
  version           Int            @default(1)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  heldOrders    SalesOrder[]
  doLineRejects DeliveryOrderLine[]
  tripCancels   Trip[]              @relation("TripCancelReason")
  stopFailures  TripStop[]
  stopEvents    StopEvent[]

  @@unique([tenantId, category, code])
  @@unique([tenantId, externalId])
  @@unique([tenantId, systemKey])
  @@index([tenantId, updatedAt, id])
  @@map("reason_code")
}

// ---------- ST3 Orders / Planning (ร่าง — รอ D-07, D-24) ----------
enum OrderSource {
  MANUAL
  IMPORT
  API
  PORTAL
  CONNECTOR

  @@map("order_source")
}

enum SoStatus {
  DRAFT /// D-21
  RECEIVED
  ON_HOLD
  PLANNED
  IN_TRANSIT
  PARTIALLY_DELIVERED
  DELIVERED
  CLOSED
  CANCELLED

  @@map("so_status")
}

model SalesOrder {
  id                     String        @id @default(uuid()) @db.Uuid
  tenantId               String        @map("tenant_id") @db.Uuid
  soNo                   String?       @map("so_no") /// ออกเลข (document_series SO) เมื่อพ้น DRAFT — CHECK
  source                 OrderSource
  /// ERP:{connector} (docs/04 C) — รหัส connector ตัวเล็ก เช่น `krs`; ช่องทางอื่น = '' (CHECK) · เป็นข้อมูล ไม่ใช่ส่วนของ key
  sourceConnector        String        @default("") @map("source_connector")
  externalId             String?       @map("external_id") /// externalRef ของระบบต้นทาง — key idempotent unique ต่อ tenant (docs/01 §3.3, plan/00a รหัสภายนอก)
  customerId             String?       @map("customer_id") @db.Uuid /// null = CUSTOMER_UNMAPPED
  customer               Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerExternalId     String?       @map("customer_external_id") /// รหัสลูกค้าตามต้นทาง (จับคู่ด้วย externalId — ST3-T06)
  customerText           String?       @map("customer_text") /// ชื่อ/ข้อความลูกค้าตามต้นทาง
  customerMatchMethod    String?       @map("customer_match_method") /// วิธีที่ได้ลูกค้า (ST3-T06): INPUT / EXTERNAL_ID / ALIAS / MANUAL · null = ยังไม่ได้
  customerCandidates     Json?         @map("customer_candidates") /// ลูกค้าที่แนะนำเมื่อจับคู่ไม่ได้ [{id, code, name, score}] (หน้าใบค้าง T07)
  billingCompanyId       String        @map("billing_company_id") @db.Uuid
  billingCompany         Company       @relation(fields: [billingCompanyId], references: [id], onDelete: Restrict)
  customerRef            String?       @map("customer_ref")
  requestedDate          DateTime      @map("requested_date") @db.Date
  vehicleTypeId          String?       @map("vehicle_type_id") @db.Uuid
  vehicleType            VehicleType?  @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)
  status                 SoStatus      @default(DRAFT)
  holdReasonCodeId       String?       @map("hold_reason_code_id") @db.Uuid /// บังคับเมื่อ ON_HOLD (CHECK)
  holdReasonCode         ReasonCode?   @relation(fields: [holdReasonCodeId], references: [id], onDelete: Restrict)
  holdNote               String?       @map("hold_note")
  /// ผลคิดราคาล่าสุด (PricingService.quote ST2-T15) — บรรทัดราคา snapshot ใน sales_order_charge
  pricingStatus          PricingStatus @default(RATE_MISSING) @map("pricing_status")
  /// {params (MD-117), reasons[], warnings[], routeId} ของการคิดราคาครั้งล่าสุด
  pricingDetail          Json?         @map("pricing_detail")
  priceTotal             Decimal?      @map("price_total") @db.Decimal(14, 2) /// รวมก่อน VAT (null เมื่อไม่ใช่ AVAILABLE)
  pricedAt               DateTime?     @map("priced_at") @db.Timestamptz(6)
  /// ข้อความที่ต้นทางแจ้งว่าข้อมูลไม่ครบ/ผิดรูป (→ ใบค้าง SOURCE_ERROR) — เก็บไว้ประเมินใบค้างใหม่ได้ (reevaluate)
  sourceIssues           Json          @default("[]") @map("source_issues")
  /// hash ของข้อมูลขาเข้า (canonical) — upsert ซ้ำค่าเดิม = ไม่เปลี่ยนอะไร (idempotent)
  inputHash              String?       @map("input_hash")
  sourceChangedAfterPlan Boolean       @default(false) @map("source_changed_after_plan")
  sourceDiff             Json?         @map("source_diff")
  /// ST8-T05 ต้นทาง (ERP connector) แจ้งว่ายกเลิกใบนี้แล้ว — ตั้งเมื่อยกเลิกอัตโนมัติ หรือยกเลิกไม่ได้ (มี DO แล้ว → แจ้งเตือนครั้งเดียว)
  /// null = ต้นทางไม่ได้ยกเลิก (ต้นทางกลับมาส่งใบปกติ = ล้างค่า ถ้าใบยังไม่ถูกยกเลิกใน TMS)
  sourceCancelledAt      DateTime?     @map("source_cancelled_at") @db.Timestamptz(6)
  lockedBy               String?       @map("locked_by")
  lockedAt               DateTime?     @map("locked_at") @db.Timestamptz(6)
  rawPayload             Json?         @map("raw_payload")
  version                Int           @default(1)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  stops          SalesOrderStop[]
  lines          SalesOrderLine[]
  charges        SalesOrderCharge[]
  deliveryOrders DeliveryOrder[]
  revenueLines   RevenueLine[]
  sourceChanges  OrderSourceChange[]
  editLock       OrderEditLock?
  lockReleases   OrderEditLockRelease[]

  @@unique([tenantId, soNo])
  @@unique([tenantId, externalId])
  @@index([tenantId, status, requestedDate])
  @@index([tenantId, customerId])
  @@index([tenantId, updatedAt, id])
  @@map("sales_order")
}

/// ผลตัดสินชุดการเปลี่ยนแปลงจากต้นทาง (ST3-T10)
enum SourceChangeStatus {
  PENDING /// รอคนรับ/ไม่รับ — SO ตั้ง source_changed_after_plan
  ACCEPTED /// รับแล้ว — ข้อมูลเขียนผ่าน upsertOrder
  REJECTED /// ไม่รับ — ข้อมูล TMS คงเดิม (ต้นทางส่งชุดเดิมซ้ำ = ไม่ขึ้นใหม่)
  SUPERSEDED /// ต้นทางส่งชุดใหม่มาแทน / ต้นทางกลับเป็นค่าเดิม / ใบถูกยกเลิก (ระบบปิดเอง)

  @@map("source_change_status")
}

/// ชุดการเปลี่ยนแปลงจากต้นทางหลังวางแผน (ST3-T10; docs/01 §3.3 + §4.1 "ไม่ overwrite แต่เก็บ diff", docs/04 C)
/// — ไม่ทับข้อมูลอัตโนมัติ: เก็บ input ทั้งชุด + diff ต่อช่อง รอคนรับ (apply ผ่าน upsertOrder) หรือไม่รับ (พร้อมเหตุผล)
/// PENDING ได้ครั้งละ 1 ชุดต่อ SO (unique partial index) · เขียนจาก OrderIntakeService เท่านั้น · ไม่มีการลบจริง
model OrderSourceChange {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  salesOrderId    String              @map("sales_order_id") @db.Uuid
  salesOrder      SalesOrder          @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  status          SourceChangeStatus  @default(PENDING)
  source          OrderSource
  sourceConnector String              @default("") @map("source_connector")
  /// สถานะ/version ของ SO ตอนต้นทางส่งมา
  orderStatus     SoStatus            @map("order_status")
  baseVersion     Int                 @map("base_version")
  /// input_hash ของ SO ตอนต้นทางส่งมา — ชุดเดียวกันบนข้อมูล TMS ชุดเดียวกันที่ไม่รับไปแล้ว = ไม่ขึ้นใหม่
  baseInputHash   String?             @map("base_input_hash")
  /// ข้อมูลขาเข้าที่ normalize แล้ว (UpsertOrderInput — uuid) — ใช้ตอน "รับ"
  input           Json
  inputHash       String              @map("input_hash")
  /// [{group, field, before, after}] — ค่าแสดงผล (ไม่มีราคา)
  changes         Json
  rawPayload      Json?               @map("raw_payload")
  decidedBy       String?             @map("decided_by")
  decidedAt       DateTime?           @map("decided_at") @db.Timestamptz(6)
  decisionReason  String?             @map("decision_reason")
  supersededById  String?             @map("superseded_by_id") @db.Uuid
  supersededBy    OrderSourceChange?  @relation("SourceChangeSupersede", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedes      OrderSourceChange[] @relation("SourceChangeSupersede")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tenantId, salesOrderId, createdAt])
  @@map("order_source_change")
}

/// ผลคิดราคาของ order (เหมือน PricingStatus ใน @tms/domain)
enum PricingStatus {
  AVAILABLE
  RATE_MISSING
  CALCULATION_FAILURE

  @@map("pricing_status")
}

enum StopType {
  PICKUP
  DELIVERY
  RETURN

  @@map("stop_type")
}

/// จุดรับ-ส่งของ SO หลายจุด (D-22)
model SalesOrderStop {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  salesOrderId    String        @map("sales_order_id") @db.Uuid
  salesOrder      SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  sequence        Int
  type            StopType
  siteId          String?       @map("site_id") @db.Uuid /// ว่างจนกว่าจะ map จาก text (LOCATION_UNMAPPED)
  site            CustomerSite? @relation(fields: [siteId], references: [id], onDelete: Restrict)
  siteText        String        @map("site_text")
  windowStart     DateTime?     @map("window_start") @db.Timestamptz(6)
  windowEnd       DateTime?     @map("window_end") @db.Timestamptz(6)
  /// วิธีที่ได้สถานที่ (ST3-T06): null = ต้นทางระบุ siteId มาเอง / ยังไม่ได้ · ALIAS / NAME / FUZZY = ระบบจับคู่ · MANUAL = คนเลือก
  matchMethod     String?       @map("match_method")
  matchScore      Decimal?      @map("match_score") @db.Decimal(4, 3) /// ความคล้าย 0–1 ตอนจับคู่อัตโนมัติ
  matchCandidates Json?         @map("match_candidates") /// สถานที่ที่แนะนำเมื่อจับคู่ไม่ได้/กำกวม [{id, code, name, score}] (หน้าใบค้าง T07)

  @@unique([tenantId, salesOrderId, sequence])
  @@index([tenantId, siteId])
  @@map("sales_order_stop")
}

model SalesOrderLine {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  salesOrderId String     @map("sales_order_id") @db.Uuid
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  lineNo       Int        @map("line_no")
  itemCode     String?    @map("item_code")
  productId    String?    @map("product_id") @db.Uuid
  product      Product?   @relation(fields: [productId], references: [id], onDelete: Restrict)
  description  String
  qtyOrdered   Decimal    @map("qty_ordered") @db.Decimal(14, 3)
  unitId       String?    @map("unit_id") @db.Uuid /// หน่วยใน master (ใช้คิดราคา) — `unit` = รหัส/ข้อความหน่วย snapshot
  unitRef      Unit?      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  unit         String
  weightKg     Decimal?   @map("weight_kg") @db.Decimal(14, 3)
  cbm          Decimal?   @db.Decimal(14, 3)
  isDangerous  Boolean    @default(false) @map("is_dangerous")
  tempMin      Decimal?   @map("temp_min") @db.Decimal(5, 1)
  tempMax      Decimal?   @map("temp_max") @db.Decimal(5, 1)

  deliveryOrderLines DeliveryOrderLine[]

  @@unique([tenantId, salesOrderId, lineNo])
  @@map("sales_order_line")
}

enum OrderChargeKind {
  FREIGHT
  EXTRA_STOP
  ACCESSORIAL

  @@map("order_charge_kind")
}

/// บรรทัดราคาขายของ SO (ST3-T01) — snapshot ณ เวลาคิดราคา (MD-117): ธงภาษีอยู่ที่บรรทัด (vat_type, wht_rate %)
/// ห้าม join กลับไปอ่าน service_item/rate_card ตอนคำนวณเอกสาร · wht_rate เป็นเปอร์เซ็นต์ → toCalcWhtRate() ก่อน computeDocumentTax
model SalesOrderCharge {
  id                  String          @id @default(uuid()) @db.Uuid
  tenantId            String          @map("tenant_id") @db.Uuid
  salesOrderId        String          @map("sales_order_id") @db.Uuid
  salesOrder          SalesOrder      @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  lineNo              Int             @map("line_no")
  kind                OrderChargeKind
  /// ที่มาของบรรทัด: RATE_CARD (ระบบคิด — rebuild ได้) · MANUAL (คนเพิ่ม — ST3-T02/ST5)
  origin              String          @default("RATE_CARD")
  serviceItemId       String          @map("service_item_id") @db.Uuid
  serviceItem         ServiceItem     @relation(fields: [serviceItemId], references: [id], onDelete: Restrict)
  serviceItemVersion  Int             @map("service_item_version")
  serviceItemSnapshot Json            @map("service_item_snapshot") /// ServiceItemSnapshot ทั้งก้อน (รหัส ชื่อ หน่วย ราคาตั้งต้น …)
  description         String /// ชื่อรายการ ณ เวลาคิด
  qty                 Decimal         @db.Decimal(18, 4) /// ค่าแสดงผล (≤ 4 ตำแหน่ง)
  qtyExact            String          @map("qty_exact") /// ค่าเต็มความละเอียด / เศษส่วน "n/d" (ห้ามคิด amount ใหม่จาก qty)
  unitPrice           Decimal         @map("unit_price") @db.Decimal(14, 2)
  amount              Decimal         @db.Decimal(14, 2)
  calculatedAmount    Decimal         @map("calculated_amount") @db.Decimal(14, 2)
  minChargeApplied    Boolean         @default(false) @map("min_charge_applied")
  vatType             VatType         @map("vat_type")
  whtRate             Decimal         @map("wht_rate") @db.Decimal(5, 2) /// เปอร์เซ็นต์ (1.00 = 1%)
  rateCardId          String?         @map("rate_card_id") @db.Uuid
  rateCard            RateCard?       @relation(fields: [rateCardId], references: [id], onDelete: Restrict)
  rateCardCode        String?         @map("rate_card_code")
  rateCardRevision    Int?            @map("rate_card_revision")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, salesOrderId, lineNo])
  @@index([tenantId, serviceItemId])
  @@index([tenantId, rateCardId])
  @@map("sales_order_charge")
}

/// บรรทัดรายได้ (ST5-T01; docs/04 F3 "Revenue line ตั้งแต่สร้าง order", plan/05 D-25/RA-7 ฝั่งรายได้แยกจากต้นทุน)
/// = ฐานของบรรทัดใบแจ้งหนี้ — ทุกบรรทัดมี `source_type`/`source_id`:
///   SO_CHARGE (source_id = sales_order_charge.id — ราคาจาก rate card / ราคาที่กำหนดเอง ณ เวลาคิด) **ต่อ DO** (ST5-T01b,
///   PO ตัดสิน 19 พ.ย. 2569 — docs/01 §3.3 revenue = snapshot × ปริมาณจริงของ DO): แหล่ง = (บรรทัดราคา, DO) · ยังไม่มี DO = ระดับใบสั่ง ·
///   DO_SURCHARGE (source_id = do_surcharge.id ที่ CONFIRMED) · MANUAL (คนเพิ่มเอง — `is_user_added`, ไม่มี source_id)
/// rebuild (RevenueLinesService.rebuild) แทนเฉพาะบรรทัดระบบที่ยังไม่ล็อก · บรรทัดที่คนเพิ่มคงไว้ (ยกเลิกได้ด้วยเหตุผล = VOIDED)
/// ล็อกเมื่อเอกสารแม่ออกเลข (`locked_at` — ST5-T09 ตั้ง): trigger ฐานข้อมูลห้ามแก้เนื้อหา/ลบแถวที่ล็อก
/// ไม่คำนวณภาษีที่นี่ — vat_type/wht_rate(%) snapshot ต่อบรรทัด (ST5-T02 คำนวณ)
model RevenueLine {
  id                  String          @id @default(uuid()) @db.Uuid
  tenantId            String          @map("tenant_id") @db.Uuid
  salesOrderId        String          @map("sales_order_id") @db.Uuid
  salesOrder          SalesOrder      @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  /// DO ที่บรรทัดผูก — DO_SURCHARGE = DO ของค่าใช้จ่ายหน้างาน · SO_CHARGE = DO ที่ราคาแบ่งลง (null = ใบสั่งยังไม่มี DO)
  deliveryOrderId     String?         @map("delivery_order_id") @db.Uuid
  deliveryOrder       DeliveryOrder?  @relation(fields: [deliveryOrderId], references: [id], onDelete: Restrict)
  lineNo              Int             @map("line_no")
  /// SO_CHARGE / DO_SURCHARGE / MANUAL (CHECK)
  sourceType          String          @map("source_type")
  sourceId            String?         @map("source_id") @db.Uuid
  isUserAdded         Boolean         @default(false) @map("is_user_added")
  kind                OrderChargeKind
  serviceItemId       String          @map("service_item_id") @db.Uuid
  serviceItem         ServiceItem     @relation(fields: [serviceItemId], references: [id], onDelete: Restrict)
  serviceItemVersion  Int?            @map("service_item_version")
  serviceItemSnapshot Json?           @map("service_item_snapshot")
  description         String
  qty                 Decimal         @db.Decimal(18, 4)
  unitPrice           Decimal         @map("unit_price") @db.Decimal(14, 2)
  amount              Decimal         @db.Decimal(14, 2)
  vatType             VatType         @map("vat_type")
  whtRate             Decimal         @map("wht_rate") @db.Decimal(5, 2) /// เปอร์เซ็นต์ (1.00 = 1%)
  /// ยอดยังไม่ยืนยัน (ST5-T01b): ใบสั่งยังไม่มี DO หรือ DO ยังไม่บันทึกยอดส่งจริง (ลูกค้าวางบิลตามยอดส่งจริง) — คิดใหม่เมื่อบันทึก
  provisional         Boolean         @default(false)
  /// ACTIVE / VOIDED (CHECK) — บรรทัดที่คนเพิ่ม (เหตุผล + audit) · บรรทัดระบบเมื่อใบสั่ง/DO ถูกยกเลิก หรือย้ายลง DO
  status              String          @default("ACTIVE")
  voidedAt            DateTime?       @map("voided_at") @db.Timestamptz(6)
  voidedBy            String?         @map("voided_by")
  voidReason          String?         @map("void_reason")
  /// ล็อกเมื่อเอกสารแม่ (ใบแจ้งหนี้) ออกเลข — ST5-T09 · null = ยังแก้/rebuild ได้
  lockedAt            DateTime?       @map("locked_at") @db.Timestamptz(6)
  lockedDocumentId    String?         @map("locked_document_id") @db.Uuid
  createdBy           String?         @map("created_by")
  version             Int             @default(1)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  invoiceLines InvoiceLine[]

  @@unique([tenantId, salesOrderId, lineNo])
  @@index([tenantId, deliveryOrderId])
  @@index([tenantId, serviceItemId])
  @@map("revenue_line")
}

/// เทมเพลตงานประจำ (ST3-T02; docs/04 C "กรอกมือ … template งานประจำ") — เก็บข้อมูลฟอร์มใบสั่งขนส่ง
/// (payload รูปเดียวกับ body ของ POST /v1/orders ตรวจด้วยกฎชุดเดียว) ไว้สร้างใบใหม่ · ตั้งเวลาสร้างอัตโนมัติ = P1
/// ชื่อ unique ต่อบริษัทเฉพาะที่ยังไม่ลบ (partial index ใน migration 0063) · ลบ = soft delete + เหตุผล
/// ล็อกการแก้ใบสั่งขนส่งจากหน้าจอ (ST3-T08; docs/04 C "Edit lock", spec/03 ORD-031) — 1 แถวต่อใบ
/// หมดอายุตามเวลา (`expires_at` = กิจกรรมล่าสุด + 10 นาที) ไม่มี job ล้าง — แถวที่หมดอายุแล้วนับว่าไม่มีล็อก
/// ปลด = ลบแถว (ข้อมูลชั่วคราว ไม่ใช่เอกสาร) · ปลดของคนอื่น (`orders:unlock`) ลง audit พร้อมเหตุผล
/// คอลัมน์ `sales_order.locked_by/locked_at` ของ schema v0 ไม่ใช้ (heartbeat ไม่แตะแถว SO/version)
model OrderEditLock {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  salesOrderId String     @map("sales_order_id") @db.Uuid
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  userId       String     @map("user_id") @db.Uuid
  user         AppUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  acquiredAt   DateTime   @map("acquired_at") @db.Timestamptz(6)
  lastSeenAt   DateTime   @map("last_seen_at") @db.Timestamptz(6)
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(6)

  @@unique([salesOrderId])
  @@index([tenantId, userId])
  @@map("order_edit_lock")
}

/// การปลดล็อกของผู้อื่น (ST3-T08 QA) — ผู้ถือเดิม (user_id) ต่ออายุ/PATCH ได้ 409 `order_lock_released`
/// ("ถูกปลดล็อกโดย …") จนกว่าจะเปิดแก้ใหม่ (POST /lock แบบเปิด = ลบแถว) หรือหมดอายุ (ปลด + 10 นาที)
/// แยกจาก order_edit_lock: คงอยู่แม้ผู้ปลดเปิดแก้แล้วปิดไป (ผู้ถือเดิมไม่ได้ล็อกคืนเงียบ ๆ)
model OrderEditLockRelease {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  salesOrderId String     @map("sales_order_id") @db.Uuid
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  userId       String     @map("user_id") @db.Uuid
  user         AppUser    @relation("OrderLockReleaseHolder", fields: [userId], references: [id], onDelete: Cascade)
  releasedBy   String     @map("released_by") @db.Uuid
  releaser     AppUser    @relation("OrderLockReleaseBy", fields: [releasedBy], references: [id], onDelete: Cascade)
  releasedAt   DateTime   @map("released_at") @db.Timestamptz(6)
  reason       String
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(6)

  @@unique([salesOrderId, userId])
  @@index([tenantId, userId])
  @@map("order_edit_lock_release")
}

model OrderTemplate {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String
  /// OrderTemplatePayloadDto (public id) — ไม่มีราคา/สถานะ/externalId
  payload       Json
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason")

  @@index([tenantId, updatedAt, id])
  @@map("order_template")
}

enum TripStatus {
  PLANNING
  OFFERED
  ASSIGNED
  DISPATCHED
  IN_PROGRESS
  COMPLETED
  COSTED
  SETTLED
  CANCELLED

  @@map("trip_status")
}

enum AssignmentStatus {
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED

  @@map("assignment_status")
}

model Trip {
  id                        String            @id @default(uuid()) @db.Uuid
  tenantId                  String            @map("tenant_id") @db.Uuid
  tripNo                    String?           @map("trip_no") /// ออกเลขตอนสร้าง (document_series TRIP) — CHECK บังคับ
  tripDate                  DateTime          @map("trip_date") @db.Date
  plannedStartAt            DateTime?         @map("planned_start_at") @db.Timestamptz(6) /// ช่วงวิ่งตามแผน (กระดาน Gantt — plan/00a)
  plannedEndAt              DateTime?         @map("planned_end_at") @db.Timestamptz(6)
  /// รถ/คนขับ/หาง/รถร่วม = snapshot ต่อเที่ยว (docs/04 D1) — เขียนตอน assign/offer เท่านั้น ไม่ตาม master ภายหลัง
  vehicleId                 String?           @map("vehicle_id") @db.Uuid
  vehicle                   Vehicle?          @relation("TripVehicle", fields: [vehicleId], references: [id], onDelete: Restrict)
  vehiclePlateSnapshot      String?           @map("vehicle_plate_snapshot")
  vehicleTypeSnapshot       String?           @map("vehicle_type_snapshot")
  vehicleTypeId             String?           @map("vehicle_type_id") @db.Uuid /// ประเภทรถ ณ วันจ่ายงาน (ST2-T14 ตัวกรองราคา 5 ครั้ง — ST3 เขียนคู่กับ snapshot)
  vehicleType               VehicleType?      @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)
  trailerId                 String?           @map("trailer_id") @db.Uuid /// หาง (vehicle.unit_role = TRAILER)
  trailer                   Vehicle?          @relation("TripTrailer", fields: [trailerId], references: [id], onDelete: Restrict)
  trailerPlateSnapshot      String?           @map("trailer_plate_snapshot")
  driverId                  String?           @map("driver_id") @db.Uuid
  driver                    Driver?           @relation("TripDriver", fields: [driverId], references: [id], onDelete: Restrict)
  driverNameSnapshot        String?           @map("driver_name_snapshot")
  driverPhoneSnapshot       String?           @map("driver_phone_snapshot")
  /// คนขับสำรอง 1 คน (docs/04 D1 secondaryDriverId — ไม่ใช้ co_driver_ids[] ของ docs/01: plan/00a §3)
  reliefDriverId            String?           @map("relief_driver_id") @db.Uuid
  reliefDriver              Driver?           @relation("TripReliefDriver", fields: [reliefDriverId], references: [id], onDelete: Restrict)
  reliefDriverNameSnapshot  String?           @map("relief_driver_name_snapshot")
  reliefDriverPhoneSnapshot String?           @map("relief_driver_phone_snapshot")
  driverAcceptedAt          DateTime?         @map("driver_accepted_at") @db.Timestamptz(6) /// D-24 "คนขับรับงาน" เป็นธง (★ รอยืนยัน)
  carrierId                 String?           @map("carrier_id") @db.Uuid
  carrier                   Carrier?          @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  carrierNameSnapshot       String?           @map("carrier_name_snapshot")
  offeredAt                 DateTime?         @map("offered_at") @db.Timestamptz(6) /// เสนองานรถร่วม (ลิงก์ = ST3-T23)
  offeredBy                 String?           @map("offered_by")
  assignedAt                DateTime?         @map("assigned_at") @db.Timestamptz(6)
  buyRateSnapshot           Json?             @map("buy_rate_snapshot")
  assignmentStatus          AssignmentStatus? @map("assignment_status")
  assignmentTokenHash       String?           @map("assignment_token_hash")
  assignmentExpiresAt       DateTime?         @map("assignment_expires_at") @db.Timestamptz(6)
  plannedDistanceKm         Decimal?          @map("planned_distance_km") @db.Decimal(10, 1) /// ST3-T16: ผลรวมระยะช่วงวิ่งที่ทราบ (คำนวณใหม่ทุกครั้งที่จุดเปลี่ยน)
  plannedDurationMin        Int?              @map("planned_duration_min") /// ST3-T16: ผลรวมเวลาเดินทางของช่วงที่ทราบ (นาที — ไม่รวมเวลาที่จุด)
  plannedRoute              Json?             @map("planned_route") /// GeoJSON LineString (T-18)
  actualDistanceKm          Decimal?          @map("actual_distance_km") @db.Decimal(10, 1)
  ruleWarnings              Json              @default("[]") @map("rule_warnings") /// ผลตรวจกฎตอนจัดงานล่าสุด (คำนวณใหม่ทุกการกระทำ — D-07)
  ruleOverrides             Json              @default("[]") @map("rule_overrides") /// ST3-T14: การยกเว้นบล็อก/ยืนยันคำเตือน (append-only {key, code, kind, reason, actorId, at, …})
  status                    TripStatus        @default(PLANNING)
  costAllocationMethod      String            @default("BY_WEIGHT") @map("cost_allocation_method")
  dispatchedAt              DateTime?         @map("dispatched_at") @db.Timestamptz(6)
  completedAt               DateTime?         @map("completed_at") @db.Timestamptz(6)
  /// ST6-T01 ปิดต้นทุน (COMPLETED → COSTED) — เวลา/ผู้ปิด
  costedAt                  DateTime?         @map("costed_at") @db.Timestamptz(6)
  costedBy                  String?           @map("costed_by")
  cancelledAt               DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  cancelReason              String?           @map("cancel_reason") /// เหตุผล ≥ 10 ตัวอักษร (CHECK คู่กับสถานะ CANCELLED)
  cancelReasonCodeId        String?           @map("cancel_reason_code_id") @db.Uuid
  cancelReasonCode          ReasonCode?       @relation("TripCancelReason", fields: [cancelReasonCodeId], references: [id], onDelete: Restrict)
  version                   Int               @default(1)
  createdAt                 DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  deliveryOrders       DeliveryOrder[]
  stops                TripStop[]
  subconOffers         SubconOffer[]
  stopEvents           StopEvent[]
  stopEventResolutions StopEventResolution[]
  doSurcharges         DoSurcharge[]
  settlementLines      SettlementLine[]

  @@unique([tenantId, tripNo])
  @@index([tenantId, tripDate, status])
  @@index([tenantId, carrierId, tripDate]) /// ราคา 5 ครั้งล่าสุดที่จ้างรถร่วม (ST2-T14)
  @@index([tenantId, updatedAt, id])
  @@index([tenantId, vehicleId, tripDate])
  @@index([tenantId, driverId, tripDate])
  @@map("trip")
}

enum StopStatus {
  PENDING
  ARRIVED
  COMPLETED
  FAILED
  SKIPPED

  @@map("stop_status")
}

model TripStop {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  tripId           String       @map("trip_id") @db.Uuid
  trip             Trip         @relation(fields: [tripId], references: [id], onDelete: Restrict)
  /// ลำดับจุด 1..n ต่อเนื่อง — unique เฉพาะจุดที่ยังใช้ (removed_at IS NULL — partial index ใน migration 0064)
  sequence         Int
  type             StopType
  siteId           String       @map("site_id") @db.Uuid
  site             CustomerSite @relation(fields: [siteId], references: [id], onDelete: Restrict)
  /// ช่วงเวลาที่ลูกค้าขอ (ส่วนที่ทุก DO ของจุดนี้รับได้ — จาก sales_order_stop) · planned_* = เวลาตามแผนของผู้จัดรถ
  windowStart      DateTime?    @map("window_start") @db.Timestamptz(6)
  windowEnd        DateTime?    @map("window_end") @db.Timestamptz(6)
  plannedArrival   DateTime?    @map("planned_arrival") @db.Timestamptz(6)
  plannedDeparture DateTime?    @map("planned_departure") @db.Timestamptz(6)
  arrivedAt        DateTime?    @map("arrived_at") @db.Timestamptz(6)
  departedAt       DateTime?    @map("departed_at") @db.Timestamptz(6)
  status           StopStatus   @default(PENDING)
  outcome          String?
  failReasonCodeId String?      @map("fail_reason_code_id") @db.Uuid
  failReasonCode   ReasonCode?  @relation(fields: [failReasonCodeId], references: [id], onDelete: Restrict)
  detentionMin     Int?         @map("detention_min")
  pod              Json?
  lastEventId      String?      @map("last_event_id") @db.Uuid
  /// จุดที่ไม่มี DO ใช้แล้ว (ถอด DO ก่อนปล่อยรถ) — ไม่ลบจริง (REVOKE DELETE)
  removedAt        DateTime?    @map("removed_at") @db.Timestamptz(6)
  /// ST3-T16 ช่วงวิ่งจากจุดก่อนหน้า → จุดนี้ (จุดแรก = null): route master / ค่าประมาณจากพิกัด / จุดเดียวกัน · ไม่ทราบ = null ทั้งสาม
  legDistanceKm    Decimal?     @map("leg_distance_km") @db.Decimal(10, 1)
  legMinutes       Int?         @map("leg_minutes")
  legSource        String?      @map("leg_source")

  deliveryOrders DeliveryOrder[]    @relation("DoDropStop")
  pickupOrders   DeliveryOrder[]    @relation("DoPickupStop")
  events         StopEvent[]
  pods           DeliveryOrderPod[]

  /// เป้าของ FK คู่ (จุด, เที่ยว) — migration 0064 (DO) / 0082 (stop_event)
  @@unique([id, tripId], map: "trip_stop_id_trip_id_key")
  @@index([tenantId, tripId])
  @@index([tenantId, siteId])
  @@map("trip_stop")
}

enum DoStatus {
  DRAFT
  PLANNED
  PICKED_UP /// D-23
  DISPATCHED
  DELIVERED
  FAILED
  RETURNED
  POD_PENDING
  UNBILLED
  BILLED
  CANCELLED

  @@map("do_status")
}

/// ใบส่งของ (ST3-T09; docs/01 §3.3, §4.3) — หน่วยวางบิล · 1 DO = 1 จุดส่ง (ORD-080) อยู่ได้ 1 เที่ยว · ไม่มีการลบจริง (ยกเลิก = CANCELLED)
/// เขียนได้จาก DeliveryOrderService ที่เดียว (test `delivery-orders` ตรวจ call path) · บรรทัดอ้างบรรทัด SO (FK RESTRICT)
model DeliveryOrder {
  id                   String          @id @default(uuid()) @db.Uuid
  tenantId             String          @map("tenant_id") @db.Uuid
  doNo                 String?         @map("do_no") /// ออกเลขตอนสร้าง (document_series DO; แยก = เลขแม่-n) — CHECK บังคับ
  doDate               DateTime        @map("do_date") @db.Date
  salesOrderId         String          @map("sales_order_id") @db.Uuid
  salesOrder           SalesOrder      @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  customerId           String          @map("customer_id") @db.Uuid
  customer             Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  tripId               String?         @map("trip_id") @db.Uuid
  trip                 Trip?           @relation(fields: [tripId], references: [id], onDelete: Restrict)
  tripStopId           String?         @map("trip_stop_id") @db.Uuid /// จุดส่งของ DO นี้ในเที่ยว
  tripStop             TripStop?       @relation("DoDropStop", fields: [tripStopId], references: [id], onDelete: Restrict)
  pickupTripStopId     String?         @map("pickup_trip_stop_id") @db.Uuid /// จุดรับของ DO นี้ในเที่ยว (ST3-T11 — ตรวจรับก่อนส่ง ST3-T16)
  pickupTripStop       TripStop?       @relation("DoPickupStop", fields: [pickupTripStopId], references: [id], onDelete: Restrict)
  originSiteId         String          @map("origin_site_id") @db.Uuid
  originSite           CustomerSite    @relation("DoOrigin", fields: [originSiteId], references: [id], onDelete: Restrict)
  destSiteId           String          @map("dest_site_id") @db.Uuid
  destSite             CustomerSite    @relation("DoDest", fields: [destSiteId], references: [id], onDelete: Restrict)
  /// ลำดับจุดของ SO (sales_order_stop.sequence) ที่ DO นี้รับ/ส่ง — ไม่ใช้ FK เพราะจุดของ SO upsert ตามลำดับ
  originStopSeq        Int             @map("origin_stop_seq")
  destStopSeq          Int             @map("dest_stop_seq")
  weightKg             Decimal?        @map("weight_kg") @db.Decimal(14, 3)
  cbm                  Decimal?        @db.Decimal(14, 3)
  sellRateSnapshot     Json?           @map("sell_rate_snapshot")
  revenueAmount        Decimal?        @map("revenue_amount") @db.Decimal(14, 2)
  allocatedCostAmount  Decimal?        @map("allocated_cost_amount") @db.Decimal(14, 2)
  status               DoStatus        @default(DRAFT)
  podStatus            String          @default("NONE") @map("pod_status")
  billingHold          Boolean         @default(false) @map("billing_hold")
  /// ST5-T04 ส่งบัญชี (RELEASED — docs/04 F4): เวลา + ผู้ทำ (id ผู้ใช้/API client) · null = ยังไม่ส่ง · CHECK คู่กัน
  releasedAt           DateTime?       @map("released_at") @db.Timestamptz(6)
  releasedBy           String?         @map("released_by")
  /// ST5-T05 กันวางบิลซ้ำ (docs/04 F3 "Flag กันวางบิลซ้ำ"): UNBILLED / IN_DRAFT / INVOICED / CREDITED — แกนแยกจาก `status`
  /// เขียนผ่าน InvoiceBillingGuard (ล็อก DO + unique partial บน invoice_line) เท่านั้น · [DECISION spec/12 §3]
  billingStatus        BillingStatus   @default(UNBILLED) @map("billing_status")
  /// ST5-T06 timestamp ต่อขั้น (docs/04 F4 `invoicedAt`, `paidAt`) — ขั้นเองคำนวณ (`billingStage`) ไม่เก็บ
  /// invoiced_at: ใบออกเลข (billing event `invoice`) · ล้างเมื่อดึงเข้าร่างใหม่หลังลดหนี้เต็มใบ · paid_at: รับชำระครบ (ST5-T22 เขียน)
  invoicedAt           DateTime?       @map("invoiced_at") @db.Timestamptz(6)
  paidAt               DateTime?       @map("paid_at") @db.Timestamptz(6)
  redeliveryOfId       String?         @map("redelivery_of_id") @db.Uuid /// D-23 ส่งใหม่ = DO ใบใหม่
  redeliveryOf         DeliveryOrder?  @relation("DoRedelivery", fields: [redeliveryOfId], references: [id], onDelete: Restrict)
  redeliveries         DeliveryOrder[] @relation("DoRedelivery")
  /// ST4-T12 จำนวนครั้งที่สายงานนี้ถูกนัดส่งใหม่อัตโนมัติ (ใบเดิม + 1) — เกินค่าตั้ง `dispatch.maxAutoReschedules` → SO ค้าง RESCHEDULES_EXHAUSTED
  rescheduleCount      Int             @default(0) @map("reschedule_count")
  /// ST4-T12 ใบนี้เกิดจากนัดส่งใหม่ที่เกินค่าตั้ง (ใบสั่งค้าง/เหตุรอง RESCHEDULES_EXHAUSTED จนกว่าจะจัดรถ)
  rescheduleExhausted  Boolean         @default(false) @map("reschedule_exhausted")
  /// ST4-T11 ส่งซ้ำมือ (ผู้ใช้สั่ง) — ระบบไม่คืนใบเดิมเองเมื่อผลส่งไม่สำเร็จถูกพลิก (ต่างจากนัดส่งใหม่อัตโนมัติ ST4-T12)
  redeliveryManual     Boolean         @default(false) @map("redelivery_manual")
  /// ST4-T11 ใบส่งซ้ำของที่ลูกค้าปฏิเสธรับจากใบนี้ (ใบเดิมคงส่งแล้ว) — ไม่นับปริมาณจัดสรรของ SO · ส่งต่อผ่านแยก/ส่งใหม่
  rejectedFromId       String?         @map("rejected_from_id") @db.Uuid
  rejectedFrom         DeliveryOrder?  @relation("DoRejectedRedelivery", fields: [rejectedFromId], references: [id], onDelete: Restrict)
  rejectedRedeliveries DeliveryOrder[] @relation("DoRejectedRedelivery")
  /// แยก DO (ORD-084): ใบแม่ CANCELLED (event split) → ใบลูกเลข `{split_root_no}-{split_index}`
  splitFromId          String?         @map("split_from_id") @db.Uuid
  splitFrom            DeliveryOrder?  @relation("DoSplit", fields: [splitFromId], references: [id], onDelete: Restrict)
  splitChildren        DeliveryOrder[] @relation("DoSplit")
  splitRootNo          String?         @map("split_root_no")
  splitIndex           Int?            @map("split_index")
  /// ลายนิ้วมือข้อมูล SO ที่ DO ชุดนี้สร้างจาก (ลูกค้า จุด สินค้า) — SO เปลี่ยนแล้วไม่ตรง = สร้าง DO ใหม่ทั้งชุด (ORD-085)
  sourceHash           String?         @map("source_hash")
  customerRef          String?         @map("customer_ref")
  publicTokenHash      String?         @map("public_token_hash") /// tracking link (ST4-T14)
  version              Int             @default(1)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  lines        DeliveryOrderLine[]
  revenueLines RevenueLine[]
  pods         DeliveryOrderPod[]
  doSurcharges DoSurcharge[]
  invoiceLines InvoiceLine[]

  @@unique([tenantId, doNo])
  @@index([tenantId, status])
  @@index([tenantId, tripId])
  @@index([tenantId, tripStopId])
  @@index([tenantId, pickupTripStopId])
  @@index([tenantId, salesOrderId])
  @@index([tenantId, redeliveryOfId])
  @@index([tenantId, rejectedFromId])
  @@index([tenantId, updatedAt, id])
  @@map("delivery_order")
}

/// หลักฐานส่ง (ePOD) ต่อ DO (ST4-T07; docs/04 E2, docs/01 §3.3 pod_status, §5.3 payload POD) — **append-only เป็นฉบับ**
/// แก้ = ฉบับใหม่ (version + 1) + เหตุผล (spec/04 DRV-164) · ฉบับล่าสุด = ปัจจุบัน · ไฟล์อ้าง stored_document (เขียนครั้งเดียว)
/// ใช้ร่วมทุกช่องทาง: เว็บ (T07) ลิงก์รถร่วม (T09) แอปคนขับ (P1) — `source`
model DeliveryOrderPod {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  deliveryOrderId     String        @map("delivery_order_id") @db.Uuid
  deliveryOrder       DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Restrict)
  /// จุดส่งของ DO ตอนบันทึก (snapshot)
  tripStopId          String?       @map("trip_stop_id") @db.Uuid
  tripStop            TripStop?     @relation(fields: [tripStopId], references: [id], onDelete: Restrict)
  version             Int
  /// ชุด checklist ที่ใช้ตรวจ SUCCESS / FAILURE
  outcome             String
  /// WEB / LINK / APP / API
  source              String
  receiverName        String?       @map("receiver_name")
  /// SELF / SECURITY / STAFF / OTHER
  receiverRelation    String?       @map("receiver_relation")
  signatureDocumentId String?       @map("signature_document_id") @db.Uuid
  photoDocumentIds    String[]      @default([]) @map("photo_document_ids") @db.Uuid
  fileDocumentIds     String[]      @default([]) @map("file_document_ids") @db.Uuid
  weighedKg           Decimal?      @map("weighed_kg") @db.Decimal(14, 3)
  customerRef         String?       @map("customer_ref")
  note                String?
  /// BOOLEAN key → true/false
  checks              Json          @default("{}")
  /// SINGLE_CHOICE key → ตัวเลือก
  choices             Json          @default("{}")
  barcodes            String[]      @default([])
  /// PIN ที่ผู้รับกรอก — เข้ารหัส (FieldCipher) ห้ามแสดง/บันทึก log แบบเปิด
  pinEnc              String?       @map("pin_enc")
  pinLength           Int?          @map("pin_length")
  rating              Int?
  /// ผลตรวจตอนบันทึก: PARTIAL / COMPLETE + รายการที่ขาด (PodMissing[])
  podStatus           String        @map("pod_status")
  missing             Json          @default("[]")
  /// ST4-T10 ยอดส่งจริงต่อบรรทัด DO ณ ฉบับนี้ (docs/01 §5.3 `lines`) — [{lineNo, qtyPlanned, qtyActual, rejectQty, reason: ReasonSnapshot|null, note}]
  /// ฉบับล่าสุด = ค่าปัจจุบัน (ฉายลง delivery_order_line.qty_actual/reject_qty/reject_reason_code_id) · [] = ยังไม่บันทึก (ถือว่าตามแผน)
  lines               Json          @default("[]")
  /// เหตุผลการแก้ (ฉบับที่ 2 ขึ้นไป)
  reason              String?
  createdBy           String?       @map("created_by")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, deliveryOrderId, version])
  @@index([tenantId, tripStopId])
  @@map("delivery_order_pod")
}

model DeliveryOrderLine {
  id                 String          @id @default(uuid()) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  deliveryOrderId    String          @map("delivery_order_id") @db.Uuid
  deliveryOrder      DeliveryOrder   @relation(fields: [deliveryOrderId], references: [id], onDelete: Restrict)
  lineNo             Int             @map("line_no")
  /// บรรทัด SO — null ได้เฉพาะบรรทัดของ DO ที่ยกเลิกแล้วซึ่งบรรทัด SO ถูกลบภายหลัง (เหลือ snapshot so_line_no/description)
  salesOrderLineId   String?         @map("sales_order_line_id") @db.Uuid
  salesOrderLine     SalesOrderLine? @relation(fields: [salesOrderLineId], references: [id], onDelete: Restrict)
  soLineNo           Int             @map("so_line_no")
  description        String
  qtyPlanned         Decimal         @map("qty_planned") @db.Decimal(14, 3)
  /// ST4-T10 ฉายจาก POD ฉบับล่าสุด (`delivery_order_pod.lines`) — null = ยังไม่บันทึก (ถือว่าตามแผน) · CHECK 0 ≤ actual ≤ planned, reject = planned − actual, reject > 0 ต้องมีเหตุผล
  qtyActual          Decimal?        @map("qty_actual") @db.Decimal(14, 3)
  rejectQty          Decimal?        @map("reject_qty") @db.Decimal(14, 3)
  rejectReasonCodeId String?         @map("reject_reason_code_id") @db.Uuid
  rejectReasonCode   ReasonCode?     @relation(fields: [rejectReasonCodeId], references: [id], onDelete: Restrict)
  /// ST4-T11 ของที่ปฏิเสธรับแล้วคืนคลัง (ไม่ส่งซ้ำ) — CHECK ≤ reject_qty · ส่งซ้ำนับจาก DO ใบใหม่ (`rejected_from_id`)
  returnedQty        Decimal         @default(0) @map("returned_qty") @db.Decimal(14, 3)
  unit               String
  weightKg           Decimal?        @map("weight_kg") @db.Decimal(14, 3) /// สัดส่วนจากบรรทัด SO (เศษปัดไปใบสุดท้าย — รวมเท่าเดิม)
  cbm                Decimal?        @db.Decimal(14, 3)

  @@unique([tenantId, deliveryOrderId, lineNo])
  @@unique([tenantId, deliveryOrderId, salesOrderLineId])
  @@index([tenantId, deliveryOrderId])
  @@index([tenantId, salesOrderLineId])
  @@map("delivery_order_line")
}

/// ค่าใช้จ่ายหน้างานที่จะเป็นบรรทัดเพิ่มในใบแจ้งหนี้ (snapshot vat_type/wht_rate)
/// ST4-T13: บันทึกจากหน้างาน (เที่ยว) → PENDING_CONFIRM → Invoicer ยืนยัน (CONFIRMED) / ปฏิเสธ (REJECTED) · ผู้บันทึกยกเลิก (CANCELLED)
/// ไม่มีการลบ/แก้ยอด — ผิด = ปฏิเสธ/ยกเลิก แล้วบันทึกใหม่ · ST5-T01 อ่านเฉพาะ CONFIRMED เป็นบรรทัดรายได้ (ห้าม join service_item)
model DoSurcharge {
  id                  String          @id @default(uuid()) @db.Uuid
  tenantId            String          @map("tenant_id") @db.Uuid
  deliveryOrderId     String          @map("delivery_order_id") @db.Uuid
  deliveryOrder       DeliveryOrder   @relation(fields: [deliveryOrderId], references: [id], onDelete: Restrict)
  /// เที่ยวที่บันทึก (ST4-T13) — null = แถวก่อน ST4-T13
  tripId              String?         @map("trip_id") @db.Uuid
  trip                Trip?           @relation(fields: [tripId], references: [id], onDelete: Restrict)
  serviceItemId       String          @map("service_item_id") @db.Uuid
  serviceItemVersion  Int?            @map("service_item_version")
  serviceItemSnapshot Json?           @map("service_item_snapshot") /// ServiceItemSnapshot ทั้งก้อน ณ เวลาบันทึก
  description         String          @default("") /// ชื่อรายการ ณ เวลาบันทึก
  vatType             VatType         @map("vat_type")
  whtRate             Decimal         @map("wht_rate") @db.Decimal(5, 2)
  qty                 Decimal         @db.Decimal(14, 3)
  unitPrice           Decimal         @map("unit_price") @db.Decimal(14, 2)
  amount              Decimal         @db.Decimal(14, 2)
  evidenceFileKey     String?         @map("evidence_file_key") /// schema v0 — ไม่ใช้ (ใช้ evidence_document_id)
  evidenceDocumentId  String?         @unique @map("evidence_document_id") @db.Uuid
  evidenceDocument    StoredDocument? @relation(fields: [evidenceDocumentId], references: [id], onDelete: Restrict)
  note                String?
  /// PENDING_CONFIRM / CONFIRMED / REJECTED / CANCELLED (CHECK ใน migration 0092)
  status              String          @default("PENDING_CONFIRM")
  approvedBy          String?         @map("approved_by") /// ผู้ยืนยัน (docs/01 §3.3)
  decidedBy           String?         @map("decided_by")
  decidedAt           DateTime?       @map("decided_at") @db.Timestamptz(6)
  decisionReason      String?         @map("decision_reason")
  createdBy           String?         @map("created_by")
  version             Int             @default(1)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tripCosts    TripCost[]
  invoiceLines InvoiceLine[]

  @@index([tenantId, deliveryOrderId])
  @@index([tenantId, tripId])
  @@index([tenantId, status])
  @@map("do_surcharge")
}

model TripCost {
  id                 String          @id @default(uuid()) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  tripId             String          @map("trip_id") @db.Uuid
  costType           String          @map("cost_type") /// FUEL / TOLL / DRIVER_WAGE / CARRIER_FEE / ALLOWANCE / REPAIR / OTHER
  amount             Decimal         @db.Decimal(14, 2)
  vatAmount          Decimal         @default(0) @map("vat_amount") @db.Decimal(14, 2)
  source             String /// RATE_CARD / MANUAL / GPS / ADVANCE
  carrierId          String?         @map("carrier_id") @db.Uuid
  settlementLineId   String?         @unique @map("settlement_line_id") @db.Uuid
  allocated          Json            @default("{}")
  /// ST3-T22: ธงภาษีของบรรทัด (snapshot จากรายการบริการค่าขนส่งของ rate card ขาซื้อ — null = ไม่มี rate card ให้คัดลอก [OPEN])
  serviceItemId      String?         @map("service_item_id") @db.Uuid
  vatType            String?         @map("vat_type") /// EXEMPT_TRANSPORT / VAT_7 / ZERO_RATED (ServiceItemVatType)
  whtRate            Decimal?        @map("wht_rate") @db.Decimal(5, 2) /// เปอร์เซ็นต์ เช่น 1.00
  description        String?
  /// ข้อเสนอ/การจ้างรถร่วมที่สร้างบรรทัดนี้ (CARRIER_FEE — ST3-T22)
  subconOfferId      String?         @map("subcon_offer_id") @db.Uuid
  subconOffer        SubconOffer?    @relation(fields: [subconOfferId], references: [id], onDelete: Restrict)
  /// บรรทัดกลับรายการ (ยอดติดลบ) ของบรรทัดเดิม — เปลี่ยนรถร่วม/จ้างใหม่ (ST3-T22/T25) · ไม่มีการลบ/แก้ยอด
  reversalOfId       String?         @unique @map("reversal_of_id") @db.Uuid
  reversalOf         TripCost?       @relation("TripCostReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy         TripCost?       @relation("TripCostReversal")
  /// ที่มาของบรรทัด (แนวคิด ST6-T01 `sourceType/sourceId`): SUBCON_OFFER = ราคาที่ตกลงตอนจ้างรถร่วม (source_id = subcon_offer.id)
  /// — **ล็อก: งาน rebuild บรรทัดระบบของ ST6-T01 ห้ามแก้/สร้างใหม่ทับ** · null = บรรทัดก่อน ST3-T22
  sourceType         String?         @map("source_type")
  sourceId           String?         @map("source_id") @db.Uuid
  /// ST4-T13 ค่าใช้จ่ายหน้างานฝั่งซื้อ (source MANUAL, source_type FIELD หรือ DO_SURCHARGE เมื่อบันทึกคู่กับฝั่งขาย)
  /// สถานะ: บรรทัดระบบ = CONFIRMED · หน้างาน PENDING_CONFIRM → CONFIRMED / REJECTED / CANCELLED (CHECK ใน migration 0092)
  status             String          @default("CONFIRMED")
  doSurchargeId      String?         @map("do_surcharge_id") @db.Uuid /// บรรทัดฝั่งขายที่บันทึกคู่กัน (ใช้รูปหลักฐานเดียวกัน)
  doSurcharge        DoSurcharge?    @relation(fields: [doSurchargeId], references: [id], onDelete: Restrict)
  evidenceDocumentId String?         @unique @map("evidence_document_id") @db.Uuid
  evidenceDocument   StoredDocument? @relation(fields: [evidenceDocumentId], references: [id], onDelete: Restrict)
  note               String?
  decidedBy          String?         @map("decided_by")
  decidedAt          DateTime?       @map("decided_at") @db.Timestamptz(6)
  decisionReason     String?         @map("decision_reason")
  version            Int             @default(1)
  createdBy          String?         @map("created_by")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  settlementLines SettlementLine[]

  @@index([tenantId, tripId])
  @@index([tenantId, doSurchargeId])
  @@map("trip_cost")
}

/// ST6-T03 ใบสำคัญจ่ายรถร่วม (docs/01 §3.6 carrier_settlement; spec/05 §11) — ร่าง DRAFT ไม่มีเลข (STL ออกตอนอนุมัติ ST6-T07)
/// ยอด: gross = Σ บรรทัดเที่ยว · deduction = Σ |บรรทัดหัก| · net = gross − deduction (CHECK) · ไม่คำนวณ VAT/WHT (ST6-T08) · ไม่มีการลบ
model CarrierSettlement {
  id                 String                  @id @default(uuid()) @db.Uuid
  tenantId           String                  @map("tenant_id") @db.Uuid
  settlementNo       String?                 @map("settlement_no")
  carrierId          String                  @map("carrier_id") @db.Uuid
  carrier            Carrier                 @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  /// ข้อมูลรถร่วม ณ วันสร้างใบ {code, legalName, entityType, taxId, taxIdLast4, branchCode, address}
  carrierSnapshot    Json                    @map("carrier_snapshot")
  /// นิติบุคคลที่จ่าย ("จ้างในนาม" ของรถร่วม — null = ค่าเริ่มต้นองค์กร)
  payingCompanyId    String?                 @map("paying_company_id") @db.Uuid
  payingCompany      Company?                @relation(fields: [payingCompanyId], references: [id], onDelete: Restrict)
  periodFrom         DateTime                @map("period_from") @db.Date
  periodTo           DateTime                @map("period_to") @db.Date
  carrierInvoiceNo   String?                 @map("carrier_invoice_no")
  carrierInvoiceDate DateTime?               @map("carrier_invoice_date") @db.Date
  carrierReceiptNo   String?                 @map("carrier_receipt_no")
  note               String?
  grossAmount        Decimal                 @default(0) @map("gross_amount") @db.Decimal(14, 2)
  deductionAmount    Decimal                 @default(0) @map("deduction_amount") @db.Decimal(14, 2)
  netPayable         Decimal                 @default(0) @map("net_payable") @db.Decimal(14, 2)
  /// หัก ณ ที่จ่ายประมาณการ (ST6-T08, D-54/D-58) — ตรึงตอนอนุมัติ (null = ยังไม่อนุมัติ → คำนวณสดจากบรรทัด) · ร่าง ยังไม่ผ่านนักบัญชี
  whtAmount          Decimal?                @map("wht_amount") @db.Decimal(14, 2)
  /// ขั้นต่ำหัก ณ ที่จ่าย (บาท) ที่ใช้ตอนตรึง — ค่าตั้ง `tax.whtMinimumAmount` ณ วันอนุมัติ
  whtMinimumAmount   Decimal?                @map("wht_minimum_amount") @db.Decimal(14, 2)
  /// ค่าตั้งต้นอัตราหัก ณ ที่จ่ายของรถร่วม (%) ณ วันสร้างใบ — ใช้กับบรรทัดที่ไม่มีธง · ใบเก่า = null จนอนุมัติ (ตรึงตอนอนุมัติ)
  whtRateDefault     Decimal?                @map("wht_rate_default") @db.Decimal(5, 2)
  /// ผู้จ่าย ณ วันอนุมัติ {companyId, name, taxId, branchCode, address} (ST6-T04 — PDF ใบสำคัญจ่าย) · ใบก่อน 0145 = null
  payerSnapshot      Json?                   @map("payer_snapshot")
  /// DRAFT / SENT_TO_CARRIER / DISPUTED / APPROVED / PAID / CANCELLED (CHECK ใน migration 0122/0124/0127/0130/0139 — PAID = ST6-T09)
  /// DISPUTED (ST6-T06) = ส่งตรวจแล้วมีรายการโต้แย้งที่ยังไม่เคลียร์ (รถร่วม/บริษัท) — อนุมัติไม่ได้ · เคลียร์ครบ → SENT_TO_CARRIER · เรียกกลับ → DRAFT
  status             String                  @default("DRAFT")
  /// ส่งให้รถร่วมตรวจล่าสุด (ST6-T05) — ผู้ส่งนับเป็นผู้เตรียมใบ (SoD) · รอบตรวจ +1 ทุกครั้งที่ส่ง (คำตอบของรถร่วมผูกกับรอบ)
  sentAt             DateTime?               @map("sent_at") @db.Timestamptz(6)
  sentBy             String?                 @map("sent_by")
  reviewRound        Int                     @default(0) @map("review_round")
  /// ผู้เตรียมใบจากขั้นรถร่วมตรวจ (ผู้ส่งทุกรอบ + ผู้เรียกกลับ + ผู้ออกลิงก์ใหม่) — เพิ่มอย่างเดียว · อนุมัติใบนี้ไม่ได้ (SoD)
  preparers          String[]                @default([])
  /// อนุมัติ (ST6-T07) — ผู้อนุมัติ ≠ ผู้สร้าง (CHECK) · เลข STL ออกตอนนี้ (issueNumber) แก้ไม่ได้
  approvedAt         DateTime?               @map("approved_at") @db.Timestamptz(6)
  approvedBy         String?                 @map("approved_by")
  /// ผู้แก้หัวใบล่าสุด (PATCH) — นับเป็นผู้เตรียมใบ (SoD ST6-T07)
  updatedBy          String?                 @map("updated_by")
  /// บันทึกจ่าย (ST6-T09; docs/04 F6 "จ่าย" — วันโอน/เลขอ้างอิง/ธนาคาร) — APPROVED → PAID ครั้งเดียว แก้ไม่ได้ (trigger 0139)
  /// วันที่จ่ายจริง (วันโอน/วันที่เช็ค/วันจ่ายเงินสด — วันที่ไทย) · เวลาที่บันทึก + ผู้บันทึก
  paidDate           DateTime?               @map("paid_date") @db.Date
  paidAt             DateTime?               @map("paid_at") @db.Timestamptz(6)
  paidBy             String?                 @map("paid_by")
  /// TRANSFER / CHEQUE / CASH (ต้นแบบ "วิธีจ่าย": โอนเงิน / เช็ค / เงินสด)
  paymentMethod      String?                 @map("payment_method")
  /// เลขอ้างอิงการโอน / เลขที่เช็ค (บังคับเมื่อโอน/เช็ค)
  paymentReference   String?                 @map("payment_reference")
  /// ธนาคาร (ข้อความ — ไม่บังคับ; ต้นแบบไม่มีช่องนี้ — spec/12 §3)
  paymentBank        String?                 @map("payment_bank")
  cancelledAt        DateTime?               @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy        String?                 @map("cancelled_by")
  cancelReason       String?                 @map("cancel_reason")
  createdBy          String?                 @map("created_by")
  version            Int                     @default(1)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  lines              SettlementLine[]
  reviews            SettlementLineReview[]
  disputes           SettlementLineDispute[]

  @@index([tenantId, updatedAt, id])
  @@index([tenantId, carrierId, status])
  @@map("carrier_settlement")
}

/// บรรทัดใบสำคัญจ่าย — FREIGHT/SURCHARGE อ้าง trip_cost 1:1 (unique บรรทัดที่ยังใช้ — partial index กันจ่ายซ้ำ K11)
/// DEDUCTION = กรอกมือ ยอดติดลบ (CASH_ADVANCE / FUEL_PROVIDED / FINE / DAMAGE) + เอกสารอ้างอิง · นำออก = voided_at + เหตุผล
model SettlementLine {
  id            String                  @id @default(uuid()) @db.Uuid
  tenantId      String                  @map("tenant_id") @db.Uuid
  settlementId  String                  @map("settlement_id") @db.Uuid
  settlement    CarrierSettlement       @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  lineNo        Int                     @map("line_no")
  lineType      String                  @map("line_type") /// FREIGHT / SURCHARGE / DEDUCTION
  tripCostId    String?                 @map("trip_cost_id") @db.Uuid
  tripCost      TripCost?               @relation(fields: [tripCostId], references: [id], onDelete: Restrict)
  tripId        String?                 @map("trip_id") @db.Uuid
  trip          Trip?                   @relation(fields: [tripId], references: [id], onDelete: Restrict)
  deductionType String?                 @map("deduction_type")
  description   String
  amount        Decimal                 @db.Decimal(14, 2)
  reference     String?
  /// ธงภาษีคัดลอกจาก trip_cost (ข้อมูลเท่านั้น — คำนวณ WHT ใน ST6-T08)
  vatType       String?                 @map("vat_type")
  whtRate       Decimal?                @map("wht_rate") @db.Decimal(5, 2)
  voidedAt      DateTime?               @map("voided_at") @db.Timestamptz(6)
  voidedBy      String?                 @map("voided_by")
  voidReason    String?                 @map("void_reason")
  createdBy     String?                 @map("created_by")
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  reviews       SettlementLineReview[]
  disputes      SettlementLineDispute[]

  @@unique([settlementId, lineNo])
  @@index([tenantId, tripId])
  @@map("settlement_line")
}

/// คำตอบของรถร่วมต่อบรรทัดใบสำคัญจ่าย ผ่านลิงก์ (ST6-T05; docs/04 F6 "รถร่วมตรวจผ่านลิงก์") — เพิ่มอย่างเดียว (แก้/ลบไม่ได้)
/// คำตอบล่าสุดของบรรทัดในรอบตรวจปัจจุบัน = สถานะที่แสดง · DISPUTED = ติดธง (อนุมัติไม่ได้จนกว่า ST6-T06 เคลียร์/ส่งตรวจรอบใหม่)
/// ผู้ตอบ = actor สังเคราะห์ `link:<id>` (ไม่ใช่คน — ไม่นับเป็นผู้เตรียม/ผู้อนุมัติ)
model SettlementLineReview {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  settlementId  String            @map("settlement_id") @db.Uuid
  settlement    CarrierSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  lineId        String            @map("line_id") @db.Uuid
  line          SettlementLine    @relation(fields: [lineId], references: [id], onDelete: Restrict)
  round         Int
  /// ACCEPTED / DISPUTED
  response      String
  reason        String?
  /// รูปประกอบ (stored_document ที่จองผ่านลิงก์นี้สำหรับบรรทัดนี้)
  photoIds      String[]          @default([]) @map("photo_ids") @db.Uuid
  /// ST6-T06 ยอดที่รถร่วมเรียก (เฉพาะโต้แย้ง — ไม่บังคับ) ใช้ในหน้าเทียบ planned / executed / claimed
  claimedAmount Decimal?          @map("claimed_amount") @db.Decimal(14, 2)
  linkId        String            @map("link_id") @db.Uuid
  createdBy     String            @map("created_by")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, settlementId, round, lineId, createdAt])
  @@map("settlement_line_review")
}

/// ST6-T06 การตัดสินฝั่งบริษัทต่อบรรทัดใบสำคัญจ่าย (docs/04 F6 "Dispute", docs/01 §4.5 "รถร่วม/บัญชีติด dispute รายการ", spec/05 BIL-136)
/// DISPUTED = บริษัท (บัญชี) ติด dispute รายการเอง · RESOLVED = เคลียร์ — ยืนยันยอดเดิมพร้อมเหตุผล (ปิดทุก dispute ก่อนหน้าของบรรทัดในรอบ;
/// รถร่วมตอบบรรทัดนั้นในรอบนี้ไม่ได้อีก) · เพิ่มอย่างเดียว · ผู้บันทึก = คน (ไม่ใช่ลิงก์) · ผู้เคลียร์ = ผู้เตรียมใบ (อนุมัติไม่ได้ — SoD)
model SettlementLineDispute {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  settlementId String            @map("settlement_id") @db.Uuid
  settlement   CarrierSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  lineId       String            @map("line_id") @db.Uuid
  line         SettlementLine    @relation(fields: [lineId], references: [id], onDelete: Restrict)
  round        Int
  /// DISPUTED / RESOLVED
  action       String
  reason       String
  createdBy    String            @map("created_by")
  /// clock_timestamp() — ลำดับเทียบกับคำตอบของรถร่วมต้องเป็นเวลาที่บันทึกจริง (ไม่ใช่เวลาเริ่ม transaction)
  createdAt    DateTime          @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, settlementId, round, lineId, createdAt])
  @@map("settlement_line_dispute")
}

/// สถานะข้อเสนองาน/การจ้างรถร่วม (ST3-T22; spec/03 §8 SubconOffer — ชุดย่อยเฟส 0) · ACCEPTED = รถร่วมรับ (ผู้จัดรถบันทึกแทนผ่าน /assign หรือ ST3-T23)
enum SubconOfferStatus {
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN

  @@map("subcon_offer_status")
}

/// การจ้างรถร่วมต่อเที่ยว (ST3-T22; docs/04 D3 "เลือก carrier + ราคาซื้อ" + "บันทึกเหตุผลการเลือก `selectionReason`") —
/// เก็บทุกครั้งที่จ้าง (ประวัติคงอยู่ — ST3-T25) · ใช้งานได้ครั้งละ 1 ข้อเสนอต่อเที่ยว (OFFERED/ACCEPTED — unique partial)
model SubconOffer {
  id                  String            @id @default(uuid()) @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  tripId              String            @map("trip_id") @db.Uuid
  trip                Trip              @relation(fields: [tripId], references: [id], onDelete: Restrict)
  carrierId           String            @map("carrier_id") @db.Uuid
  carrier             Carrier           @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  carrierNameSnapshot String            @map("carrier_name_snapshot")
  status              SubconOfferStatus @default(OFFERED)
  /// ราคาซื้อที่ตกลง (ก่อน VAT ก่อนหัก ณ ที่จ่าย)
  buyAmount           Decimal           @map("buy_amount") @db.Decimal(14, 2)
  priceSource         String            @map("price_source") /// RATE_CARD (ตาม rate card) / MANUAL (กรอกเอง)
  /// ผลคิดราคาขาซื้อของรายนี้ ณ ตอนจ้าง {status, total, rateCardId, rateCardCode, revision, vatType, whtRate, serviceItemId}
  rateQuote           Json              @map("rate_quote")
  /// ตัวเลือกที่เทียบ ณ ตอนจ้าง {cheapestAmount, candidates: [{carrierId, code, name, amount, rateCardCode}]}
  comparison          Json
  /// CHEAPEST = ราคาไม่เกินรายที่ถูกสุด · OVERRIDE = ไม่ใช่ถูกสุด/เทียบไม่ได้ ต้องมีเหตุผลจากผู้จ้าง
  selectionKind       String            @map("selection_kind")
  selectionReason     String            @map("selection_reason") /// ไม่ว่างเสมอ (CHECK)
  vehicleTypeId       String?           @map("vehicle_type_id") @db.Uuid
  sellAmount          Decimal?          @map("sell_amount") @db.Decimal(14, 2) /// รายได้ของเที่ยว ณ ตอนจ้าง (ไม่ส่งถึงรถร่วม)
  offeredBy           String?           @map("offered_by")
  offeredAt           DateTime          @default(now()) @map("offered_at") @db.Timestamptz(6)
  closedAt            DateTime?         @map("closed_at") @db.Timestamptz(6)
  closedReason        String?           @map("closed_reason")
  /// ST3-T25 เหตุที่ปิด (ระบบ): CARRIER_CHANGED = เปลี่ยนผู้รับเหมา — ไม่นับรายนั้นเป็นถูกสุดในการจ้างครั้งต่อไป
  closedCause         String?           @map("closed_cause")
  /// ST3-T23 ลิงก์ข้อเสนองาน: หมดเวลาตอบ (48 ชม. — docs/04 D3) · เปิดดูครั้งแรก · ตอบเมื่อ/ทางไหน (LINK / USER)
  expiresAt           DateTime?         @map("expires_at") @db.Timestamptz(6)
  viewedAt            DateTime?         @map("viewed_at") @db.Timestamptz(6)
  respondedAt         DateTime?         @map("responded_at") @db.Timestamptz(6)
  respondedVia        String?           @map("responded_via")
  /// ST3-T24 ครบเวลาตอบ (เวลาเสนอ + N ชม. ตามค่าตั้ง `dispatch.subconResponseHours` ณ ตอนจ้าง) · แจ้งผู้จัดรถแล้วเมื่อ (ครั้งเดียว)
  responseDueAt       DateTime?         @map("response_due_at") @db.Timestamptz(6)
  timeoutNotifiedAt   DateTime?         @map("timeout_notified_at") @db.Timestamptz(6)
  /// ST3-T24 (review L2) job ปิด/แจ้งล้ม → นับครั้ง + เลื่อนรอบถัดไป (backoff) ไม่ให้แถวเสียวนทุกนาที/บังแถวอื่น
  timeoutAttempts     Int               @default(0) @map("timeout_attempts")
  timeoutNextAt       DateTime?         @map("timeout_next_at") @db.Timestamptz(6)
  /// ปฏิเสธ: รหัสเหตุผล (SUBCON_REJECT_REASONS) + หมายเหตุ
  rejectReasonCode    String?           @map("reject_reason_code")
  rejectNote          String?           @map("reject_note")
  /// รับงาน: ทะเบียน/คนขับตามที่รถร่วมกรอก (snapshot) + รถ/คนขับที่จับคู่ได้
  acceptedPlate       String?           @map("accepted_plate")
  acceptedVehicleId   String?           @map("accepted_vehicle_id") @db.Uuid
  acceptedVehicle     Vehicle?          @relation("SubconOfferVehicle", fields: [acceptedVehicleId], references: [id], onDelete: Restrict)
  acceptedDriverName  String?           @map("accepted_driver_name")
  acceptedDriverPhone String?           @map("accepted_driver_phone")
  acceptedDriverId    String?           @map("accepted_driver_id") @db.Uuid
  acceptedDriver      Driver?           @relation("SubconOfferDriver", fields: [acceptedDriverId], references: [id], onDelete: Restrict)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  costs TripCost[]

  @@index([tenantId, tripId])
  @@index([tenantId, carrierId, offeredAt])
  @@index([tenantId, acceptedVehicleId])
  @@index([tenantId, acceptedDriverId])
  @@map("subcon_offer")
}

// ---------- ST4 Execution ----------
/// ชนิด event หน้างาน (ST4-T01; docs/04 E1 Stop event) — DEPART = ออกเดินทางมุ่งหน้าไปจุดนี้ (docs/01 §3.9)
/// LOADED / DELAY / NOTE ของ docs/01 §3.9 ยังไม่เปิด (แอปคนขับ P1 — เพิ่มค่า enum ภายหลัง)
enum StopEventType {
  ARRIVE
  DEPART
  COMPLETE
  FAIL

  @@map("stop_event_type")
}

/// event ต่อจุดแวะ (ST4-T01; docs/01 §3.9) — append-only (trigger + REVOKE): แหล่งความจริงของเวลาถึง/ออก/ปิดงาน
/// idempotent ด้วย unique (tenant_id, client_event_id) · เวลาสองชุด occurred_at (เครื่อง) / received_at (server)
/// แก้ได้เฉพาะช่องทำบัญชีของ projection: attachments_pending (T07), sequence_conflict (T02), applied_at (T03)
model StopEvent {
  id                 String                @id @default(uuid()) @db.Uuid
  tenantId           String                @map("tenant_id") @db.Uuid
  tripStopId         String                @map("trip_stop_id") @db.Uuid
  tripStop           TripStop              @relation(fields: [tripStopId, tripId], references: [id, tripId], onDelete: Restrict, onUpdate: Restrict, map: "stop_event_trip_stop_same_trip_fkey")
  /// denormalize จาก trip_stop (FK คู่ (trip_stop_id, trip_id) กันไม่ตรงเที่ยว)
  tripId             String                @map("trip_id") @db.Uuid
  trip               Trip                  @relation(fields: [tripId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  type               StopEventType
  /// DELIVERED / PARTIAL / FAILED / UNDELIVERED_RETAIN — COMPLETE ต้องมี · FAIL มีได้ (FAILED / UNDELIVERED_RETAIN) · CHECK
  outcome            String?
  reasonCodeId       String?               @map("reason_code_id") @db.Uuid
  reasonCode         ReasonCode?           @relation(fields: [reasonCodeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  clientEventId      String                @map("client_event_id") @db.Uuid
  /// APP / LINK / WEB / API / GPS (CHECK) — server กำหนดจากชนิดผู้เรียก ไม่รับจาก body
  source             String
  /// ผู้บันทึก (user id) — docs/01 §3.9 `created_by`
  actor              String?
  lat                Decimal?              @db.Decimal(9, 6)
  lng                Decimal?              @db.Decimal(9, 6)
  accuracyM          Decimal?              @map("accuracy_m") @db.Decimal(8, 1)
  occurredAt         DateTime              @map("occurred_at") @db.Timestamptz(6)
  receivedAt         DateTime              @default(now()) @map("received_at") @db.Timestamptz(6)
  /// {note?, reason?: ReasonSnapshot} — ข้อมูลเฉพาะชนิด (POD lines/รูป = T07/T09)
  payload            Json?
  attachmentsPending Int                   @default(0) @map("attachments_pending")
  sequenceConflict   Boolean               @default(false) @map("sequence_conflict")
  appliedAt          DateTime?             @map("applied_at") @db.Timestamptz(6)
  /// ST4-T02: occurredAt เพี้ยนจาก receivedAt (อนาคต > 5 นาที / ย้อนหลัง > 24 ชม.) — ธง ไม่แก้เวลา
  clockSkew          Boolean               @default(false) @map("clock_skew")
  /// ST4-T02: STOP_REMOVED / TRIP_CANCELLED / TRIP_COMPLETED — มาหลังปิด รับเก็บ + ธง (CHECK)
  lateReason         String?               @map("late_reason")
  /// ST4-T03: ปิดงานส่งขณะจุดรับของ DO ยังไม่ปิดสำเร็จ (ธง PICKUP_NOT_DONE — projection)
  pickupPending      Boolean               @default(false) @map("pickup_pending")
  /// ST4-T03: ผลปิดจุดขัดกับสถานะ DO ที่ไล่แล้ว (ธงแจ้ง OUTCOME_MISMATCH — projection)
  outcomeMismatch    Boolean               @default(false) @map("outcome_mismatch")
  resolutions        StopEventResolution[] @relation("StopEventResolutions")
  /// ST4-T02: การตัดสินที่มีผลตอนนี้ (ธงตรงกับธงปัจจุบัน) — projection คำนวณใหม่ทุกครั้ง
  resolutionId       String?               @map("resolution_id") @db.Uuid
  resolution         StopEventResolution?  @relation("AppliedResolution", fields: [resolutionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, clientEventId])
  @@index([tenantId, tripStopId, occurredAt])
  @@index([tenantId, tripId, occurredAt])
  @@index([tenantId, receivedAt])
  @@index([tenantId, reasonCodeId])
  @@index([resolutionId], map: "stop_event_resolution_id_idx")
  @@map("stop_event")
}

/// ST4-T02 การตัดสินของ dispatcher ต่อ stop_event ที่มีธง (append-only) — ACCEPT ใช้ / IGNORE ไม่ใช้ · หมดผลเมื่อธงเปลี่ยน (ตัดสินใหม่ = แถวใหม่)
model StopEventResolution {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  stopEventId String      @map("stop_event_id") @db.Uuid
  stopEvent   StopEvent   @relation("StopEventResolutions", fields: [stopEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  appliedTo   StopEvent[] @relation("AppliedResolution")
  tripId      String      @map("trip_id") @db.Uuid
  trip        Trip        @relation(fields: [tripId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// ACCEPT / IGNORE (CHECK)
  decision    String
  /// ≥ 10 ตัวอักษร (CHECK)
  reason      String
  /// ธงของ event ณ เวลาตัดสิน (LATE / SEQUENCE_CONFLICT / CLOCK_SKEW)
  flags       String[]
  resolvedBy  String?     @map("resolved_by")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tenantId, stopEventId, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, tripId])
  @@map("stop_event_resolution")
}

/// ไฟล์ (POD, PDF, เอกสารรถ) — เนื้อไฟล์อยู่ใน FileStore แบบ immutable (T-09)
model StoredDocument {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  /// ST1-T08: PENDING = จองแล้วรออัปโหลด, READY = ไฟล์ผ่านการตรวจแล้ว
  /// ST9-T14: PURGED = หมดระยะเก็บ (ไฟล์ส่งออก 7 วัน) — แถวคงอยู่ (sha256 + metadata + file_key) ดาวน์โหลดไม่ได้; ลบไฟล์จริงแล้ว = file_removed_at
  status           String    @default("READY")
  fileKey          String?   @map("file_key")
  sha256           String?
  mimeType         String    @map("mime_type")
  sizeBytes        Int       @map("size_bytes")
  filename         String?
  clientDocumentId String?   @map("client_document_id") /// กันอัปโหลดซ้ำจากอุปกรณ์ (docs/01 §5.5)
  metadata         Json?
  kind             String /// POD_PHOTO / POD_SIGNATURE / PDF / VEHICLE_DOC / OTHER
  entityType       String?   @map("entity_type")
  entityId         String?   @map("entity_id") @db.Uuid
  createdBy        String?   @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// ST9-T14 เวลาที่ retention job เปลี่ยนเป็น PURGED
  purgedAt         DateTime? @map("purged_at") @db.Timestamptz(6)
  /// ST9-T14 เวลาที่ลบไฟล์จริง (หรือพบว่าแถวอื่นยังใช้ไฟล์เดียวกัน จึงไม่ลบ) — null = ยังต้องทำ
  fileRemovedAt    DateTime? @map("file_removed_at") @db.Timestamptz(6)

  doSurcharges DoSurcharge[]
  tripCosts    TripCost[]
  invoices     Invoice[]
  /// ST5-T11 ใบวางบิล
  billingNotes BillingNote[]

  @@unique([tenantId, clientDocumentId])
  @@index([tenantId, entityType, entityId])
  /// ST9-T14 retention job หาไฟล์ตามชนิด + อายุ
  @@index([kind, createdAt])
  /// ST9-T14 ตรวจว่ายังมีแถวอ้างไฟล์ก่อนลบ
  @@index([fileKey])
  @@map("stored_document")
}

/// ตำแหน่งรถ — schema เตรียมไว้ (T-18) ยังไม่มีตัวป้อนในเฟส 0; เก็บ ≥ 90 วัน ตาม `retention.gpsLogDays` (ST9-T14)
model VehiclePosition {
  id         BigInt   @id @default(autoincrement())
  tenantId   String   @map("tenant_id") @db.Uuid
  vehicleId  String   @map("vehicle_id") @db.Uuid
  tripId     String?  @map("trip_id") @db.Uuid
  source     String
  lat        Decimal  @db.Decimal(9, 6)
  lng        Decimal  @db.Decimal(9, 6)
  speedKmh   Decimal? @map("speed_kmh") @db.Decimal(5, 1)
  heading    Int?
  accuracyM  Int?     @map("accuracy_m")
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@index([tenantId, vehicleId, occurredAt])
  /// ST9-T14 retention (GPS log ≥ 90 วัน นับจากเวลาที่เรารับ — นาฬิกาอุปกรณ์ผิดไม่ทำให้ลบเร็ว)
  @@index([receivedAt])
  @@map("vehicle_position")
}

// ───────────────────────── ST1-T01/T04 Auth (ตาราง platform: ใช้ก่อนรู้ tenant จึงไม่มี RLS และ tms_app เข้าไม่ได้) ─────────────────────────

/// ST7-T08 bucket ของ rate limit กลาง (UNLOGGED, ไม่มี tenant_id/RLS) — เขียนผ่านฟังก์ชัน tms_rate_limit_take() เท่านั้น
model RateLimitBucket {
  key       String    @id
  tat       Float?
  hits      Float[]
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  @@map("rate_limit_bucket")
}

/// ทุกครั้งที่พยายาม login (สำเร็จ/ล้มเหลว) — ใช้ทั้ง rate limit/ล็อก (A1) และประวัติ login (A2, ST1-T11; เก็บ 1 ปี)
model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  email     String /// lower-case แล้ว
  ip        String
  userAgent String?  @map("user_agent")
  tenantId  String?  @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  success   Boolean
  reason    String? /// invalid_credentials | locked | tenant_selection_required | ok
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([tenantId, createdAt])
  /// ST9-T14 retention (แถวที่ไม่รู้ tenant ใช้ขั้นต่ำ 1 ปี)
  @@index([createdAt])
  @@map("login_attempt")
}

/// authorization code ของ flow Auth Code + PKCE (T-04) — อายุ 60 วินาที ใช้ครั้งเดียว
model AuthCode {
  id            String    @id @default(uuid()) @db.Uuid
  codeHash      String    @unique @map("code_hash") /// sha256 base64url
  codeChallenge String    @map("code_challenge") /// S256
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("auth_code")
}

/// refresh token (httpOnly cookie) — หมุนทุกครั้งที่ใช้; ใช้ token เก่าซ้ำ = ถูกขโมย → เพิกถอนทั้ง family
model RefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  familyId      String    @map("family_id") @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenVersion  Int       @map("token_version")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6) /// 7 วันนับจาก login (ไม่ต่ออายุตอนหมุน)
  idleExpiresAt DateTime  @map("idle_expires_at") @db.Timestamptz(6) /// idle 8 ชม. (ตั้งได้ใน ST1-T17)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent     String?   @map("user_agent")
  ip            String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_token")
}

/// ขั้นที่ 2 ของ login (ST1-T05) — ผ่านรหัสผ่านแล้ว รอ TOTP / ตั้ง TOTP (ตาราง platform เหมือน auth_code)
model MfaChallenge {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  purpose       String /// verify | enroll
  codeChallenge String    @map("code_challenge") /// PKCE ของ login เดิม
  pendingSecret String?   @map("pending_secret") /// enroll: secret ที่ยังไม่ยืนยัน (เข้ารหัส)
  attempts      Int       @default(0)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("mfa_challenge")
}

/// backup code 10 ชุดต่อผู้ใช้ ใช้ได้ครั้งเดียว (A1) — เก็บ hash เท่านั้น
model BackupCode {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, userId])
  @@map("backup_code")
}

/// จำอุปกรณ์ 30 วัน (A1 Session) — cookie `tms_td` ข้ามขั้น TOTP; เพิกถอนเมื่อ bump tokenVersion
model TrustedDevice {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenVersion Int       @map("token_version")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("trusted_device")
}

/// ค่าตั้งองค์กร (ST1-T17) — key ต้องลงทะเบียนใน src/modules/settings/registry.ts (มี type + default); ไม่มีแถว = ใช้ default
model TenantSetting {
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  value     Json
  version   Int      @default(1)
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([tenantId, key])
  @@map("tenant_setting")
}

/// รหัสผ่านเดิม (ST1-T02: ห้ามซ้ำ 5 ครั้งล่าสุด) — เก็บ hash argon2id เท่านั้น; ใช้ผ่าน role platform
model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, userId, createdAt])
  @@map("password_history")
}

/// แพ็กเกจ (ST1-T18; spec/01 §6) — ข้อมูลตัวอย่างจาก design/prototype/plans.js (ราคา/โควตายังไม่สรุป)
model Plan {
  code             String            @id
  nameTh           String            @map("name_th")
  nameEn           String?           @map("name_en")
  rateLimitProfile String            @default("standard") @map("rate_limit_profile") @db.VarChar(20) /// ST7-T08 standard | high (CHECK) — ค่าใน http/rate-limit/profiles.ts
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  tenants          Tenant[]
  entitlements     PlanEntitlement[]

  @@map("plan")
}

/// เซลล์ใน feature matrix: แพ็กเกจ × ฟีเจอร์ → mode included / addon / not_available + limit (null = ไม่จำกัด)
model PlanEntitlement {
  planCode   String @map("plan_code")
  featureKey String @map("feature_key")
  mode       String /// included | addon | not_available (CHECK — migration 0017)
  limit      Int?
  plan       Plan   @relation(fields: [planCode], references: [code], onUpdate: Cascade, onDelete: Cascade)

  @@id([planCode, featureKey])
  @@map("plan_entitlement")
}

/// override ต่อ tenant (spec/01 PLT-062): grant / revoke / set_limit + เหตุผล + วันหมดอายุ — แก้จาก Platform Console เท่านั้น
model TenantEntitlementOverride {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  featureKey String    @map("feature_key")
  mode       String
  limit      Int?
  reason     String
  approvedBy String?   @map("approved_by")
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, featureKey])
  @@map("tenant_entitlement_override")
}

/// ลิงก์เข้าถึงโดยไม่ login (ST1-T06; docs/04 A1/J) — token เซ็น HMAC + หมดอายุ; action ที่ทำได้และการเพิกถอนอยู่ที่แถวนี้
model MagicLink {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  /// trip_offer / pod / settlement_view / tracking
  purpose       String
  entityType    String    @map("entity_type")
  entityId      String    @map("entity_id") @db.Uuid
  actions       String[]
  /// scope ที่ลิงก์ได้ (เช่น รถร่วมเห็นราคาซื้อของตัวเอง `prices.buy:read`) — ราคาขายไม่มีทางได้ (principal `link`)
  scopes        String[]
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason")
  createdBy     String?   @map("created_by")
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, purpose, entityId])
  @@map("magic_link")
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// อีเมลขาออก (ST1-T03; docs/04 A1) — เขียนใน transaction ของงาน แล้ว worker ส่งผ่าน EmailTransport
/// เนื้อหา (มีลิงก์/token) ถูกลบทันทีที่ส่งสำเร็จหรือเลิกส่ง — เก็บแค่หัวเรื่อง/ผู้รับ/สถานะไว้ตรวจย้อน
model EmailOutbox {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String?     @map("tenant_id") @db.Uuid /// null = อีเมลระบบที่ยังไม่รู้บริษัท (ลืมรหัสผ่าน)
  toAddress         String      @map("to_address")
  template          String
  locale            String
  subject           String
  textBody          String?     @map("text_body")
  htmlBody          String?     @map("html_body")
  status            EmailStatus @default(PENDING)
  attempts          Int         @default(0)
  maxAttempts       Int         @default(5) @map("max_attempts")
  runAt             DateTime    @default(dbgenerated("now()")) @map("run_at") @db.Timestamptz(6) /// นาฬิกาฐานข้อมูล — claim เทียบกับ now() (เหมือน job)
  lockedUntil       DateTime?   @map("locked_until") @db.Timestamptz(6)
  sentAt            DateTime?   @map("sent_at") @db.Timestamptz(6)
  providerMessageId String?     @map("provider_message_id")
  error             String?
  /// ST5-T21 ไฟล์แนบ `[{fileKey, filename, contentType}]` — key ใน FileStore (ไม่เก็บเนื้อไฟล์ในตาราง) · null = ไม่มีไฟล์แนบ
  attachments       Json?
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, runAt])
  @@index([tenantId, createdAt])
  @@map("email_outbox")
}

/// ST5-T21 ส่งเอกสาร (ใบแจ้งหนี้ / ชุดใบวางบิล + ใบแจ้งหนี้) ทางอีเมลถึงลูกค้า (docs/04 F3; spec/05 BIL-041) — 1 แถว = ผู้รับ 1 คน
/// สถานะการส่งแยกจากสถานะเอกสาร (spec/05 §3 ข้อ 8) — worker (role platform) เปลี่ยนตาม email_outbox: QUEUED → SENT / FAILED (`sandbox_suppressed` / `email_failed`)
/// role แอป: อ่าน/สร้างเท่านั้น
model DocumentEmail {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  /// invoice · billing_note
  entityType           String    @map("entity_type")
  entityId             String    @map("entity_id") @db.Uuid
  /// DOCUMENT = ส่งเอกสาร · PAYMENT_REMINDER = ใบแจ้งเตือนชำระ (ต้นแบบหน้า "รับชำระ")
  purpose              String
  /// เลขเอกสาร ณ วันส่ง
  documentNo           String    @map("document_no")
  toAddress            String    @map("to_address")
  /// ไฟล์ที่แนบ (stored_document — PDF รายใบ หรือไฟล์รวมชุดใบวางบิล)
  attachmentDocumentId String    @map("attachment_document_id") @db.Uuid
  emailOutboxId        String    @map("email_outbox_id") @db.Uuid
  /// ใบแจ้งหนี้ทั้งหมดในไฟล์แนบ (ใบเดียว หรือทุกใบในชุดใบวางบิล) — ใช้ตรวจ "ยังมีการส่งอื่นที่ส่ง/รอส่งอยู่" ตอนล้างธง
  invoiceIds           String[]  @default([]) @map("invoice_ids") @db.Uuid
  /// ใบแจ้งหนี้ที่การส่งครั้งนี้ตั้งธง "ส่งลูกค้าแล้ว" (ช่องทาง EMAIL) — ส่งไม่สำเร็จ/sandbox → worker ล้างธงคืน (review M1)
  flaggedInvoiceIds    String[]  @default([]) @map("flagged_invoice_ids") @db.Uuid
  /// เวลาที่ตั้งธง (= invoice.sent_to_customer_at ที่การส่งนี้ตั้ง) — ล้างเฉพาะเมื่อธงยังเป็นของการส่งนี้
  flaggedAt            DateTime? @map("flagged_at") @db.Timestamptz(6)
  /// QUEUED · SENT · FAILED
  status               String    @default("QUEUED")
  failedReason         String?   @map("failed_reason")
  sentAt               DateTime? @map("sent_at") @db.Timestamptz(6)
  createdBy            String?   @map("created_by")
  createdAt            DateTime  @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tenantId, entityType, entityId, createdAt])
  @@index([emailOutboxId])
  @@index([invoiceIds], type: Gin)
  @@index([tenantId, createdAt])
  @@map("document_email")
}

/// token ลืมรหัสผ่าน (ST1-T03; PLT-032) — อายุ 30 นาที ใช้ครั้งเดียว · ผูกกับอีเมล (ตัวตนเดียวข้ามบริษัท) · เก็บแค่ hash
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  email     String /// lower-case แล้ว
  ip        String?
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("password_reset_token")
}

/// คำเชิญผู้ใช้ (ST1-T07; docs/04 A2; spec/01 §3) — ลิงก์อีเมล 7 วัน ใช้ครั้งเดียว · ผูกกับแถว app_user สถานะ INVITED (role ตั้งตอนเชิญ)
/// ส่งใหม่ = เพิกถอนแถวเดิม + ออกแถวใหม่ · เก็บแค่ hash ของ token
model UserInvitation {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  email         String /// lower-case แล้ว
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  invitedBy     String?   @map("invited_by") @db.Uuid
  acceptedAt    DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user          AppUser   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId, userId])
  @@map("user_invitation")
}

/// ช่องทางแจ้งเตือน (ST1-T23; docs/04 I, spec/10 Notification) — push/line/sms เสียบภายหลัง (ST3-T21, เฟส 2)
enum NotificationStatus {
  QUEUED
  SENT
  READ
  FAILED
}

/// แจ้งเตือน 1 แถว = ผู้รับ 1 คน × ช่องทาง 1 ช่อง (ST1-T23) — เนื้อหา render ตอนสร้างตามภาษาของผู้รับ
model Notification {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  recipientId       String             @map("recipient_id") @db.Uuid /// app_user.id
  channel           String /// in_app · email (· push · line · sms ภายหลัง)
  templateCode      String             @map("template_code")
  locale            String
  title             String
  body              String
  link              String? /// path ภายในเว็บ เช่น /settings/users
  payload           Json               @default("{}")
  status            NotificationStatus @default(QUEUED)
  emailOutboxId     String?            @map("email_outbox_id") @db.Uuid
  sentAt            DateTime?          @map("sent_at") @db.Timestamptz(6)
  readAt            DateTime?          @map("read_at") @db.Timestamptz(6)
  failedReason      String?            @map("failed_reason")
  relatedEntityType String?            @map("related_entity_type")
  relatedEntityId   String?            @map("related_entity_id")
  createdAt         DateTime           @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(3) /// ms — ตรงกับ cursor (JS Date) ไม่ข้ามแถวที่ต่างกันระดับ µs
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tenantId, recipientId, channel, createdAt])
  @@index([emailOutboxId])
  @@map("notification")
}

/// สมุดสรุปรายวัน 08:00 (ST9-T08; docs/04 I) — 1 แถว = ผู้ใช้ 1 คนได้สรุปของวันหนึ่งแล้ว (หรือไม่มีอะไรให้สรุป: items = 0)
/// unique = ส่งครั้งเดียวต่อคนต่อวัน แม้ job รันซ้ำ/หลาย worker/ลองใหม่ · digest_day = วันที่เวลาไทยของรอบ 08:00
model NotificationDigest {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid /// app_user.id
  digestDay DateTime @map("digest_day") @db.Date
  /// จำนวนแจ้งเตือนในกระดิ่งช่วง 24 ชม. ที่สรุป (0 = ไม่ได้ส่งอีเมล)
  items     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, userId, digestDay])
  @@index([tenantId, digestDay])
  @@map("notification_digest")
}

/// สมุดการเตือนวันหมดอายุ (ST2-T18) — 1 แถว = ผู้รับ 1 คนได้รับเตือนระดับหนึ่งของสิ่งหนึ่ง ณ วันหมดหนึ่งแล้ว
/// unique = ไม่เตือนซ้ำ แม้ job รันซ้ำ/พร้อมกัน · แยกต่อผู้รับ → ส่งสรุปของแต่ละคนใน transaction ของตัวเองได้ (คนหนึ่งล้มไม่กระทบคนอื่น)
/// ต่ออายุ/เปลี่ยนวันหมด → expires_on ใหม่ = รอบเตือนใหม่ · entity_type: VEHICLE_DOCUMENT / DRIVER_LICENCE / RATE_CARD
/// level: D60 / D30 / D7 (เหลือ ≤ N วัน) / EXPIRED (เลยวันหมดแล้ว)
/// ST5-T22 ใช้ร่วมกับเตือนครบกำหนดชำระ: entity_type INVOICE · expires_on = วันครบกำหนด · level DUE_IN_3/DUE_TODAY/OVERDUE_7/OVERDUE_30 (migration 0148)
model ExpiryReminder {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  level       String
  expiresOn   DateTime @map("expires_on") @db.Date
  recipientId String   @map("recipient_id") @db.Uuid /// app_user.id
  /// วันที่ (เวลาไทย) ที่ job ส่งเตือน
  sentOn      DateTime @map("sent_on") @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, entityType, entityId, expiresOn, level, recipientId])
  @@index([tenantId, sentOn])
  @@map("expiry_reminder")
}

/// งานนำเข้า Excel/CSV (ST1-T19; spec/02 §11.6)
enum ImportStatus {
  VALIDATING
  VALIDATED
  IMPORTING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

/// งานนำเข้า 1 ไฟล์ (ST1-T19; docs/04 A5, spec/02 §11) — ไฟล์อยู่ใน stored_document (kind IMPORT)
/// ขั้นตรวจ (dry-run) ไม่เขียนข้อมูลจริง; ยืนยันแล้วตรวจซ้ำก่อนเขียน
model ImportJob {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  kind             String /// entity ที่นำเข้า (ImportSpec.kind)
  documentId       String       @map("document_id") @db.Uuid
  fileName         String?      @map("file_name")
  status           ImportStatus @default(VALIDATING)
  mode             String       @default("create_only") /// create_only · upsert_by_code · update_only
  errorPolicy      String       @default("all_or_nothing") @map("error_policy") /// all_or_nothing · skip_invalid_rows
  headers          Json         @default("[]") /// หัวคอลัมน์ในไฟล์
  mapping          Json         @default("{}") /// field key → หัวคอลัมน์ในไฟล์
  totalRows        Int          @default(0) @map("total_rows")
  okRows           Int          @default(0) @map("ok_rows")
  errorRows        Int          @default(0) @map("error_rows")
  importedRows     Int          @default(0) @map("imported_rows")
  /// จำนวนรายการ (entity) ที่ผ่าน/นำเข้า เมื่อ 1 รายการมีได้หลายแถว (order — ST3-T04) · null = 1 แถว = 1 รายการ
  okEntities       Int?         @map("ok_entities")
  importedEntities Int?         @map("imported_entities")
  /// ผลตรวจรายแถว [{row, column, value, code, message}] (เฉพาะแถวผิด/เตือน; สูงสุด 5,000 รายการ)
  issues           Json         @default("[]")
  /// 3 แถวแรก (ค่าตามฟิลด์) ไว้แสดงตัวอย่างในขั้นจับคู่คอลัมน์
  sample           Json         @default("[]")
  fileError        String?      @map("file_error") /// ผิดทั้งไฟล์ (เช่น เกิน 5,000 แถว, ไม่มีหัวคอลัมน์)
  fileErrorCode    String?      @map("file_error_code") /// code ของ fileError: no_header / too_many_rows / unreadable / duplicate_header / file_rejected / quota_exceeded (ST2-T23)
  jobId            String?      @map("job_id") @db.Uuid
  expiresAt        DateTime     @map("expires_at") @db.Timestamptz(6) /// ผลตรวจหมดอายุ 24 ชม.
  createdBy        String?      @map("created_by")
  createdAt        DateTime     @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(3) /// ms — ตรงกับ cursor
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@map("import_job")
}

/// สถานะ setup checklist ต่อ tenant (ST1-T21; spec/01 §4) — ขั้นต่าง ๆ คำนวณจากข้อมูลจริง (PLT-040)
/// เก็บเฉพาะสิ่งที่คำนวณไม่ได้: ข้ามขั้นเชื่อมระบบบัญชี, ครบแล้ว (การ์ดหายถาวร — PLT-041), ผู้ใช้ที่กดซ่อน
model SetupChecklistState {
  tenantId           String    @id @map("tenant_id") @db.Uuid
  connectorSkippedAt DateTime? @map("connector_skipped_at") @db.Timestamptz(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)
  hiddenFor          String[]  @default([]) @map("hidden_for") @db.Uuid
  /// ขั้นที่ผู้ใช้ยืนยันค่าเริ่มต้นแล้ว (org / tax / numbering) — กดบันทึกโดยไม่เปลี่ยนค่า หรือเปิดหน้าเลขเอกสาร
  reviewedSteps      String[]  @default([]) @map("reviewed_steps")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("setup_checklist_state")
}

/// ทีม Innovera (ST1-T24; docs/04 A6) — แยกจากผู้ใช้ของลูกค้า ไม่มี tenant_id; role แอปเข้าไม่ได้ (platform เท่านั้น)
enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
  BILLING
}

model PlatformUser {
  id             String                 @id @default(uuid()) @db.Uuid
  email          String                 @unique
  name           String
  role           PlatformRole
  passwordHash   String                 @map("password_hash")
  /// TOTP (เข้ารหัสด้วย FieldCipher) — บังคับทุกคน ตั้งตอนสร้างบัญชี
  totpSecret     String                 @map("totp_secret")
  totpLastStep   BigInt?                @map("totp_last_step")
  status         String                 @default("ACTIVE") /// ACTIVE · DISABLED
  tokenVersion   Int                    @default(0) @map("token_version")
  failedLogins   Int                    @default(0) @map("failed_logins")
  lockedUntil    DateTime?              @map("locked_until") @db.Timestamptz(6)
  lastLoginAt    DateTime?              @map("last_login_at") @db.Timestamptz(6)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  impersonations ImpersonationSession[]

  @@map("platform_user")
}

/// เข้าใช้งานแทน (ST1-T24; spec/01 §11.1) — เฟส 0 อ่านอย่างเดียวเสมอ, หมดอายุ 60 นาที
model ImpersonationSession {
  id             String       @id @default(uuid()) @db.Uuid
  platformUserId String       @map("platform_user_id") @db.Uuid
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id])
  tenantId       String       @map("tenant_id") @db.Uuid
  asUserId       String       @map("as_user_id") @db.Uuid
  mode           String       @default("read_only")
  reason         String
  ticketRef      String?      @map("ticket_ref")
  startedAt      DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  endedAt        DateTime?    @map("ended_at") @db.Timestamptz(6)
  endReason      String?      @map("end_reason") /// manual · timeout · revoked
  ip             String?
  userAgent      String?      @map("user_agent")

  @@index([tenantId, startedAt])
  @@map("impersonation_session")
}

/// ST3-T21 ตั้งค่าช่องส่งข้อความต่อ tenant (docs/04 G4 LINE OA / Messaging API) — channel access token เข้ารหัส FieldCipher
/// ไม่คืนค่า token ใน API (คืนแค่ 4 ตัวท้าย) · SMS ใช้บัญชีผู้ให้บริการระดับระบบ (env) เปิด/ปิดต่อ tenant ได้
model MessagingSetting {
  tenantId       String   @id @map("tenant_id") @db.Uuid
  lineEnabled    Boolean  @default(false) @map("line_enabled")
  lineTokenEnc   String?  @map("line_token_enc") /// channel access token (long-lived) → FieldCipher
  lineTokenLast4 String?  @map("line_token_last4") @db.VarChar(4)
  smsEnabled     Boolean  @default(false) @map("sms_enabled") /// ปิดเป็นค่าเริ่มต้น — admin เปิดเอง (review ST3-T21 M1)
  version        Int      @default(1)
  updatedBy      String?  @map("updated_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("messaging_setting")
}

/// ST3-T21 outbox + บันทึกการส่งข้อความ LINE/SMS (ลิงก์ตาม template) — API เขียนแถวใน transaction, worker ส่ง (retry + backoff)
/// ผู้รับเก็บแบบเข้ารหัส (recipient_enc) + แบบปิดบัง (recipient_masked) + blind index (rate limit ต่อผู้รับ)
/// ไม่เก็บเนื้อความ/ลิงก์ (token): เก็บตัวแปร template (vars) + magic_link_id — worker render + สร้าง URL ตอนส่ง
/// vars และ recipient_enc ถูกลบเมื่อจบ (SENT/FAILED) — role แอปอ่านสองคอลัมน์นี้ไม่ได้
model MessageDelivery {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  channel           String /// LINE | SMS
  template          String /// carrier_docs_link | job_offer_link | settlement_review_link | settlement_payment_status_link
  locale            String    @default("th")
  recipientEnc      String?   @map("recipient_enc")
  recipientMasked   String    @map("recipient_masked")
  recipientHash     String    @map("recipient_hash")
  recipientType     String?   @map("recipient_type") /// carrier | null (ระบุผู้รับตรง)
  recipientRefId    String?   @map("recipient_ref_id") @db.Uuid
  vars              Json? /// {sender, recipientName, ref, yearStyle} — ชื่อผ่าน sanitiser แล้ว
  magicLinkId       String?   @map("magic_link_id") @db.Uuid
  entityType        String?   @map("entity_type")
  entityId          String?   @map("entity_id") @db.Uuid
  status            String    @default("QUEUED") /// QUEUED | SENDING | SENT | FAILED
  attempts          Int       @default(0)
  maxAttempts       Int       @default(5) @map("max_attempts")
  runAt             DateTime  @default(dbgenerated("now()")) @map("run_at") @db.Timestamptz(6)
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(6)
  provider          String?
  providerMessageId String?   @map("provider_message_id")
  errorCode         String?   @map("error_code")
  error             String?
  createdBy         String?   @map("created_by")
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(6)
  failedAt          DateTime? @map("failed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, runAt])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, recipientHash, createdAt])
  @@map("message_delivery")
}

/// ST3-T21 เพดานต่อผู้รับข้ามทุกบริษัท (กันใช้ SMS/LINE ของระบบรบกวนคนคนเดียวจากหลายบริษัท) — ไม่มี tenant_id
model MessageRecipientCounter {
  recipientHash String   @map("recipient_hash")
  hour          DateTime @db.Timestamptz(6)
  count         Int      @default(0)

  @@id([recipientHash, hour])
  @@map("message_recipient_counter")
}

/// ST3-T05 ตำแหน่งที่ดึง order จากต้นทาง (connector `pullOrders`) ล่าสุด ต่อ tenant + connector · lease กันดึงซ้อนกัน
/// ST7-T14: ดึงผ่านแถว `connector` (ErpAdapter) = 1 แถวต่อ **connector id** (2 นิติบุคคลใช้ adapter เดียวกันได้ cursor แยก)
///   แถวที่ connector_id null = ต้นทางทดสอบตามรหัส (`mock` ของ OrderSourceRegistry — dev/test) — unique บางส่วนใน migration 0102
model ConnectorCursor {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  connectorKey  String     @map("connector_key") /// รหัส adapter (CONNECTOR_KEY_RE) เช่น `krs`, `demo`, `mock` — ป้ายที่มา `ERP:{key}` ของใบ
  /// connector ที่ดึง (FK) — null = ต้นทางทดสอบตามรหัส (ไม่มีแถว connector)
  connectorId   String?    @map("connector_id") @db.Uuid
  connector     Connector? @relation(fields: [connectorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cursor        String? /// watermark ทึบ (opaque) ที่ adapter คืนมา — null = ยังไม่เคยดึง
  leaseId       String?    @map("lease_id") @db.Uuid /// รอบดึงที่ถืออยู่ (กันสอง worker ดึงพร้อมกัน)
  leaseUntil    DateTime?  @map("lease_until") @db.Timestamptz(6)
  lastPullAt    DateTime?  @map("last_pull_at") @db.Timestamptz(6)
  lastSuccessAt DateTime?  @map("last_success_at") @db.Timestamptz(6) /// รอบล่าสุดที่ดึงครบโดยไม่มีใบที่ error
  lastResult    Json?      @map("last_result") /// สรุปรอบล่าสุด {counts, results[]} (ไม่เก็บ payload)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tenantId, connectorKey])
  @@index([connectorId])
  @@map("connector_cursor")
}

/// ST7-T13 สถานะ connector (docs/01 §3.7 ACTIVE/PAUSED/ERROR + DISCONNECTED = ยกเลิกการเชื่อม — spec/07 §1.6; ไม่มี hard delete)
enum ConnectorStatus {
  ACTIVE
  PAUSED
  ERROR
  DISCONNECTED
}

/// ST7-T13 การตั้งค่า ErpAdapter ต่อ tenant (docs/01 §3.7 `connector`, §6.1; docs/04 G3) — ไม่มีแถว = Standalone
/// routing ตามนิติบุคคล: company_id = ใช้กับนิติบุคคลนี้ (Invoice As / Tender As) · null = ทุกนิติบุคคลที่ไม่มีของตัวเอง
/// 1 connector ที่ยังไม่ยกเลิกต่อขอบเขต (tenant, company) — partial unique index ใน migration 0099
/// credential เข้ารหัส (FieldCipher) ไม่ส่งกลับทาง API · ค่าที่ไม่ลับ (base URL ฯลฯ) อยู่ใน settings
model Connector {
  id                   String          @id @default(uuid()) @db.Uuid
  tenantId             String          @map("tenant_id") @db.Uuid
  /// `ErpAdapter.key` ที่ลงทะเบียนใน ErpAdapterRegistry (CONNECTOR_KEY_RE) — ไม่มี enum ของ ERP ใน schema
  adapterKey           String          @map("adapter_key") @db.VarChar(32)
  /// นิติบุคคลที่ใช้ connector นี้ (FK company) — null = ค่าเริ่มต้นทุกนิติบุคคล
  companyId            String?         @map("company_id") @db.Uuid
  /// รหัสบริษัท/ฐานข้อมูลฝั่ง ERP ของนิติบุคคลนี้ (docs/04 A4 "map 1 สาขา ↔ 1 company ใน ERP")
  erpCompanyCode       String?         @map("erp_company_code") @db.VarChar(64)
  /// สาขา TMS (uuid) → รหัสบริษัท/สาขาฝั่ง ERP — ไม่มี = ใช้ erp_company_code
  branchMap            Json            @default("{}") @map("branch_map")
  /// subset ของ adapter.capabilities() ที่ tenant เปิด
  capabilitiesEnabled  String[]        @default([]) @map("capabilities_enabled")
  /// ค่าตั้งที่ไม่ลับตาม configFields ของ adapter (base URL ฯลฯ)
  settings             Json            @default("{}")
  /// credential (ช่อง secret ของ adapter) JSON เข้ารหัส FieldCipher — ไม่ส่งกลับ ไม่ลง log/audit
  credentialsEnc       String?         @map("credentials_enc")
  /// ชื่อช่อง credential ที่ตั้งแล้ว (แสดง "ตั้งแล้ว" ได้โดยไม่ถอดรหัส)
  credentialKeys       String[]        @default([]) @map("credential_keys")
  credentialsUpdatedAt DateTime?       @map("credentials_updated_at") @db.Timestamptz(6)
  /// ไม่ push เอกสารที่ issue_date ก่อนวันนี้ (docs/01 §6.4)
  syncFromDate         DateTime?       @map("sync_from_date") @db.Date
  /// ST7-T17 system-of-record (docs/04 G3; docs/01 §8.1) — ใครเป็นเจ้าของข้อมูลลูกค้า(หลัก) · null = ยังไม่เลือก
  customerOwner        SorOwner?       @map("customer_owner")
  /// ST7-T17 ใครเป็นเจ้าของเอกสารภาษี — ERP + ใบแจ้งหนี้ไปถึง ERP = TMS ไม่ออกเลขใบกำกับภาษี (SystemOfRecordPolicy)
  /// null = ยังไม่เลือก ("ต้องเลือก" docs/01 §8.1) → TMS ออกเลขตามปกติ แต่เปิด/ส่ง pushInvoice/pushCreditNote/replaceDocument ไม่ได้
  taxDocumentOwner     SorOwner?       @map("tax_document_owner")
  /// ST7-T17 กลุ่ม field → AUTO_SYNC / REGENERATE (เก็บเฉพาะที่ตั้ง — ค่าเริ่มต้นใน @tms/domain DEFAULT_SOR_FIELD_SYNC) · CHECK เป็น object
  fieldSync            Json            @default("{}") @map("field_sync")
  status               ConnectorStatus @default(PAUSED)
  /// เหตุผลของสถานะล่าสุด (หยุด/ผิดพลาด/ยกเลิก)
  statusReason         String?         @map("status_reason")
  statusChangedAt      DateTime?       @map("status_changed_at") @db.Timestamptz(6)
  lastHealthAt         DateTime?       @map("last_health_at") @db.Timestamptz(6)
  lastHealthOk         Boolean?        @map("last_health_ok")
  /// ผล healthCheck ล่าสุดที่ล้ม {errorClass, code, message} (ตัด secret แล้ว)
  lastHealthError      Json?           @map("last_health_error")
  /// ST8-T03 เวลาที่ healthCheck เริ่มล้มแบบ TRANSIENT ต่อเนื่อง (null = ปกติ) — ล้มต่อเนื่อง ≥ 30 นาที → ERROR (spec/07 §1 ตารางสถานะ)
  healthFailingSince   DateTime?       @map("health_failing_since") @db.Timestamptz(6)
  activatedAt          DateTime?       @map("activated_at") @db.Timestamptz(6)
  disconnectedAt       DateTime?       @map("disconnected_at") @db.Timestamptz(6)
  createdBy            String?         @map("created_by")
  version              Int             @default(1)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// ST7-T22 token ใน URL รับ webhook ขาเข้า: HMAC-SHA256(pepper, token) — ไม่เก็บตัวจริง (แสดงครั้งเดียวตอนออก/หมุน) · null = ไม่รับ
  inboundTokenHash      String?   @unique @map("inbound_token_hash") @db.VarChar(64)
  /// ส่วนต้นของ token สำหรับแสดงผล (`whin_` + 4 ตัว)
  inboundTokenPrefix    String?   @map("inbound_token_prefix") @db.VarChar(16)
  inboundTokenRotatedAt DateTime? @map("inbound_token_rotated_at") @db.Timestamptz(6)

  cursors          ConnectorCursor[]
  inboundEvents    ProcessedWebhookEvent[]
  masterCodes      ErpMasterCode[]
  codeMappings     ErpCodeMapping[]
  externalMappings ExternalMapping[]

  @@index([tenantId, createdAt, id])
  @@index([tenantId, companyId])
  @@map("connector")
}

/// ST7-T22 สถานะการประมวลผล webhook ขาเข้า (ledger) — RECEIVED → PROCESSED | FAILED
enum InboundEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

/// ST7-T22 Inbound webhook ledger (docs/04 G3 "Inbound webhook ledger" I10) — 1 แถวต่อ event ของผู้ให้บริการ
/// unique (tenant, connector, event_key) กัน replay: ส่งซ้ำ = ไม่ประมวลผลซ้ำ · แถวเกิดหลังตรวจลายเซ็นผ่านเท่านั้น
/// แอปแก้ได้เฉพาะคอลัมน์สถานะ (ตัวตน/payload แก้/ลบไม่ได้) · payload เข้ารหัส FieldCipher ล้างหลัง 30 วัน · แถวไม่ลบอัตโนมัติ (archive = OPEN)
model ProcessedWebhookEvent {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  connectorId     String             @map("connector_id") @db.Uuid
  connector       Connector          @relation(fields: [connectorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// `connector.adapter_key` ตอนรับ
  provider        String             @db.VarChar(32)
  /// รหัส event ของผู้ให้บริการ (จาก adapter) — กันซ้ำ
  eventKey        String             @map("event_key") @db.VarChar(200)
  eventType       String             @map("event_type") @db.VarChar(100)
  status          InboundEventStatus @default(RECEIVED)
  /// raw body เข้ารหัส FieldCipher — null หลังพ้นระยะเก็บ payload
  payloadEnc      String?            @map("payload_enc")
  payloadSha256   String             @map("payload_sha256") @db.Char(64)
  payloadBytes    Int                @map("payload_bytes")
  /// เวลาที่ผู้ให้บริการบอกว่าเกิด (ถ้ามี) · receivedAt = เวลาที่เรารับ
  occurredAt      DateTime?          @map("occurred_at") @db.Timestamptz(6)
  receivedAt      DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  /// ครั้งที่ส่งซ้ำมา (ไม่ประมวลผลซ้ำ) — นับไว้ดูอาการ
  duplicateCount  Int                @default(0) @map("duplicate_count")
  lastDuplicateAt DateTime?          @map("last_duplicate_at") @db.Timestamptz(6)
  attempts        Int                @default(0)
  processedAt     DateTime?          @map("processed_at") @db.Timestamptz(6)
  /// ผลล้มล่าสุด {code, message} (ตัด credential แล้ว)
  lastError       Json?              @map("last_error")
  /// สรุปผลประมวลผล (ไม่มี payload)
  result          Json?
  requestId       String?            @map("request_id")
  ip              String?
  updatedAt       DateTime           @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, connectorId, eventKey])
  @@index([tenantId, connectorId, receivedAt])
  @@index([receivedAt])
  @@map("processed_webhook_event")
}

/// ST7-T01 API key ของ tenant (docs/04 G1 Auth; spec/07 §6) — principal `client` ตัวเดียวกับ OAuth2 client credentials
/// secret แสดงครั้งเดียว: เก็บเฉพาะ HMAC-SHA256(pepper) + prefix แสดงผล · ไม่มี hard delete (เพิกถอน = revoke_at)
/// สถานะคำนวณ: revoke_at ≤ now → revoked · revoke_at > now → rotating (หมุนแล้ว ใช้ได้ถึง revoke_at ≤ 7 วัน) · expires_at ≤ now → expired · อื่น ๆ active
model ApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  name           String    @db.VarChar(80)
  /// live / test (`tk_live_` / `tk_test_`) — test ต้องมี sandbox (ST7-T09) จึงยังออกไม่ได้
  mode           String    @db.VarChar(8)
  /// `tk_live_` + 4 ตัวแรกของส่วนสุ่ม (แสดงในตาราง)
  prefix         String    @db.VarChar(16)
  /// HMAC-SHA256(API_KEY_PEPPER, key เต็ม) base64url — unique ทั้งระบบ (หา key จาก secret โดยไม่รู้ tenant)
  secretHash     String    @unique @map("secret_hash")
  /// scope แบบ `resource:verb` ของ packages/domain PERMISSIONS
  scopes         String[]
  /// CIDR/IP ที่อนุญาต (ว่าง = ทุก IP)
  ipAllowlist    String[]  @map("ip_allowlist")
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz(6)
  lastUsedIp     String?   @map("last_used_ip")
  /// INT-075: IP ล่าสุดที่ถูกปฏิเสธ (ไม่อยู่ใน allowlist) + เวลา
  lastRejectedIp String?   @map("last_rejected_ip")
  lastRejectedAt DateTime? @map("last_rejected_at") @db.Timestamptz(6)
  revokeAt       DateTime? @map("revoke_at") @db.Timestamptz(6)
  revokeReason   String?   @map("revoke_reason")
  revokedBy      String?   @map("revoked_by")
  /// key ใหม่ที่ออกแทนตอนหมุน (key เดิมชี้ไป key ใหม่)
  rotatedToId    String?   @map("rotated_to_id") @db.Uuid
  rotatedFromId  String?   @map("rotated_from_id") @db.Uuid
  createdBy      String?   @map("created_by")
  /// ST7-T07 pin พฤติกรรม API ของ key นี้ (`X-Api-Version` ค่าเริ่มของ key) — null = ตามวันสร้างบริษัท · header ในคำขอมาก่อนเสมอ
  apiVersion     DateTime? @map("api_version") @db.Date
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt, id])
  @@map("api_key")
}

/// ST7-T03 ประเภทปลายทางของคำสั่งใน outbox (docs/01 §3.7 integration_outbox.kind)
enum OutboxKind {
  ADAPTER
  WEBHOOK
}

/// ST7-T03 สถานะคำสั่ง outbox (docs/01 §3.7) — แยกจากสถานะเอกสาร · FAILED_FINAL = dead-letter
/// ST7-T17 เจ้าของข้อมูล/เอกสารตาม system-of-record ของ connector
enum SorOwner {
  TMS
  ERP

  @@map("sor_owner")
}

enum OutboxStatus {
  PENDING
  IN_FLIGHT
  DONE
  FAILED_RETRYABLE
  FAILED_FINAL
  SKIPPED
}

/// ST7-T03 ผู้รับ event ต่อ tenant — trigger บน domain_event เขียน integration_outbox 1 แถวต่อ subscription ที่ตรง
/// (transaction เดียวกับการเปลี่ยนสถานะ) · webhook endpoint (ST7-T04) / connector (ST7-T13/T16) สร้างแถวนี้
model IntegrationSubscription {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  kind       OutboxKind
  /// ตัวส่งที่ลงทะเบียนใน OutboxSinkRegistry เช่น `demo`, `webhook`, `erp`
  sink       String     @db.VarChar(40)
  /// id ปลายทาง (connector / webhook endpoint) — FK เพิ่มใน ST7-T04/T13
  targetId   String?    @map("target_id") @db.VarChar(100)
  /// ชนิด event ที่รับ: ชื่อเต็ม (`invoice.finalized`), `invoice.*` หรือ `*`
  eventTypes String[]   @map("event_types")
  /// ชื่อคำสั่ง (เช่น PUSH_INVOICE) — null = ใช้ชื่อ event
  operation  String?    @db.VarChar(60)
  /// false = หยุดสร้างคำสั่งใหม่ (คำสั่งเดิมยังส่งต่อ)
  active     Boolean    @default(true)
  createdBy  String?    @map("created_by")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tenantId, active])
  @@map("integration_subscription")
}

/// ST7-T03 คิวคำสั่งทุกอย่างที่ออกจาก core (docs/01 §3.7, §6.2) — worker หยิบด้วย FOR UPDATE SKIP LOCKED + lease
/// เรียงต่อ serialize_key (ปลายทาง + ลูกค้า) · round-robin ต่อ tenant · ไม่มี hard delete
/// role แอปสร้าง/อ่านได้อย่างเดียว (แก้สถานะโดย worker role platform — migration 0090) · index คิวที่ยังไม่จบเป็น partial index ใน SQL
model IntegrationOutbox {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  /// ลำดับการสร้าง (ใช้เรียงภายใน serialize_key)
  seq            BigInt       @default(autoincrement())
  kind           OutboxKind
  sink           String       @db.VarChar(40)
  targetId       String?      @map("target_id") @db.VarChar(100)
  subscriptionId String?      @map("subscription_id") @db.Uuid
  operation      String       @db.VarChar(60)
  entityType     String       @map("entity_type")
  localId        String       @map("local_id") @db.Uuid
  eventId        String?      @map("event_id") @db.Uuid
  eventType      String?      @map("event_type")
  /// คีย์ที่ต้องส่งตามลำดับ: `{sink}:{target}:cus:{customer}` หรือ `{sink}:{target}:{entity}:{id}`
  serializeKey   String       @map("serialize_key")
  /// ส่งให้ปลายทางกันซ้ำ — unique ต่อ tenant
  idempotencyKey String       @map("idempotency_key")
  /// canonical payload ณ เวลาสร้างคำสั่ง — null = ใช้ snapshot ของ domain_event
  payload        Json?
  status         OutboxStatus @default(PENDING)
  attempt        Int          @default(0)
  maxAttempt     Int          @default(7) @map("max_attempt")
  nextRunAt      DateTime     @default(dbgenerated("now()")) @map("next_run_at") @db.Timestamptz(6)
  leaseId        String?      @map("lease_id") @db.Uuid
  leaseUntil     DateTime?    @map("lease_until") @db.Timestamptz(6)
  claimedAt      DateTime?    @map("claimed_at") @db.Timestamptz(6)
  doneAt         DateTime?    @map("done_at") @db.Timestamptz(6)
  /// ST7-T05 เวลาที่เริ่มพักคำสั่ง (tenant ถูกระงับ → AUTH → PENDING) — INT-109 ทิ้งเมื่อพักเกิน 30 วัน
  parkedAt       DateTime?    @map("parked_at") @db.Timestamptz(6)
  errorClass     String?      @map("error_class") @db.VarChar(20)
  lastError      Json?        @map("last_error")
  result         Json?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, idempotencyKey])
  @@index([status, nextRunAt])
  @@index([tenantId, claimedAt])
  @@index([eventId])
  @@index([parkedAt])
  @@map("integration_outbox")
}

/// ST7-T04 สถานะ webhook endpoint (docs/01 §3.7 webhook_endpoint.status; spec/07 §10.6)
enum WebhookEndpointStatus {
  ACTIVE
  /// ผู้ใช้ปิด
  DISABLED
  /// ระบบปิดเอง — event ล้มเหลวขั้นสุดท้ายติดกัน 50 รายการ (docs/04 G1)
  AUTO_DISABLED
}

/// ST7-T04 ผลของการส่ง 1 ครั้ง (docs/01 §3.7 webhook_delivery.status)
enum WebhookDeliveryStatus {
  /// ปลายทางตอบ 2xx
  DELIVERED
  /// ล้มเหลว — จะลองใหม่ตามตาราง (next_retry_at)
  FAILED
  /// ล้มเหลวและไม่ลองใหม่แล้ว (ครบ 1 + 8 ครั้ง หรือ error ที่ไม่ retry: 4xx/redirect/SSRF)
  EXHAUSTED
}

/// ST7-T04 ปลายทาง webhook ของ tenant (docs/01 §3.7; docs/04 G1 Webhook; spec/07 §10)
/// secret เก็บแบบเข้ารหัสถอดได้ (FieldCipher) — ต้องใช้เซ็น HMAC (plan/00a: hash ใช้ไม่ได้) · ไม่มี hard delete (deleted_at)
/// รับ event ผ่าน integration_subscription (sink `webhook`, target = id ของ endpoint) — ไม่มีคิวแยก
model WebhookEndpoint {
  id                  String                @id @default(uuid()) @db.Uuid
  tenantId            String                @map("tenant_id") @db.Uuid
  url                 String                @db.VarChar(2048)
  description         String?               @db.VarChar(200)
  /// ชื่อ event เต็ม (ไม่รับ `*` — spec/07 §10)
  events              String[]
  /// header เพิ่มเติม [{name,value}] เข้ารหัส (อาจมี token ของผู้รับ) — ชื่อ header แยกไว้แสดง
  extraHeadersEnc     String?               @map("extra_headers_enc")
  extraHeaderNames    String[]              @map("extra_header_names")
  /// `whsec_…` เข้ารหัสด้วย FieldCipher
  secretEnc           String                @map("secret_enc")
  /// secret เดิมหลังหมุน — ยังเซ็นคู่จนถึง secret_prev_expires_at (24 ชม.)
  secretPrevEnc       String?               @map("secret_prev_enc")
  secretPrevExpiresAt DateTime?             @map("secret_prev_expires_at") @db.Timestamptz(6)
  secretRotatedAt     DateTime?             @map("secret_rotated_at") @db.Timestamptz(6)
  status              WebhookEndpointStatus @default(ACTIVE)
  /// event ที่ล้มเหลวขั้นสุดท้ายติดกัน (ส่งสำเร็จ = 0; ครบ 50 → AUTO_DISABLED)
  consecutiveFailures Int                   @default(0) @map("consecutive_failures")
  disabledAt          DateTime?             @map("disabled_at") @db.Timestamptz(6)
  disabledReason      String?               @map("disabled_reason")
  disabledBy          String?               @map("disabled_by")
  /// ผู้รับตอบ challenge ของ `webhook.verification` ถูกต้อง
  verifiedAt          DateTime?             @map("verified_at") @db.Timestamptz(6)
  lastDeliveryAt      DateTime?             @map("last_delivery_at") @db.Timestamptz(6)
  lastSuccessAt       DateTime?             @map("last_success_at") @db.Timestamptz(6)
  /// ครั้งล่าสุดที่ส่ง event จริงไม่สำเร็จ (ล้างตอนเปิดใช้อีกครั้ง) — ใหม่กว่า last_success_at = "ล้มเหลวต่อเนื่อง"
  lastFailureAt       DateTime?             @map("last_failure_at") @db.Timestamptz(6)
  subscriptionId      String?               @map("subscription_id") @db.Uuid
  createdBy           String?               @map("created_by")
  version             Int                   @default(1)
  deletedAt           DateTime?             @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  deliveries WebhookDelivery[]

  @@index([tenantId, createdAt, id])
  @@map("webhook_endpoint")
}

/// ST7-T04 บันทึกการส่ง 1 ครั้ง (1 แถว/attempt) — ใช้แสดงประวัติ/ส่งซ้ำใน ST7-T05 · เก็บ 30 วัน (ล้างใน T05)
/// ไม่มี secret: header ที่เก็บตัดค่า header เพิ่มเติมของผู้ใช้ออก · response ตัดที่ 4 KB
model WebhookDelivery {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  endpointId     String                @map("endpoint_id") @db.Uuid
  outboxId       String?               @map("outbox_id") @db.Uuid
  eventId        String?               @map("event_id") @db.Uuid
  /// id ใน envelope (`evt_…`) — ผู้รับใช้กันซ้ำ
  envelopeId     String                @map("envelope_id")
  eventType      String                @map("event_type")
  attempt        Int
  /// event ทดสอบ / verification — ไม่นับอัตราสำเร็จและการปิดอัตโนมัติ
  test           Boolean               @default(false)
  status         WebhookDeliveryStatus
  requestUrl     String                @map("request_url")
  requestHeaders Json                  @map("request_headers")
  requestBody    String                @map("request_body")
  responseStatus Int?                  @map("response_status")
  responseBody   String?               @map("response_body")
  durationMs     Int                   @map("duration_ms")
  /// timeout / network / ssrf_blocked / redirect / http_status / response_too_large / invalid_url
  errorCode      String?               @map("error_code") @db.VarChar(40)
  errorClass     String?               @map("error_class") @db.VarChar(20)
  errorMessage   String?               @map("error_message")
  sentAt         DateTime              @map("sent_at") @db.Timestamptz(3)
  nextRetryAt    DateTime?             @map("next_retry_at") @db.Timestamptz(6)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, endpointId, sentAt])
  @@index([tenantId, eventId])
  @@index([tenantId, sentAt])
  @@index([sentAt])
  @@map("webhook_delivery")
}

/// ST7-T18 ผังรหัส ERP (docs/04 B "ผังรหัส ERP (master code)", docs/01 §7.4) — ค่าที่ connector ยอมรับ ต่อ connector
/// มาจาก adapter (`fetchMasterCodes`) หรือนำเข้า CSV/Excel · ไม่มี hard delete: รหัสที่หายจาก ERP = active false
/// อัตรา VAT (kind VAT_RATE) เป็นข้อมูลอ้างอิงให้ adapter เท่านั้น — ไม่เปลี่ยนการคำนวณภาษีของ TMS
model ErpMasterCode {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  connectorId String    @map("connector_id") @db.Uuid
  connector   Connector @relation(fields: [connectorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// UNIT · SALESPERSON · ACCOUNT · ITEM · VAT_RATE (ERP_MASTER_CODE_KINDS ใน @tms/domain)
  kind        String    @db.VarChar(16)
  /// รหัสตามที่ ERP ใช้ (ตัวพิมพ์ตามต้นทาง — unique ไม่สนตัวพิมพ์)
  code        String    @db.VarChar(64)
  name        String?   @db.VarChar(200)
  /// อัตรา (%) ของ VAT_RATE เป็นสตริงทศนิยม เช่น "7.00" — ข้อมูลอ้างอิงเท่านั้น
  rate        Decimal?  @db.Decimal(5, 2)
  /// ADAPTER · IMPORT
  source      String    @db.VarChar(8)
  active      Boolean   @default(true)
  syncedAt    DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tenantId, connectorId, kind, active])
  @@map("erp_master_code")
}

/// ST7-T18 การจับคู่ "ค่าบริการ/ประเภทรายได้ TMS ↔ รหัสสินค้า ERP" ต่อ connector (docs/04 G3 Sync master ลงมา; ต้นแบบ ตั้งค่า → ระบบบัญชี)
/// 1 แถวต่อ (connector, service_item) · code null = ยกเลิกการจับคู่ (ไม่ลบแถว) · ไม่ครบ → คำสั่ง push ไป ERP FAILED_FINAL(VALIDATION)
model ErpCodeMapping {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  connectorId   String      @map("connector_id") @db.Uuid
  connector     Connector   @relation(fields: [connectorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  serviceItemId String      @map("service_item_id") @db.Uuid
  serviceItem   ServiceItem @relation(fields: [serviceItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// รหัสสินค้า/บริการฝั่ง ERP (kind ITEM)
  itemCode      String?     @map("item_code") @db.VarChar(64)
  updatedBy     String?     @map("updated_by")
  version       Int         @default(1)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([connectorId, serviceItemId])
  @@index([tenantId, connectorId])
  @@map("erp_code_mapping")
}

/// ST8-T05 ชนิด entity ของ external_mapping (docs/01 §3.7)
enum ExternalEntityType {
  CUSTOMER
  CARRIER
  SERVICE_ITEM
  SALES_ORDER
  DELIVERY_ORDER
  INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
  RECEIPT
  SETTLEMENT
  /// ST8-T16 การรับชำระที่สร้างจาก webhook ของระบบบัญชี (กันสร้างซ้ำด้วย external_id = id ใบรับเงินฝั่ง ERP)
  PAYMENT
}

/// ST8-T05 สถานะ mapping (docs/01 §3.7) — แยกจากสถานะเอกสาร (CLAUDE.md "สถานะเอกสารแยกจากสถานะซิงก์")
enum ExternalMappingStatus {
  SYNCED
  PENDING
  FAILED
  MISMATCH
  RETIRED
}

/// ST8-T05 id/รหัสฝั่ง ERP ต่อ entity ต่อ connector (docs/01 §3.7 `external_mapping` — แทน erp_doc_map ของ v1)
/// ST8-T05 ใช้กับ CUSTOMER: `external_id` = รหัสลูกค้าในระบบบัญชี (KRS: รหัส PP → `custOrSuppCode`) ·
///   `source_code` (เพิ่มจาก docs) = รหัสลูกค้าในข้อมูลขาเข้าของ connector (KRS: รหัส NSF ใน SO — ใช้จับคู่ตอนดึง)
///   คน map ครั้งเดียว = ได้ทั้งสองรหัส (adapter `deriveCustomerCode`) · ตารางเดียวกันใช้กับเอกสาร/hash/เลขเอกสารฝั่ง ERP ใน ST7-T15
/// ไม่มี hard delete — ยกเลิก = external_id null / status RETIRED
model ExternalMapping {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  connectorId     String                @map("connector_id") @db.Uuid
  connector       Connector             @relation(fields: [connectorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entityType      ExternalEntityType    @map("entity_type")
  /// id ฝั่ง TMS (uuid ของ entity)
  localId         String                @map("local_id") @db.Uuid
  /// id/รหัสฝั่ง ERP ที่ใช้เป็น key (เช่น transactionNo, custOrSuppCode) — null = ยังไม่ map
  externalId      String?               @map("external_id")
  /// เลขเอกสารที่ ERP ออก (เช่น voucherNo)
  externalDocNo   String?               @map("external_doc_no")
  externalVersion String?               @map("external_version")
  /// ST8-T05 รหัสของ entity นี้ในข้อมูลขาเข้าของ connector (จับคู่ตอนดึง) — null = ไม่มี/ใช้ external_id
  sourceCode      String?               @map("source_code")
  /// ST8-T16 เลขเอกสาร TMS ตอนส่ง (invoice_no / settlement_no / payment_no) — หาเอกสารจากเลขใน webhook
  localNumber     String?               @map("local_number")
  /// ST8-T16 สถานะเอกสารฝั่ง ERP (แยกจาก `status` ของการซิงก์): DRAFT / POSTED / VOIDED / PAID
  externalStatus  String?               @map("external_status")
  /// ST8-T16 รายละเอียดจาก ERP (เลขใบจ่าย / เลข 50 ทวิ / เหตุยกเลิก) — ห้ามมี credential
  detail          Json?
  /// sha256 ของ canonical payload ล่าสุดที่ส่งสำเร็จ (ST7-T15)
  lastSyncedHash  String?               @map("last_synced_hash")
  lastSyncedAt    DateTime?             @map("last_synced_at") @db.Timestamptz(6)
  status          ExternalMappingStatus @default(PENDING)
  lastError       Json?                 @map("last_error")
  createdBy       String?               @map("created_by")
  updatedBy       String?               @map("updated_by")
  version         Int                   @default(1)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([connectorId, entityType, localId])
  @@unique([connectorId, entityType, externalId])
  @@unique([connectorId, entityType, sourceCode])
  @@index([tenantId, entityType, localId])
  @@index([connectorId, entityType, localNumber])
  @@map("external_mapping")
}

// ---------- ST9-T19 Monitoring + alert (ตารางระดับแพลตฟอร์ม — ไม่มี tenant_id; role แอปเข้าไม่ได้ ใช้ผ่าน role platform เท่านั้น) ----------

/// ST9-T19 heartbeat ของ process (worker / api) — เขียนทุก 30 วิ · /readyz + alert `worker_down` อ่านแถวล่าสุด · แถวเก่ากว่า 1 วันล้างรายวัน
model WorkerHeartbeat {
  instanceId String   @id @map("instance_id") @db.VarChar(120) /// `{hostname}:{pid}` — ไม่มีข้อมูลลูกค้า
  kind       String   @db.VarChar(20) /// worker · api
  startedAt  DateTime @map("started_at") @db.Timestamptz(6)
  lastBeatAt DateTime @map("last_beat_at") @db.Timestamptz(6)

  @@index([kind, lastBeatAt])
  @@map("worker_heartbeat")
}

/// ST9-T19 สถานะล่าสุดของแต่ละเงื่อนไขเฝ้าดู (rule + subject) — ใช้ทำ hysteresis (ต้องเกินติดกัน `for` รอบจึงเตือน, ปกติติดกัน `clearAfter` รอบจึงปิด)
model MonitorCheck {
  key          String    @id @db.VarChar(200) /// `{rule}` หรือ `{rule}:{subject}`
  rule         String    @db.VarChar(60)
  subject      String?   @db.VarChar(120) /// sink / connector id (ไม่ใช่ชื่อบริษัท)
  state        String    @default("OK") @db.VarChar(10) /// OK · PENDING · FIRING
  breachCount  Int       @default(0) @map("breach_count")
  okCount      Int       @default(0) @map("ok_count")
  lastValue    Float?    @map("last_value")
  threshold    Float?
  lastEvalAt   DateTime  @map("last_eval_at") @db.Timestamptz(6)
  pendingSince DateTime? @map("pending_since") @db.Timestamptz(6)
  alertId      String?   @map("alert_id") @db.Uuid

  @@index([rule])
  @@map("monitor_check")
}

/// ST9-T19 alert ถึงทีม Innovera — 1 แถวต่อรอบเกิด (OPEN → RESOLVED) · OPEN ได้แถวเดียวต่อ key (partial unique index ใน SQL — กันซ้ำ) · ไม่ลบ
model MonitorAlert {
  id                String    @id @default(uuid()) @db.Uuid
  key               String    @db.VarChar(200)
  rule              String    @db.VarChar(60)
  subject           String?   @db.VarChar(120)
  severity          String    @db.VarChar(10) /// critical · warning
  status            String    @default("OPEN") @db.VarChar(10) /// OPEN · RESOLVED
  threshold         Float
  openValue         Float     @map("open_value")
  lastValue         Float     @map("last_value")
  openedAt          DateTime  @map("opened_at") @db.Timestamptz(6)
  lastSeenAt        DateTime  @map("last_seen_at") @db.Timestamptz(6)
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(6)
  /// เวลาที่ส่ง/เข้าคิวอีเมลแจ้งเกิด · แจ้งปิด (null = ไม่มีผู้รับ/ส่งไม่ได้)
  notifiedAt        DateTime? @map("notified_at") @db.Timestamptz(6)
  resolveNotifiedAt DateTime? @map("resolve_notified_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, openedAt])
  @@index([openedAt])
  @@map("monitor_alert")
}

/// ST9-T19 ผล self-probe ทุก 1 นาที (1 แถว/นาที) — ใช้คำนวณ availability รายเดือน (เป้า 99.5%) · เก็บ 400 วัน
model AvailabilityProbe {
  minute    DateTime @id @db.Timestamptz(6) /// ต้นนาที (UTC)
  ok        Boolean
  status    Int? /// HTTP status ของ /v1/readyz (null = ต่อไม่ได้)
  latencyMs Int?     @map("latency_ms")
  error     String?  @db.VarChar(200)
  source    String   @db.VarChar(20) /// worker · api (ตัวสำรองตอน worker หยุด)

  @@map("availability_probe")
}

/// ST9-T19 จำนวนคำขอ HTTP ต่อนาทีต่อ instance ของ API (รวมทุก route) — alert อัตรา 5xx ข้าม instance · เก็บ 35 วัน
model HttpRequestMinute {
  minute     DateTime @db.Timestamptz(6)
  instanceId String   @map("instance_id") @db.VarChar(120)
  total      Int      @default(0)
  errors     Int      @default(0) /// 5xx

  @@id([minute, instanceId])
  @@map("http_request_minute")
}

/// สถานะวางบิลของ DO (ST5-T05; docs/04 F3 "Flag กันวางบิลซ้ำ") — แยกจาก `do_status` (docs/01 §4.3 UNBILLED/BILLED คงอยู่)
/// UNBILLED → IN_DRAFT (อยู่ในร่างใบแจ้งหนี้) → INVOICED (ใบออกเลขแล้ว) → CREDITED (ใบถูกลดหนี้เต็มใบ/VOIDED — วางบิลใหม่ได้)
/// IN_DRAFT → UNBILLED (ถอดออกจากร่าง/ยกเลิกร่าง) · CREDITED → IN_DRAFT (ดึงเข้าร่างใหม่) — ตาราง transition: @tms/domain `BILLING_TRANSITIONS`
enum BillingStatus {
  UNBILLED
  IN_DRAFT
  INVOICED
  CREDITED

  @@map("billing_status")
}

/// สถานะใบแจ้งหนี้ (docs/01 §4.4) — **ไม่มี SENT/ACCEPTED/MISMATCH** (สถานะซิงก์อยู่ที่ external_mapping — plan/00a §4.4, CLAUDE.md)
enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  ADJUSTED
  VOIDED
  CANCELLED

  @@map("invoice_status")
}

/// ใบแจ้งหนี้ (docs/01 §3.4) — ST5-T05 สร้าง**เฉพาะคอลัมน์ขั้นต่ำ**ที่การกันวางบิลซ้ำต้องใช้ (ร่าง/ออกเลข/PDF/ชำระ เพิ่มใน ST5-T07/T08/T09/T22)
/// ไม่มี hard delete (REVOKE DELETE) · ยกเลิกร่าง = CANCELLED · บรรทัดหยุดนับ (active=false) อัตโนมัติเมื่อใบเป็น CANCELLED/VOIDED (trigger)
model Invoice {
  id                    String          @id @default(uuid()) @db.Uuid
  tenantId              String          @map("tenant_id") @db.Uuid
  /// ออกตอน ISSUED (ST5-T09) — ร่างไม่มีเลข · unique(tenant_id, issuing_branch_id, invoice_no)
  invoiceNo             String?         @map("invoice_no")
  customerId            String          @map("customer_id") @db.Uuid
  customer              Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  issuingCompanyId      String          @map("issuing_company_id") @db.Uuid
  issuingCompany        Company         @relation(fields: [issuingCompanyId], references: [id], onDelete: Restrict)
  issuingBranchId       String          @map("issuing_branch_id") @db.Uuid
  issuingBranch         Branch          @relation(fields: [issuingBranchId], references: [id], onDelete: Restrict)
  status                InvoiceStatus   @default(DRAFT)
  subtotalVatable       Decimal         @default(0) @map("subtotal_vatable") @db.Decimal(14, 2)
  subtotalExempt        Decimal         @default(0) @map("subtotal_exempt") @db.Decimal(14, 2)
  vatAmount             Decimal         @default(0) @map("vat_amount") @db.Decimal(14, 2)
  totalAmount           Decimal         @default(0) @map("total_amount") @db.Decimal(14, 2)
  whtExpectedAmount     Decimal         @default(0) @map("wht_expected_amount") @db.Decimal(14, 2)
  /// ST5-T07 ร่าง (docs/04 F3 "Draft (แก้ได้)", spec/05 §3) — ยอด VAT/WHT เป็นประมาณการ (D-54 · computeDocumentTax)
  subtotalZeroRated     Decimal         @default(0) @map("subtotal_zero_rated") @db.Decimal(14, 2)
  /// Σ ส่วนลดบรรทัดที่ยังใช้ (ยอดบรรทัด `amount` = หลังหักส่วนลดแล้ว)
  discountAmount        Decimal         @default(0) @map("discount_amount") @db.Decimal(14, 2)
  /// ยอดรวม − WHT ที่คาดว่าจะถูกหัก (ประมาณการ)
  netExpectedAmount     Decimal         @default(0) @map("net_expected_amount") @db.Decimal(14, 2)
  periodFrom            DateTime?       @map("period_from") @db.Date
  periodTo              DateTime?       @map("period_to") @db.Date
  creditTermDays        Int             @default(30) @map("credit_term_days")
  customerPoNo          String?         @map("customer_po_no")
  note                  String?
  /// รูปบรรทัดบนเอกสาร: SINGLE (บรรทัดละรายการ) / GROUP (รวมรายการเดียวกัน ราคาเดียวกัน) / MERGE (รวมตามรายการบริการ) — CHECK
  lineMode              String          @default("SINGLE") @map("line_mode")
  updatedBy             String?         @map("updated_by")
  cancelledAt           DateTime?       @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy           String?         @map("cancelled_by")
  cancelReason          String?         @map("cancel_reason")
  createdBy             String?         @map("created_by")
  /// ST5-T09 ออกเอกสาร (D-54 ใบแจ้งหนี้ ไม่ใช่ใบกำกับภาษี) — ข้อมูล ณ วันออก แก้ไม่ได้ (trigger `invoice_issued_guard` migration 0140)
  issuedAt              DateTime?       @map("issued_at") @db.Timestamptz(6)
  issuedBy              String?         @map("issued_by")
  /// วันที่ออก (เวลาไทย) · ครบกำหนด = วันที่ออก + เครดิต (spec/05 BIL-031)
  issueDate             DateTime?       @map("issue_date") @db.Date
  dueDate               DateTime?       @map("due_date") @db.Date
  /// snapshot ลูกค้า/ผู้ออก ณ วันออก (ชื่อ เลขผู้เสียภาษี สาขา ที่อยู่) — PDF ต้นฉบับ/สำเนา render จากค่านี้เท่านั้น (BIL-196)
  customerSnapshot      Json?           @map("customer_snapshot")
  issuerSnapshot        Json?           @map("issuer_snapshot")
  /// ค่าพิมพ์ ณ วันออก: { yearStyle, whtMinimumAmount }
  printOptions          Json?           @map("print_options")
  /// PDF ต้นฉบับที่เก็บ (render หลัง commit — ผูกได้ครั้งเดียว)
  pdfDocumentId         String?         @map("pdf_document_id") @db.Uuid
  pdfDocument           StoredDocument? @relation(fields: [pdfDocumentId], references: [id], onDelete: Restrict)
  /// ST5-T13 ยอดตัดชำระรวม (Σ payment_allocation.amount ของ payment ที่ยังไม่กลับรายการ — รวม WHT ที่ถูกหัก) · CHECK 0 ≤ paid ≤ total
  /// เขียนโดย `applyInvoicePayments` ที่เดียว (ใต้ล็อกใบ) · คงค้าง = total_amount − paid_amount
  paidAmount            Decimal         @default(0) @map("paid_amount") @db.Decimal(14, 2)
  /// ST5-T10 ยกเลิกแล้วออกใหม่ (docs/04 F3 "ฉบับใหม่อ้างเลขเดิม"): ใบนี้ออกแทนใบที่ยกเลิก (CANCELLED มีเลข · ลูกค้าเดียวกัน — trigger 0144)
  replacesInvoiceId     String?         @map("replaces_invoice_id") @db.Uuid
  replaces              Invoice?        @relation("InvoiceReissue", fields: [replacesInvoiceId], references: [id], onDelete: Restrict)
  replacedBy            Invoice[]       @relation("InvoiceReissue")
  /// ST5-T18 เกินกำหนด (ธงที่เก็บ — ไม่ใช่สถานะ: plan/11 #5 · plan/00a "เกินกำหนด = ค่าคำนวณ") — ค้างรับ (ISSUED/PARTIALLY_PAID)
  /// และวันครบกำหนด < วันนี้ (เวลาไทย) · ตั้ง/ล้างโดย `applyInvoicePayments` ที่เดียว (รับชำระ/กลับรายการ + job รายวัน 00:05)
  /// CHECK: มีค่าได้เฉพาะ ISSUED/PARTIALLY_PAID · trigger ล้างเองเมื่อสถานะออกจากค้างรับ
  overdueAt             DateTime?       @map("overdue_at") @db.Timestamptz(6)
  /// ST5-T18 ธง "ส่งลูกค้าแล้ว" (plan/11 #5 `sent_to_customer_at`) — ตั้งเอง (MANUAL) / ออกใบวางบิล (BILLING_NOTE) / อีเมล (EMAIL — ST5-T21)
  /// ส่งแล้วยกเลิกใบไม่ได้ (docs/04 F3 "เฉพาะยังไม่ส่งลูกค้า" — trigger `invoice_cancel_guard`)
  sentToCustomerAt      DateTime?       @map("sent_to_customer_at") @db.Timestamptz(6)
  sentToCustomerBy      String?         @map("sent_to_customer_by")
  sentToCustomerChannel String?         @map("sent_to_customer_channel")
  version               Int             @default(1)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  lines            InvoiceLine[]
  allocations      PaymentAllocation[]
  /// ST5-T11 ใบวางบิลที่ใบนี้เคยอยู่ (ตัวกัน: active ได้ใบเดียว)
  billingNoteLinks BillingNoteInvoice[]

  @@unique([tenantId, issuingBranchId, invoiceNo])
  @@index([tenantId, customerId, status])
  @@index([tenantId, status])
  @@index([tenantId, issueDate])
  @@index([tenantId, replacesInvoiceId])
  @@index([tenantId, overdueAt])
  @@index([tenantId, dueDate])
  @@index([tenantId, updatedAt, id]) /// ST9-T09 ค้นหา ⌘K + รายการเรียงแก้ล่าสุด
  @@map("invoice")
}

/// บรรทัดใบแจ้งหนี้ (docs/01 §3.4) — `vat_type` / `wht_rate` ต่อบรรทัด (snapshot)
/// **กันวางบิลซ้ำ**: unique partial `(tenant_id, delivery_order_id) WHERE delivery_order_id IS NOT NULL AND active` (migration 0123)
/// `active` = บรรทัดยังนับเป็นการวางบิล DO — false เมื่อถอดออกจากร่าง หรือใบเป็น CANCELLED/VOIDED (trigger) · ไม่กลับเป็น true
model InvoiceLine {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  invoiceId           String         @map("invoice_id") @db.Uuid
  invoice             Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  lineNo              Int            @map("line_no")
  /// revenue line ของ DO (1 บรรทัด = 1 DO — docs/01 §7.2) · null = บรรทัดที่ไม่ใช่ค่าขนส่งของ DO
  deliveryOrderId     String?        @map("delivery_order_id") @db.Uuid
  deliveryOrder       DeliveryOrder? @relation(fields: [deliveryOrderId], references: [id], onDelete: Restrict)
  doSurchargeId       String?        @map("do_surcharge_id") @db.Uuid
  doSurcharge         DoSurcharge?   @relation(fields: [doSurchargeId], references: [id], onDelete: Restrict)
  serviceItemId       String         @map("service_item_id") @db.Uuid
  serviceItem         ServiceItem    @relation(fields: [serviceItemId], references: [id], onDelete: Restrict)
  description         String
  quantity            Decimal        @db.Decimal(18, 4)
  unitLabel           String         @map("unit_label")
  unitPrice           Decimal        @map("unit_price") @db.Decimal(14, 2)
  amount              Decimal        @db.Decimal(14, 2)
  vatType             VatType        @map("vat_type")
  vatAmount           Decimal        @default(0) @map("vat_amount") @db.Decimal(14, 2)
  whtRate             Decimal        @map("wht_rate") @db.Decimal(5, 2) /// เปอร์เซ็นต์ (1.00 = 1%)
  accountCode         String?        @map("account_code")
  isUserAdded         Boolean        @default(false) @map("is_user_added")
  active              Boolean        @default(true)
  /// ST5-T07 บรรทัดรายได้ต้นทาง (1 บรรทัด = 1 บรรทัดรายได้ของ DO) — unique partial ต่อบรรทัดที่ active (migration 0135)
  revenueLineId       String?        @map("revenue_line_id") @db.Uuid
  revenueLine         RevenueLine?   @relation(fields: [revenueLineId], references: [id], onDelete: Restrict)
  /// บรรทัดแรกของ DO ในใบ = ตัวกันวางบิลซ้ำต่อ DO (unique partial `(tenant_id, delivery_order_id) WHERE active AND do_anchor`)
  doAnchor            Boolean        @default(true) @map("do_anchor")
  /// ส่วนลดของบรรทัด (≥ 0) — `amount` = ยอดหลังหักส่วนลด · ยอดก่อนส่วนลด = amount + discount
  discount            Decimal        @default(0) @db.Decimal(14, 2)
  /// กลุ่มบรรทัดที่ผู้ใช้รวมเอง (Merge) — null = ตามรูปบรรทัดของใบ (`invoice.line_mode`)
  printGroup          Int?           @map("print_group")
  removedAt           DateTime?      @map("removed_at") @db.Timestamptz(6)
  removedBy           String?        @map("removed_by")
  removeReason        String?        @map("remove_reason")
  /// ST5-T10 บรรทัดของเอกสาร ณ วันยกเลิก — หยุดนับเพราะใบถูกยกเลิก/ลดหนี้เต็มใบ (trigger `invoice_release_lines`) ไม่ใช่ถอดออกจากร่าง
  /// บรรทัดบนเอกสาร = `active OR released_with_invoice` (ใบที่ยกเลิกยังแสดง/พิมพ์รายการเดิมได้)
  releasedWithInvoice Boolean        @default(false) @map("released_with_invoice")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, invoiceId, lineNo])
  @@index([tenantId, revenueLineId])
  @@index([tenantId, deliveryOrderId])
  @@index([tenantId, doSurchargeId])
  @@index([tenantId, serviceItemId])
  @@map("invoice_line")
}

/// ST5-T13 วิธีรับเงิน (ต้นแบบ: โอนเงิน / เช็ค / เงินสด / หักกลบลบหนี้)
enum PaymentMethod {
  TRANSFER
  CHEQUE
  CASH
  OFFSET

  @@map("payment_method")
}

/// ST5-T13 สถานะการรับชำระ — แก้/ลบไม่ได้ แก้ด้วยการกลับรายการ (docs/04 F4 "แก้รับชำระด้วย reversal entry")
enum PaymentStatus {
  RECORDED
  REVERSED

  @@map("payment_status")
}

/// ST5-T13 สถานะเช็ค (spec/05 §4 `chequeStatus`) — BOUNCED (เช็คคืน) = กลับรายการพร้อมกัน
enum ChequeStatus {
  PENDING
  CLEARED
  BOUNCED

  @@map("cheque_status")
}

/// ST5-T13 ที่มาของการรับชำระ — CONNECTOR = ระบบบัญชีแจ้ง (ST7-T21 / ST8-T16)
enum PaymentSource {
  MANUAL
  CONNECTOR

  @@map("payment_source")
}

/// ST5-T13 รับชำระจากลูกค้า (docs/01 §3.4 `payment`, docs/04 F5, spec/05 §4) — **บัญชีเบา D-54/D-57: บันทึกเงิน/เช็คใน TMS ไม่ออกใบเสร็จ (D-56)**
/// ยอด: เงินรับ + WHT ที่ลูกค้าหัก + ค่าธรรมเนียมที่ลูกค้าหัก + ส่วนต่าง = Σ allocation.amount (BIL-051 — ไม่มียอดรับเกิน/เครดิตลูกค้าในเฟสนี้)
/// แก้/ลบไม่ได้ (trigger) — กลับรายการ (REVERSED) พร้อมเหตุผล · เช็คคืน = กลับรายการ + cheque_status BOUNCED
model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  /// เลขภายใน series PAY (ไม่ใช่ใบเสร็จ)
  paymentNo        String        @map("payment_no")
  customerId       String        @map("customer_id") @db.Uuid
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// วันที่รับ (เวลาไทย) ≤ วันนี้
  receivedDate     DateTime      @map("received_date") @db.Date
  method           PaymentMethod
  /// เลขอ้างอิงการโอน / หักกลบ
  reference        String?
  chequeNo         String?       @map("cheque_no")
  chequeBank       String?       @map("cheque_bank")
  chequeDate       DateTime?     @map("cheque_date") @db.Date
  chequeStatus     ChequeStatus? @map("cheque_status")
  /// เงินเข้าจริง
  amountReceived   Decimal       @map("amount_received") @db.Decimal(14, 2)
  /// WHT ที่ลูกค้าหักไว้ (บันทึกยอดอย่างเดียว — รับ/ตรวจ 50 ทวิ ที่ AccountSystem D-54)
  whtAmount        Decimal       @default(0) @map("wht_amount") @db.Decimal(14, 2)
  /// เลขที่หนังสือรับรอง 50 ทวิ ที่ลูกค้าแจ้ง (ข้อความ — ต้นแบบ)
  whtCertificateNo String?       @map("wht_certificate_no")
  /// ค่าธรรมเนียมโอนที่ลูกค้าหัก
  feeAmount        Decimal       @default(0) @map("fee_amount") @db.Decimal(14, 2)
  /// ส่วนต่างที่ยอมตัดยอด (ลูกค้าจ่ายขาด) — ต้องมีเหตุผล
  differenceAmount Decimal       @default(0) @map("difference_amount") @db.Decimal(14, 2)
  differenceReason String?       @map("difference_reason")
  note             String?
  source           PaymentSource @default(MANUAL)
  status           PaymentStatus @default(RECORDED)
  reversedAt       DateTime?     @map("reversed_at") @db.Timestamptz(6)
  reversedBy       String?       @map("reversed_by")
  reverseReason    String?       @map("reverse_reason")
  createdBy        String?       @map("created_by")
  version          Int           @default(1)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  allocations PaymentAllocation[]

  @@unique([tenantId, paymentNo])
  @@index([tenantId, customerId])
  @@index([tenantId, receivedDate])
  @@index([tenantId, updatedAt, id])
  @@map("payment")
}

/// ST5-T13 การตัดชำระต่อใบแจ้งหนี้ (docs/01 §3.4 `payment_allocation`) — `amount` = ยอดตัดหนี้ (รวม WHT) · แก้/ลบไม่ได้
/// Σ ต่อใบ (payment ที่ยังไม่กลับรายการ) ≤ total_amount — ตรวจใต้ล็อกใบ + CHECK invoice.paid_amount
model PaymentAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoiceId String   @map("invoice_id") @db.Uuid
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Decimal  @db.Decimal(14, 2)
  whtAmount Decimal  @default(0) @map("wht_amount") @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([paymentId, invoiceId])
  @@index([tenantId, invoiceId])
  @@map("payment_allocation")
}

/// ใบวางบิล (ST5-T11; docs/01 §3.4 `billing_note`, docs/04 F2) — สรุปใบแจ้งหนี้ค้างของลูกค้าหนึ่งราย **ไม่กระทบ VAT/WHT** (ไม่ใช่เอกสารภาษี)
/// DRAFT → ISSUED (ออกเลข BN + PDF) → COLLECTED (รับเช็ค/โอนแล้ว) · DRAFT/ISSUED → CANCELLED (เหตุผล + audit; เลขคงอยู่)
/// "ผู้รับวางบิล" = `acknowledged_*` (ไม่ใช่สถานะ — plan/00a §4.4) · ไม่มี hard delete (REVOKE DELETE) · หลัง ISSUED เนื้อหาแก้ไม่ได้ (trigger)
enum BillingNoteStatus {
  DRAFT
  ISSUED
  COLLECTED
  CANCELLED

  @@map("billing_note_status")
}

model BillingNote {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  /// ชุดเลข `BN` ออกตอน ISSUED — ร่างไม่มีเลข · unique(tenant_id, billing_note_no)
  billingNoteNo      String?           @map("billing_note_no")
  customerId         String            @map("customer_id") @db.Uuid
  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  issuingCompanyId   String            @map("issuing_company_id") @db.Uuid
  issuingCompany     Company           @relation(fields: [issuingCompanyId], references: [id], onDelete: Restrict)
  issuingBranchId    String            @map("issuing_branch_id") @db.Uuid
  issuingBranch      Branch            @relation(fields: [issuingBranchId], references: [id], onDelete: Restrict)
  status             BillingNoteStatus @default(DRAFT)
  /// วันวางบิล (เวลาไทย) — ออกตอน ISSUED
  billingDate        DateTime?         @map("billing_date") @db.Date
  /// วันนัดรับเช็ค/โอน (≥ วันวางบิล — ตรวจตอนออก)
  collectionDate     DateTime?         @map("collection_date") @db.Date
  /// Σ ยอดรวมของใบแจ้งหนี้ในใบ (ณ วันออก = snapshot ต่อใบใน billing_note_invoice)
  totalAmount        Decimal           @default(0) @map("total_amount") @db.Decimal(14, 2)
  /// Σ WHT ที่คาดว่าจะถูกหัก (ประมาณการ — D-54)
  totalWhtExpected   Decimal           @default(0) @map("total_wht_expected") @db.Decimal(14, 2)
  netExpected        Decimal           @default(0) @map("net_expected") @db.Decimal(14, 2)
  note               String?
  /// ผู้รับวางบิล (ชื่อฝั่งลูกค้า) + วันที่รับ — บันทึกหลังออก
  acknowledgedByName String?           @map("acknowledged_by_name")
  acknowledgedOn     DateTime?         @map("acknowledged_on") @db.Date
  acknowledgedAt     DateTime?         @map("acknowledged_at") @db.Timestamptz(6)
  acknowledgedBy     String?           @map("acknowledged_by")
  collectedAt        DateTime?         @map("collected_at") @db.Timestamptz(6)
  collectedBy        String?           @map("collected_by")
  collectNote        String?           @map("collect_note")
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy        String?           @map("cancelled_by")
  cancelReason       String?           @map("cancel_reason")
  createdBy          String?           @map("created_by")
  updatedBy          String?           @map("updated_by")
  issuedAt           DateTime?         @map("issued_at") @db.Timestamptz(6)
  issuedBy           String?           @map("issued_by")
  /// snapshot ณ วันออก (PDF ต้นฉบับ/สำเนา render จากค่านี้เท่านั้น)
  customerSnapshot   Json?             @map("customer_snapshot")
  issuerSnapshot     Json?             @map("issuer_snapshot")
  printOptions       Json?             @map("print_options")
  pdfDocumentId      String?           @map("pdf_document_id") @db.Uuid
  pdfDocument        StoredDocument?   @relation(fields: [pdfDocumentId], references: [id], onDelete: Restrict)
  version            Int               @default(1)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  invoices BillingNoteInvoice[]

  @@unique([tenantId, billingNoteNo])
  @@index([tenantId, customerId, status])
  @@index([tenantId, status])
  @@index([tenantId, updatedAt, id]) /// ST9-T09 ค้นหา ⌘K + รายการเรียงแก้ล่าสุด
  @@map("billing_note")
}

/// ใบแจ้งหนี้ในใบวางบิล + ยอด ณ วันที่ใส่/ออก (snapshot) — **กัน 1 ใบแจ้งหนี้อยู่ 2 ใบวางบิลที่ active**:
/// unique partial `(tenant_id, invoice_id) WHERE active` · active = ใบวางบิล DRAFT/ISSUED (trigger ตั้ง false เมื่อ COLLECTED/CANCELLED หรือถอดออกจากร่าง)
model BillingNoteInvoice {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  billingNoteId     String      @map("billing_note_id") @db.Uuid
  billingNote       BillingNote @relation(fields: [billingNoteId], references: [id], onDelete: Restrict)
  invoiceId         String      @map("invoice_id") @db.Uuid
  invoice           Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  lineNo            Int         @map("line_no")
  invoiceNo         String      @map("invoice_no")
  issueDate         DateTime    @map("issue_date") @db.Date
  dueDate           DateTime    @map("due_date") @db.Date
  totalAmount       Decimal     @map("total_amount") @db.Decimal(14, 2)
  whtExpectedAmount Decimal     @map("wht_expected_amount") @db.Decimal(14, 2)
  /// ยอดค้าง ณ วันใส่/ออก (ยังไม่มีรับชำระ = ยอดรวม — ST5-T13 จะหักยอดรับแล้ว)
  outstandingAmount Decimal     @map("outstanding_amount") @db.Decimal(14, 2)
  active            Boolean     @default(true)
  removedAt         DateTime?   @map("removed_at") @db.Timestamptz(6)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, billingNoteId])
  @@index([tenantId, invoiceId])
  @@map("billing_note_invoice")
}
