/// ค่าเริ่มต้นภาษาไทยเขียนตอนสร้าง tenant (`ensureDefaultVehicleTypes` — bootstrap ขั้น vehicle-types)
model VehicleType {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  code              String /// 4W / 6W / 10W / TRL / TRC / REF6 / VT-0001 (MD-002) — เก็บตัวใหญ่, unique ไม่สนตัวพิมพ์
  nameTh            String       @map("name_th") /// ชื่อที่ผู้ใช้เห็น — ห้ามซ้ำใน tenant (ไม่สนตัวพิมพ์, ไม่นับที่ลบ)
  vehicleClass      String       @map("vehicle_class") /// ชั้นรถ 4W/6W/10W/TRAILER/SEMI_TRAILER — เทียบกับ customer_site.max_vehicle_class
  capacityKg        Decimal?     @map("capacity_kg") @db.Decimal(10, 2) /// น้ำหนักบรรทุกมาตรฐาน (กก.) — API บังคับ (spec payloadKg)
  capacityCbm       Decimal?     @map("capacity_cbm") @db.Decimal(10, 2) /// ปริมาตร (ลบ.ม.)
  minLicenceClass   String?      @map("min_licence_class") /// PERSONAL/T1/T2/T3/T4 (OPEN-MD-4 / LEG-17 รอตารางกฎหมาย) — API บังคับ
  capabilityTags    String[]     @default([]) @map("capability_tags") /// REFRIGERATED/CRANE/CONTAINER/HAZMAT (docs/04 B capability tags)
  tempMinC          Decimal?     @map("temp_min_c") @db.Decimal(4, 1) /// ห้องเย็น: อุณหภูมิต่ำสุด/สูงสุด (มีเฉพาะเมื่อมีป้าย REFRIGERATED)
  tempMaxC          Decimal?     @map("temp_max_c") @db.Decimal(4, 1)
  systemKey         String?      @map("system_key") /// แถวค่าเริ่มต้นของระบบ (th.4w …) — กัน bootstrap สร้างซ้ำเมื่อผู้ใช้แก้รหัส/ชื่อ/ลบ
  externalId        String?      @map("external_id")
  deletedExternalId String?      @map("deleted_external_id")
  status            ActiveStatus @default(ACTIVE)
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz(6) /// MD-004 soft delete (เฉพาะที่ไม่เคยถูกอ้างอิง)
  version           Int          @default(1)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, code])
  @@unique([tenantId, externalId])
  @@unique([tenantId, systemKey])
  @@index([tenantId, updatedAt, id])
  @@map("vehicle_type")
}

