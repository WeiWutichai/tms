  redeliveryOfId      String?  @map("redelivery_of_id") @db.Uuid /// D-23 ส่งใหม่ = DO ใบใหม่
  customerRef         String?  @map("customer_ref")
  publicTokenHash     String?  @map("public_token_hash") /// tracking link (ST4-T14)
  version             Int      @default(1)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, doNo])
  @@index([tenantId, status])
  @@index([tenantId, tripId])
  @@index([tenantId, updatedAt, id])
  @@map("delivery_order")
}

model DeliveryOrderLine {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  deliveryOrderId    String   @map("delivery_order_id") @db.Uuid
  salesOrderLineId   String?  @map("sales_order_line_id") @db.Uuid
  qtyPlanned         Decimal  @map("qty_planned") @db.Decimal(14, 3)
  qtyActual          Decimal? @map("qty_actual") @db.Decimal(14, 3)
  rejectQty          Decimal? @map("reject_qty") @db.Decimal(14, 3)
  rejectReasonCodeId String?  @map("reject_reason_code_id") @db.Uuid
  unit               String

  @@index([tenantId, deliveryOrderId])
  @@map("delivery_order_line")
}

/// ค่าใช้จ่ายหน้างานที่จะเป็นบรรทัดเพิ่มในใบแจ้งหนี้ (snapshot vat_type/wht_rate)
model DoSurcharge {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  deliveryOrderId String   @map("delivery_order_id") @db.Uuid
  serviceItemId   String   @map("service_item_id") @db.Uuid
  vatType         VatType  @map("vat_type")
  whtRate         Decimal  @map("wht_rate") @db.Decimal(5, 2)
  qty             Decimal  @db.Decimal(14, 3)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(14, 2)
  amount          Decimal  @db.Decimal(14, 2)
  evidenceFileKey String?  @map("evidence_file_key")
  approvedBy      String?  @map("approved_by")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, deliveryOrderId])
  @@map("do_surcharge")
}

model TripCost {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  tripId           String   @map("trip_id") @db.Uuid
  costType         String   @map("cost_type") /// FUEL / TOLL / DRIVER_WAGE / CARRIER_FEE / ALLOWANCE / REPAIR / OTHER
  amount           Decimal  @db.Decimal(14, 2)
  vatAmount        Decimal  @default(0) @map("vat_amount") @db.Decimal(14, 2)
  source           String /// RATE_CARD / MANUAL / GPS / ADVANCE
  carrierId        String?  @map("carrier_id") @db.Uuid
  settlementLineId String?  @unique @map("settlement_line_id") @db.Uuid
  allocated        Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, tripId])
  @@map("trip_cost")
}

// ---------- ST4 Execution (ร่าง) ----------
enum StopEventType {
  ARRIVE
  DEPART
  COMPLETE
  FAIL

  @@map("stop_event_type")
}

/// event ต่อจุดแวะ (append-only; idempotent ด้วย client_event_id) — docs/01 §3.9
model StopEvent {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  tripStopId    String        @map("trip_stop_id") @db.Uuid
  type          StopEventType
  outcome       String?
  reasonCodeId  String?       @map("reason_code_id") @db.Uuid
  clientEventId String        @map("client_event_id") @db.Uuid
  source        String /// APP / WEB / LINK / API
  actor         String?
  lat           Decimal?      @db.Decimal(9, 6)
  lng           Decimal?      @db.Decimal(9, 6)
  accuracyM     Int?          @map("accuracy_m")
  occurredAt    DateTime      @map("occurred_at") @db.Timestamptz(6)
  receivedAt    DateTime      @default(now()) @map("received_at") @db.Timestamptz(6)
  payload       Json?

  @@unique([tenantId, clientEventId])
  @@index([tenantId, tripStopId, occurredAt])
  @@map("stop_event")
}

/// ไฟล์ (POD, PDF, เอกสารรถ) — เนื้อไฟล์อยู่ใน FileStore แบบ immutable (T-09)
model StoredDocument {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  /// ST1-T08: PENDING = จองแล้วรออัปโหลด, READY = ไฟล์ผ่านการตรวจแล้ว
  status           String   @default("READY")
  fileKey          String?  @map("file_key")
  sha256           String?
  mimeType         String   @map("mime_type")
  sizeBytes        Int      @map("size_bytes")
  filename         String?
  clientDocumentId String?  @map("client_document_id") /// กันอัปโหลดซ้ำจากอุปกรณ์ (docs/01 §5.5)
  metadata         Json?
  kind             String /// POD_PHOTO / POD_SIGNATURE / PDF / VEHICLE_DOC / OTHER
  entityType       String?  @map("entity_type")
  entityId         String?  @map("entity_id") @db.Uuid
  createdBy        String?  @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, clientDocumentId])
  @@index([tenantId, entityType, entityId])
  @@map("stored_document")
}

/// ตำแหน่งรถ — schema เตรียมไว้ (T-18) ยังไม่มีตัวป้อนในเฟส 0; เก็บ 90 วัน
model VehiclePosition {
  id         BigInt   @id @default(autoincrement())
  tenantId   String   @map("tenant_id") @db.Uuid
  vehicleId  String   @map("vehicle_id") @db.Uuid
  tripId     String?  @map("trip_id") @db.Uuid
  source     String
  lat        Decimal  @db.Decimal(9, 6)
  lng        Decimal  @db.Decimal(9, 6)
  speedKmh   Decimal? @map("speed_kmh") @db.Decimal(5, 1)
  heading    Int?
  accuracyM  Int?     @map("accuracy_m")
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@index([tenantId, vehicleId, occurredAt])
  @@map("vehicle_position")
}

// ───────────────────────── ST1-T01/T04 Auth (ตาราง platform: ใช้ก่อนรู้ tenant จึงไม่มี RLS และ tms_app เข้าไม่ได้) ─────────────────────────

/// ทุกครั้งที่พยายาม login (สำเร็จ/ล้มเหลว) — ใช้ทั้ง rate limit/ล็อก (A1) และประวัติ login (A2, ST1-T11; เก็บ 1 ปี)
model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  email     String /// lower-case แล้ว
  ip        String
  userAgent String?  @map("user_agent")
  tenantId  String?  @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  success   Boolean
  reason    String? /// invalid_credentials | locked | tenant_selection_required | ok
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([tenantId, createdAt])
  @@map("login_attempt")
}

/// authorization code ของ flow Auth Code + PKCE (T-04) — อายุ 60 วินาที ใช้ครั้งเดียว
model AuthCode {
  id            String    @id @default(uuid()) @db.Uuid
  codeHash      String    @unique @map("code_hash") /// sha256 base64url
  codeChallenge String    @map("code_challenge") /// S256
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("auth_code")
}

/// refresh token (httpOnly cookie) — หมุนทุกครั้งที่ใช้; ใช้ token เก่าซ้ำ = ถูกขโมย → เพิกถอนทั้ง family
model RefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  familyId      String    @map("family_id") @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenVersion  Int       @map("token_version")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6) /// 7 วันนับจาก login (ไม่ต่ออายุตอนหมุน)
  idleExpiresAt DateTime  @map("idle_expires_at") @db.Timestamptz(6) /// idle 8 ชม. (ตั้งได้ใน ST1-T17)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent     String?   @map("user_agent")
  ip            String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_token")
}

/// ขั้นที่ 2 ของ login (ST1-T05) — ผ่านรหัสผ่านแล้ว รอ TOTP / ตั้ง TOTP (ตาราง platform เหมือน auth_code)
model MfaChallenge {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  purpose       String /// verify | enroll
  codeChallenge String    @map("code_challenge") /// PKCE ของ login เดิม
  pendingSecret String?   @map("pending_secret") /// enroll: secret ที่ยังไม่ยืนยัน (เข้ารหัส)
  attempts      Int       @default(0)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("mfa_challenge")
}

/// backup code 10 ชุดต่อผู้ใช้ ใช้ได้ครั้งเดียว (A1) — เก็บ hash เท่านั้น
model BackupCode {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, userId])
  @@map("backup_code")
}

/// จำอุปกรณ์ 30 วัน (A1 Session) — cookie `tms_td` ข้ามขั้น TOTP; เพิกถอนเมื่อ bump tokenVersion
model TrustedDevice {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenVersion Int       @map("token_version")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("trusted_device")
}

/// ค่าตั้งองค์กร (ST1-T17) — key ต้องลงทะเบียนใน src/modules/settings/registry.ts (มี type + default); ไม่มีแถว = ใช้ default
model TenantSetting {
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  value     Json
  version   Int      @default(1)
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, key])
  @@map("tenant_setting")
}

/// รหัสผ่านเดิม (ST1-T02: ห้ามซ้ำ 5 ครั้งล่าสุด) — เก็บ hash argon2id เท่านั้น; ใช้ผ่าน role platform
model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, userId, createdAt])
  @@map("password_history")
}

/// แพ็กเกจ (ST1-T18; spec/01 §6) — ข้อมูลตัวอย่างจาก design/prototype/plans.js (ราคา/โควตายังไม่สรุป)
model Plan {
  code         String            @id
  nameTh       String            @map("name_th")
  nameEn       String?           @map("name_en")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  tenants      Tenant[]
  entitlements PlanEntitlement[]

  @@map("plan")
}

/// เซลล์ใน feature matrix: แพ็กเกจ × ฟีเจอร์ → mode included / addon / not_available + limit (null = ไม่จำกัด)
model PlanEntitlement {
  planCode   String @map("plan_code")
  featureKey String @map("feature_key")
  mode       String /// included | addon | not_available (CHECK — migration 0017)
  limit      Int?
  plan       Plan   @relation(fields: [planCode], references: [code], onUpdate: Cascade, onDelete: Cascade)

  @@id([planCode, featureKey])
  @@map("plan_entitlement")
}

/// override ต่อ tenant (spec/01 PLT-062): grant / revoke / set_limit + เหตุผล + วันหมดอายุ — แก้จาก Platform Console เท่านั้น
model TenantEntitlementOverride {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  featureKey String    @map("feature_key")
  mode       String
  limit      Int?
  reason     String
  approvedBy String?   @map("approved_by")
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, featureKey])
  @@map("tenant_entitlement_override")
}

/// ลิงก์เข้าถึงโดยไม่ login (ST1-T06; docs/04 A1/J) — token เซ็น HMAC + หมดอายุ; action ที่ทำได้และการเพิกถอนอยู่ที่แถวนี้
model MagicLink {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  /// trip_offer / pod / settlement_view / tracking
  purpose       String
  entityType    String    @map("entity_type")
  entityId      String    @map("entity_id") @db.Uuid
  actions       String[]
  /// scope ที่ลิงก์ได้ (เช่น รถร่วมเห็นราคาซื้อของตัวเอง `prices.buy:read`) — ราคาขายไม่มีทางได้ (principal `link`)
  scopes        String[]
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason")
  createdBy     String?   @map("created_by")
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, entityType, entityId])
  @@map("magic_link")
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// อีเมลขาออก (ST1-T03; docs/04 A1) — เขียนใน transaction ของงาน แล้ว worker ส่งผ่าน EmailTransport
/// เนื้อหา (มีลิงก์/token) ถูกลบทันทีที่ส่งสำเร็จหรือเลิกส่ง — เก็บแค่หัวเรื่อง/ผู้รับ/สถานะไว้ตรวจย้อน
model EmailOutbox {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String?     @map("tenant_id") @db.Uuid /// null = อีเมลระบบที่ยังไม่รู้บริษัท (ลืมรหัสผ่าน)
  toAddress         String      @map("to_address")
  template          String
  locale            String
  subject           String
  textBody          String?     @map("text_body")
  htmlBody          String?     @map("html_body")
  status            EmailStatus @default(PENDING)
  attempts          Int         @default(0)
  maxAttempts       Int         @default(5) @map("max_attempts")
  runAt             DateTime    @default(dbgenerated("now()")) @map("run_at") @db.Timestamptz(6) /// นาฬิกาฐานข้อมูล — claim เทียบกับ now() (เหมือน job)
  lockedUntil       DateTime?   @map("locked_until") @db.Timestamptz(6)
  sentAt            DateTime?   @map("sent_at") @db.Timestamptz(6)
  providerMessageId String?     @map("provider_message_id")
  error             String?
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, runAt])
  @@index([tenantId, createdAt])
  @@map("email_outbox")
}

/// token ลืมรหัสผ่าน (ST1-T03; PLT-032) — อายุ 30 นาที ใช้ครั้งเดียว · ผูกกับอีเมล (ตัวตนเดียวข้ามบริษัท) · เก็บแค่ hash
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  email     String /// lower-case แล้ว
  ip        String?
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("password_reset_token")
}

/// คำเชิญผู้ใช้ (ST1-T07; docs/04 A2; spec/01 §3) — ลิงก์อีเมล 7 วัน ใช้ครั้งเดียว · ผูกกับแถว app_user สถานะ INVITED (role ตั้งตอนเชิญ)
/// ส่งใหม่ = เพิกถอนแถวเดิม + ออกแถวใหม่ · เก็บแค่ hash ของ token
model UserInvitation {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  email         String /// lower-case แล้ว
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  invitedBy     String?   @map("invited_by") @db.Uuid
  acceptedAt    DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user          AppUser   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId, userId])
  @@map("user_invitation")
}

/// ช่องทางแจ้งเตือน (ST1-T23; docs/04 I, spec/10 Notification) — push/line/sms เสียบภายหลัง (ST3-T21, เฟส 2)
enum NotificationStatus {
  QUEUED
  SENT
  READ
  FAILED
}

/// แจ้งเตือน 1 แถว = ผู้รับ 1 คน × ช่องทาง 1 ช่อง (ST1-T23) — เนื้อหา render ตอนสร้างตามภาษาของผู้รับ
model Notification {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  recipientId       String             @map("recipient_id") @db.Uuid /// app_user.id
  channel           String /// in_app · email (· push · line · sms ภายหลัง)
  templateCode      String             @map("template_code")
  locale            String
  title             String
  body              String
  link              String? /// path ภายในเว็บ เช่น /settings/users
  payload           Json               @default("{}")
  status            NotificationStatus @default(QUEUED)
  emailOutboxId     String?            @map("email_outbox_id") @db.Uuid
  sentAt            DateTime?          @map("sent_at") @db.Timestamptz(6)
  readAt            DateTime?          @map("read_at") @db.Timestamptz(6)
  failedReason      String?            @map("failed_reason")
  relatedEntityType String?            @map("related_entity_type")
  relatedEntityId   String?            @map("related_entity_id")
  createdAt         DateTime           @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(3) /// ms — ตรงกับ cursor (JS Date) ไม่ข้ามแถวที่ต่างกันระดับ µs
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, recipientId, channel, createdAt])
  @@index([emailOutboxId])
  @@map("notification")
}

/// งานนำเข้า Excel/CSV (ST1-T19; spec/02 §11.6)
enum ImportStatus {
  VALIDATING
  VALIDATED
  IMPORTING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

/// งานนำเข้า 1 ไฟล์ (ST1-T19; docs/04 A5, spec/02 §11) — ไฟล์อยู่ใน stored_document (kind IMPORT)
/// ขั้นตรวจ (dry-run) ไม่เขียนข้อมูลจริง; ยืนยันแล้วตรวจซ้ำก่อนเขียน
model ImportJob {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  kind         String /// entity ที่นำเข้า (ImportSpec.kind)
  documentId   String       @map("document_id") @db.Uuid
  fileName     String?      @map("file_name")
  status       ImportStatus @default(VALIDATING)
  mode         String       @default("create_only") /// create_only · upsert_by_code · update_only
  errorPolicy  String       @default("all_or_nothing") @map("error_policy") /// all_or_nothing · skip_invalid_rows
  headers      Json         @default("[]") /// หัวคอลัมน์ในไฟล์
  mapping      Json         @default("{}") /// field key → หัวคอลัมน์ในไฟล์
  totalRows    Int          @default(0) @map("total_rows")
  okRows       Int          @default(0) @map("ok_rows")
  errorRows    Int          @default(0) @map("error_rows")
  importedRows Int          @default(0) @map("imported_rows")
  /// ผลตรวจรายแถว [{row, column, value, code, message}] (เฉพาะแถวผิด/เตือน; สูงสุด 5,000 รายการ)
  issues       Json         @default("[]")
  /// 3 แถวแรก (ค่าตามฟิลด์) ไว้แสดงตัวอย่างในขั้นจับคู่คอลัมน์
  sample       Json         @default("[]")
  fileError    String?      @map("file_error") /// ผิดทั้งไฟล์ (เช่น เกิน 5,000 แถว, ไม่มีหัวคอลัมน์)
  jobId        String?      @map("job_id") @db.Uuid
  expiresAt    DateTime     @map("expires_at") @db.Timestamptz(6) /// ผลตรวจหมดอายุ 24 ชม.
  createdBy    String?      @map("created_by")
  createdAt    DateTime     @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(3) /// ms — ตรงกับ cursor
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@map("import_job")
}

/// สถานะ setup checklist ต่อ tenant (ST1-T21; spec/01 §4) — ขั้นต่าง ๆ คำนวณจากข้อมูลจริง (PLT-040)
/// เก็บเฉพาะสิ่งที่คำนวณไม่ได้: ข้ามขั้นเชื่อมระบบบัญชี, ครบแล้ว (การ์ดหายถาวร — PLT-041), ผู้ใช้ที่กดซ่อน
model SetupChecklistState {
  tenantId           String    @id @map("tenant_id") @db.Uuid
  connectorSkippedAt DateTime? @map("connector_skipped_at") @db.Timestamptz(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)
  hiddenFor          String[]  @default([]) @map("hidden_for") @db.Uuid
  /// ขั้นที่ผู้ใช้ยืนยันค่าเริ่มต้นแล้ว (org / tax / numbering) — กดบันทึกโดยไม่เปลี่ยนค่า หรือเปิดหน้าเลขเอกสาร
  reviewedSteps      String[]  @default([]) @map("reviewed_steps")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("setup_checklist_state")
}

/// ทีม Innovera (ST1-T24; docs/04 A6) — แยกจากผู้ใช้ของลูกค้า ไม่มี tenant_id; role แอปเข้าไม่ได้ (platform เท่านั้น)
enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
  BILLING
}

model PlatformUser {
  id             String                 @id @default(uuid()) @db.Uuid
  email          String                 @unique
  name           String
  role           PlatformRole
  passwordHash   String                 @map("password_hash")
  /// TOTP (เข้ารหัสด้วย FieldCipher) — บังคับทุกคน ตั้งตอนสร้างบัญชี
  totpSecret     String                 @map("totp_secret")
  totpLastStep   BigInt?                @map("totp_last_step")
  status         String                 @default("ACTIVE") /// ACTIVE · DISABLED
  tokenVersion   Int                    @default(0) @map("token_version")
  failedLogins   Int                    @default(0) @map("failed_logins")
  lockedUntil    DateTime?              @map("locked_until") @db.Timestamptz(6)
  lastLoginAt    DateTime?              @map("last_login_at") @db.Timestamptz(6)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  impersonations ImpersonationSession[]

  @@map("platform_user")
}

/// เข้าใช้งานแทน (ST1-T24; spec/01 §11.1) — เฟส 0 อ่านอย่างเดียวเสมอ, หมดอายุ 60 นาที
model ImpersonationSession {
  id             String       @id @default(uuid()) @db.Uuid
  platformUserId String       @map("platform_user_id") @db.Uuid
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id])
  tenantId       String       @map("tenant_id") @db.Uuid
  asUserId       String       @map("as_user_id") @db.Uuid
  mode           String       @default("read_only")
  reason         String
  ticketRef      String?      @map("ticket_ref")
  startedAt      DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  endedAt        DateTime?    @map("ended_at") @db.Timestamptz(6)
  endReason      String?      @map("end_reason") /// manual · timeout · revoked
  ip             String?
  userAgent      String?      @map("user_agent")

  @@index([tenantId, startedAt])
  @@map("impersonation_session")
}
