  tripNo               String?           @map("trip_no")
  tripDate             DateTime          @map("trip_date") @db.Date
  vehicleId            String?           @map("vehicle_id") @db.Uuid
  vehiclePlateSnapshot String?           @map("vehicle_plate_snapshot")
  vehicleTypeSnapshot  String?           @map("vehicle_type_snapshot")
  driverId             String?           @map("driver_id") @db.Uuid
  driverNameSnapshot   String?           @map("driver_name_snapshot")
  driverPhoneSnapshot  String?           @map("driver_phone_snapshot")
  driverAcceptedAt     DateTime?         @map("driver_accepted_at") @db.Timestamptz(6) /// D-24 "คนขับรับงาน" เป็นธง (★ รอยืนยัน)
  carrierId            String?           @map("carrier_id") @db.Uuid
  carrierNameSnapshot  String?           @map("carrier_name_snapshot")
  buyRateSnapshot      Json?             @map("buy_rate_snapshot")
