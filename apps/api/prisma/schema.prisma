// ---------- ST4 Execution (ร่าง) ----------
enum StopEventType {
  ARRIVE
  DEPART
  COMPLETE
  FAIL

  @@map("stop_event_type")
}

/// event ต่อจุดแวะ (append-only; idempotent ด้วย client_event_id) — docs/01 §3.9
model StopEvent {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  tripStopId    String        @map("trip_stop_id") @db.Uuid
  type          StopEventType
  outcome       String?
  reasonCodeId  String?       @map("reason_code_id") @db.Uuid
  clientEventId String        @map("client_event_id") @db.Uuid
  source        String /// APP / WEB / LINK / API
  actor         String?
  lat           Decimal?      @db.Decimal(9, 6)
  lng           Decimal?      @db.Decimal(9, 6)
  accuracyM     Int?          @map("accuracy_m")
  occurredAt    DateTime      @map("occurred_at") @db.Timestamptz(6)
  receivedAt    DateTime      @default(now()) @map("received_at") @db.Timestamptz(6)
  payload       Json?

  @@unique([tenantId, clientEventId])
  @@index([tenantId, tripStopId, occurredAt])
  @@map("stop_event")
}

/// ไฟล์ (POD, PDF, เอกสารรถ) — เนื้อไฟล์อยู่ใน FileStore แบบ immutable (T-09)
model StoredDocument {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  fileKey    String   @map("file_key")
  sha256     String
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  kind       String /// POD_PHOTO / POD_SIGNATURE / PDF / VEHICLE_DOC / OTHER
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, entityType, entityId])
  @@map("stored_document")
}

/// ตำแหน่งรถ — schema เตรียมไว้ (T-18) ยังไม่มีตัวป้อนในเฟส 0; เก็บ 90 วัน
model VehiclePosition {
  id         BigInt   @id @default(autoincrement())
  tenantId   String   @map("tenant_id") @db.Uuid
  vehicleId  String   @map("vehicle_id") @db.Uuid
  tripId     String?  @map("trip_id") @db.Uuid
  source     String
  lat        Decimal  @db.Decimal(9, 6)
  lng        Decimal  @db.Decimal(9, 6)
  speedKmh   Decimal? @map("speed_kmh") @db.Decimal(5, 1)
  heading    Int?
  accuracyM  Int?     @map("accuracy_m")
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@index([tenantId, vehicleId, occurredAt])
  @@map("vehicle_position")
}

// ───────────────────────── ST1-T01/T04 Auth (ตาราง platform: ใช้ก่อนรู้ tenant จึงไม่มี RLS และ tms_app เข้าไม่ได้) ─────────────────────────

/// ทุกครั้งที่พยายาม login (สำเร็จ/ล้มเหลว) — ใช้ทั้ง rate limit/ล็อก (A1) และประวัติ login (A2, ST1-T11; เก็บ 1 ปี)
model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  email     String /// lower-case แล้ว
  ip        String
  userAgent String?  @map("user_agent")
  tenantId  String?  @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  success   Boolean
  reason    String? /// invalid_credentials | locked | tenant_selection_required | ok
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([tenantId, createdAt])
  @@map("login_attempt")
}

/// authorization code ของ flow Auth Code + PKCE (T-04) — อายุ 60 วินาที ใช้ครั้งเดียว
model AuthCode {
  id            String    @id @default(uuid()) @db.Uuid
  codeHash      String    @unique @map("code_hash") /// sha256 base64url
  codeChallenge String    @map("code_challenge") /// S256
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("auth_code")
}

/// refresh token (httpOnly cookie) — หมุนทุกครั้งที่ใช้; ใช้ token เก่าซ้ำ = ถูกขโมย → เพิกถอนทั้ง family
model RefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  familyId      String    @map("family_id") @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenVersion  Int       @map("token_version")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6) /// 7 วันนับจาก login (ไม่ต่ออายุตอนหมุน)
  idleExpiresAt DateTime  @map("idle_expires_at") @db.Timestamptz(6) /// idle 8 ชม. (ตั้งได้ใน ST1-T17)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent     String?   @map("user_agent")
  ip            String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_token")
}

/// ขั้นที่ 2 ของ login (ST1-T05) — ผ่านรหัสผ่านแล้ว รอ TOTP / ตั้ง TOTP (ตาราง platform เหมือน auth_code)
model MfaChallenge {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  purpose       String /// verify | enroll
  codeChallenge String    @map("code_challenge") /// PKCE ของ login เดิม
  pendingSecret String?   @map("pending_secret") /// enroll: secret ที่ยังไม่ยืนยัน (เข้ารหัส)
  attempts      Int       @default(0)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("mfa_challenge")
}

/// backup code 10 ชุดต่อผู้ใช้ ใช้ได้ครั้งเดียว (A1) — เก็บ hash เท่านั้น
model BackupCode {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, userId])
  @@map("backup_code")
}

/// จำอุปกรณ์ 30 วัน (A1 Session) — cookie `tms_td` ข้ามขั้น TOTP; เพิกถอนเมื่อ bump tokenVersion
model TrustedDevice {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenVersion Int       @map("token_version")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("trusted_device")
}

/// ค่าตั้งองค์กร (ST1-T17) — key ต้องลงทะเบียนใน src/modules/settings/registry.ts (มี type + default); ไม่มีแถว = ใช้ default
model TenantSetting {
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  value     Json
  version   Int      @default(1)
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, key])
  @@map("tenant_setting")
}
