{
  "name": "@tms/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "NODE_ENV=development SWC_NODE_PROJECT=tsconfig.json node --watch -r @swc-node/register src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" && node scripts/lint-dto.mjs",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force --skip-seed",
    "db:seed": "NODE_ENV=${NODE_ENV:-development} SWC_NODE_PROJECT=tsconfig.json node -r @swc-node/register prisma/seed.ts",
    "openapi:export": "SWC_NODE_PROJECT=tsconfig.json node -r @swc-node/register scripts/export-openapi.ts",
    "openapi:diff": "SWC_NODE_PROJECT=tsconfig.json node -r @swc-node/register scripts/openapi-diff.ts",
    "dev:worker": "NODE_ENV=development SWC_NODE_PROJECT=tsconfig.json node -r @swc-node/register src/worker.ts",
    "openapi:check": "SWC_NODE_PROJECT=tsconfig.json node -r @swc-node/register scripts/export-openapi.ts && git diff --exit-code -- ../../packages/contracts/openapi.json"
  },
  "dependencies": {
    "@fontsource/sarabun": "^5.3.0",
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/swagger": "^11.4.8",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "@tms/domain": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "nodemailer": "^10.5.0",
    "pino": "^9.5.0",
    "playwright-core": "^1.65.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.9.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pngjs": "^6.0.5",
    "@types/supertest": "^6.0.2",
    "ajv": "^8.20.0",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.12"
  }
}
