# ST0-T03 — infra/deploy/<profile>.env (staging.env / production.env) · ไม่ commit · สิทธิ์ไฟล์ 600
# ส่งเข้า container api + worker ทั้งไฟล์ · URL ฐานข้อมูล/FILES_ROOT/OAUTH_SIGNING_KEYS_DIR/API_PORT ตั้งให้แล้วใน compose (ไม่ต้องใส่)
# ความหมายของแต่ละค่า: .env.example ที่ราก repo · checklist G-14 ใน docs/ops/st9-t23-go-live-runbook.md
# ช่องว่าง = ต้องกรอก (scripts/deploy/check-env.sh ตรวจก่อน deploy)

# --- ทั่วไป ---
# production | staging  (ห้าม development/test — กุญแจ/ผู้ให้บริการจำลองจะถูกปฏิเสธ หรือแย่กว่าคือใช้ได้)
NODE_ENV=production
LOG_LEVEL=info
# reverse proxy (Caddy) 1 ชั้น → 1 · หลัง LB ของ cloud อีกชั้น → 2 (หรือ CIDR ของ LB) [รอ cloud decision]
TRUST_PROXY=1
PUBLIC_WEB_BASE_URL=https://app.example.com
PUBLIC_API_BASE_URL=https://app.example.com

# --- กุญแจ/ความลับ (สุ่มด้วย scripts/deploy/gen-secrets.sh — ย้ายเข้า secret manager ของ cloud ภายหลัง [รอ cloud decision]) ---
# เซ็น access token HS256 ≥ 32 ตัว
AUTH_JWT_SECRET=
# key ring เข้ารหัสฟิลด์ keyId:base64(32 byte) คั่นด้วย , ตัวแรก = ใช้เข้ารหัส · ห้ามหาย (ข้อมูลที่เข้ารหัสอ่านไม่ได้อีก) · ห้ามใช้ค่าใน .env.example
FIELD_ENCRYPTION_KEYS=
# base64(32 byte) · ห้ามเปลี่ยนหลังมีข้อมูล (ค้นหาฟิลด์เข้ารหัสไม่เจอ)
BLIND_INDEX_KEY=
# pepper ของ API key ≥ 32 ตัว · ตั้งครั้งเดียว ห้ามหมุน (key ทุกตัวใช้ไม่ได้)
API_KEY_PEPPER=
# ลายเซ็น URL ไฟล์ / magic link ≥ 32 ตัว (ไม่ตั้ง = แยก label จาก AUTH_JWT_SECRET — ตั้งแยกดีกว่า)
DOCUMENT_URL_SECRET=
MAGIC_LINK_SECRET=
# /v1/metrics ต้องส่ง Bearer นี้ (≥ 24 ตัว) — Prometheus ในเครือข่ายภายในเท่านั้น (proxy ปิด /v1/metrics จากภายนอก)
METRICS_TOKEN=

# --- อีเมล (D-32 ยังไม่เลือกผู้ให้บริการ) [รอ cloud decision] ---
EMAIL_TRANSPORT=smtp
EMAIL_SMTP_URL=
EMAIL_FROM=TMS <no-reply@example.com>

# --- monitoring (ST9-T19) ---
MONITOR=on
# ผู้รับ alert (คั่นด้วย ,) — ไม่ตั้ง = ทีม Platform Console SUPER_ADMIN/SUPPORT
# MONITOR_ALERT_EMAILS=

# --- ผู้ให้บริการภายนอก: ค่าเริ่มนอก dev = ปิด (ไม่ส่งข้อมูลออก) จนกว่า ST0-T01 ตัดสิน ---
GEO_PROVIDER=none
# LINE_PROVIDER=line
# SMS_PROVIDER=http
# SMS_HTTP_URL=
# SMS_HTTP_TOKEN=
# ST1-T02 ตรวจรหัสผ่านรั่วกับ HIBP — นอก dev เปิดเสมอถ้าไม่ตั้ง (ส่ง prefix hash 5 ตัวออกไปที่ api.pwnedpasswords.com)
# HIBP_ENABLED=false

# --- staging เท่านั้น (production ห้ามตั้ง — checklist G-14) ---
# ERP_DEMO_ADAPTERS=1

# --- ห้ามตั้งนอก dev/test (ตรวจโดย check-env.sh) ---
# AUTH_DEV_SECRET · WEBHOOK_ALLOW_PRIVATE_TARGETS · TRIP_COSTING_ENABLED=0
