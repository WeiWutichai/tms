# ST0-T03 — infra/deploy/<profile>.db.env (staging.db.env / production.db.env) · ไม่ commit · สิทธิ์ไฟล์ 600
# ใช้แทนค่าใน docker-compose.prod.yml + container postgres/backup/migrate — **ไม่ถูกส่งเข้า api/worker ทั้งไฟล์**
# สร้างค่า: scripts/deploy/gen-secrets.sh <profile> (สุ่มด้วย openssl ในเครื่อง ไม่ส่งออกนอกเครื่อง)
# รหัสผ่านต้องเป็น hex/ตัวอักษร-ตัวเลขล้วน (ถูกใส่ใน URL ของฐานโดยตรง)

# --- ฐานข้อมูล (ST0-T03) ---
POSTGRES_USER=tms
POSTGRES_DB=tms
# owner = เจ้าของตาราง ใช้รัน migration เท่านั้น
POSTGRES_PASSWORD=
# role แอป (ไม่มี BYPASSRLS) · role platform (BYPASSRLS) · role backup (REPLICATION)
POSTGRES_APP_PASSWORD=
POSTGRES_PLATFORM_PASSWORD=
POSTGRES_BACKUP_PASSWORD=

# --- image / เครือข่าย ---
# registry ของ image (ไม่ตั้ง = image ที่ build ในเครื่องชื่อ tms/api, tms/web, tms/migrate) [รอ cloud decision: registry ของ cloud]
# TMS_IMAGE_REPO=registry.example.com/innovera/tms
# โดเมนจริง = Caddy ขอใบรับรอง TLS อัตโนมัติ (ต้องเปิดพอร์ต 80/443) · ":80" = HTTP ล้วน (หลัง LB ที่ทำ TLS / ซ้อมในเครื่อง)
TMS_DOMAIN=
ACME_EMAIL=
# HTTP_BIND=0.0.0.0
# HTTP_PORT=80
# HTTPS_PORT=443
# โฟลเดอร์บน host ที่มีกุญแจ OAuth (<kid>.pem, RSA ≥ 2048) — mount read-only เข้า api/worker ที่ /app/keys
OAUTH_KEYS_HOST_DIR=

# --- backup (ST9-T18) ---
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30
# สำเนาไฟล์ใหม่ (POD/ไฟล์แนบ) ระหว่างรอบ snapshot — RPO ของไฟล์
FILES_SYNC_MINUTES=15
# คำสั่งคัดลอก /backup ออกนอกเครื่องหลังทุกรอบ (รันใน container backup) [รอ cloud decision]
# BACKUP_OFFSITE_CMD=
