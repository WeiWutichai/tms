{
  "name": "tms",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:api": "pnpm --filter @tms/api dev",
    "dev:web": "pnpm --filter @tms/web dev",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "format": "prettier --write .",
    "e2e": "pnpm --filter @tms/web e2e",
    "ci:local": "bash scripts/ci-local.sh"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "@nestjs/core"
    ],
    "overrides": {
      "deepmerge-ts": "^8.0.0"
    }
  }
}
