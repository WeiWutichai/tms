          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "companies"
        ]
      },
      "get": {
        "operationId": "Companies_list",
        "parameters": [
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 200,
              "default": 50,
              "type": "number"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "ค่า nextCursor จากหน้าก่อน",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "updatedAfter",
            "required": false,
            "in": "query",
            "description": "คืนเฉพาะแถวที่ updatedAt > ค่านี้ (incremental pull)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "schema": {
              "default": "updatedAt",
              "type": "string",
              "enum": [
                "updatedAt",
                "-updatedAt"
              ]
            }
          },
          {
            "name": "fields",
            "required": false,
            "in": "query",
            "description": "รายชื่อ field คั่นด้วย , เช่น id,legalName",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "คั่นด้วย , เช่น active,inactive",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyPageDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "companies"
        ]
      }
    },
