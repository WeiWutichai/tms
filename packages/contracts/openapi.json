  "info": {
    "title": "TMS API",
    "description": "Open API ชุดเดียวกับที่ UI ใช้ (docs/01 §5) — error เป็น application/problem+json",
    "version": "v1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "MeTenantDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "ten_…"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "trial",
              "active",
              "suspended",
              "cancelled"
            ]
          },
          "yearStyle": {
            "type": "string",
            "enum": [
              "BE",
              "CE"
            ],
            "description": "ปีบนเอกสาร: BE = พ.ศ., CE = ค.ศ."
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "yearStyle"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "actorId": {
            "type": "string",
            "description": "ผู้ใช้หรือ API key ที่เรียก (sub)"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tenant": {
            "$ref": "#/components/schemas/MeTenantDto"
          }
        },
        "required": [
          "actorId",
          "scopes",
          "tenant"
        ]
      },
      "CreateCompanyDto": {
        "type": "object",
        "properties": {
          "legalName": {
            "type": "string",
            "example": "บริษัท ศรีไทยขนส่ง จำกัด",
            "description": "ชื่อตามจดทะเบียน (พิมพ์บนใบกำกับภาษี)"
          },
          "legalNameEn": {
            "type": "string",
            "example": "Srithai Transport Co., Ltd."
          },
          "taxId": {
            "type": "string",
            "example": "0105536000014",
            "description": "เลขประจำตัวผู้เสียภาษี 13 หลัก"
          },
          "vatRegistered": {
            "type": "boolean",
            "default": true
          },
          "externalId": {
            "type": "string",
            "description": "รหัสฝั่งระบบภายนอก (ERP) — เรียกด้วย ext:{externalId} ได้"
          }
        },
        "required": [
          "legalName",
          "taxId"
        ]
      },
      "CompanyDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "cmp_3f2a…"
          },
          "legalName": {
            "type": "string"
          },
          "legalNameEn": {
            "type": "string",
            "nullable": true
          },
          "taxId": {
            "type": "string"
          },
          "vatRegistered": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ]
          },
          "externalId": {
            "type": "string",
            "nullable": true
          },
          "version": {
            "type": "number"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "legalName",
          "legalNameEn",
          "taxId",
          "vatRegistered",
          "status",
          "externalId",
          "version",
          "createdAt",
          "updatedAt"
        ]
      },
      "CompanyPageDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompanyDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "required": [
          "data",
          "nextCursor",
          "hasMore"
        ]
      },
      "UpdateCompanyDto": {
        "type": "object",
        "properties": {
          "legalName": {
            "type": "string"
          },
          "legalNameEn": {
            "type": "string"
          },
          "vatRegistered": {
            "type": "boolean"
          }
        }
      },
      "StatusChangeDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "เหตุผล (บังคับทุกการเปลี่ยนสถานะ — ลง audit)",
            "example": "ปิดบริษัทในเครือ"
          }
        },
        "required": [
          "reason"
        ]
      },
      "JobDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "job_…"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "succeeded",
              "failed"
            ]
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "result": {
            "type": "object",
            "nullable": true
          },
          "error": {
            "type": "object",
            "nullable": true
          },
          "attempts": {
            "type": "number"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "type",
          "status",
          "progress",
          "result",
          "error",
          "attempts",
          "createdAt",
          "finishedAt"
        ]
      }
    }
  }
}
