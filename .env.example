# คัดลอกเป็น .env (ไม่ commit) — ค่าเหล่านี้ใช้กับ docker compose ใน dev เท่านั้น
DATABASE_URL=postgresql://tms:tms@localhost:54329/tms?schema=public
APP_DATABASE_URL=postgresql://tms_app:tms_app@localhost:54329/tms?schema=public
PLATFORM_DATABASE_URL=postgresql://tms_platform:tms_platform@localhost:54329/tms?schema=public
API_PORT=4410
NODE_ENV=development
# key เซ็น access token (HS256, >= 32 ตัว) นอก production — production ต้องตั้ง AUTH_JWT_SECRET จาก secret manager (ST1-T01/T04)
AUTH_DEV_SECRET=dev-only-secret-change-me-0123456789abcdef
# ST7-T01 Open API: API key (`tk_live_…`) เก็บเป็น HMAC-SHA256 ด้วย pepper นี้ (≥ 32 ตัว) — นอก dev/test ต้องตั้ง (ไม่ตั้ง = ใช้ key ไม่ได้)
#   เปลี่ยน pepper = key ทุกตัวใช้ไม่ได้ (ต้องออกใหม่) → ตั้งครั้งเดียวจาก secret manager ห้ามหมุนตามรอบ
# API_KEY_PEPPER=
# token ของ OAuth2 client credentials เซ็น RS256 — โฟลเดอร์ไฟล์ <kid>.pem (RSA ≥ 2048, ไฟล์ที่ชื่อเรียงท้ายใช้เซ็น ทุกไฟล์ใช้ตรวจ + ประกาศที่ /v1/.well-known/jwks.json)
#   หมุนกุญแจ: วางไฟล์ใหม่ (เช่น 2027-01-01.pem) → restart → รอ 1 ชม. (อายุ token) → ลบไฟล์เก่า → restart · หรือ OAUTH_SIGNING_KEY=<PEM ก้อนเดียว>
#   dev/test ไม่ตั้ง = สร้างกุญแจชั่วคราวในหน่วยความจำ (restart แล้ว client ขอ token ใหม่) · นอก dev/test ไม่ตั้ง = ออก token ไม่ได้
#   สร้าง: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out keys/2026-11-17.pem
# OAUTH_SIGNING_KEYS_DIR=./keys
# IP ผู้เรียก (audit, rate limit ต่อ IP, IP allowlist ของ API key) อ่านจาก X-Forwarded-For ตามจำนวน proxy ที่ไว้ใจ
#   ไม่ตั้ง: staging/production = 0 (ไม่เชื่อ X-Forwarded-For — IP = ของ load balancer, ระบบเตือนตอนบูต) · dev/test = 1 (vite proxy)
#   deploy หลัง load balancer ต้องตั้งเอง: จำนวนชั้น (1, 2) หรือ IP/CIDR ของ proxy คั่นด้วย , (10.0.0.0/8,loopback)
#   ตั้งเกินจริง = ผู้เรียกปลอม IP ผ่าน allowlist/rate limit ได้ · นอก dev/test ไม่มี API_KEY_PEPPER / กุญแจเซ็น = API ไม่ยอมเริ่ม
# TRUST_PROXY=1
# key ring สำหรับเข้ารหัสฟิลด์ (keyId:base64 32 bytes, ตัวแรก = ใช้เข้ารหัส) — production ดึงจาก KMS
# ST7-T04 webhook: secret ของ endpoint เข้ารหัสด้วย FIELD_ENCRYPTION_KEYS · dev/test เท่านั้น: ยอมปลายทางในเครื่อง/IP ภายใน (production ไม่สนค่านี้)
# WEBHOOK_ALLOW_PRIVATE_TARGETS=1
# ST7-T22 webhook ขาเข้า (POST /v1/inbound/{provider}/{token}): เพดานต่อ IP / ต่อ token ต่อนาที (ค่าเริ่ม 600)
# INBOUND_RATE_LIMIT_PER_IP_MIN=600
# INBOUND_RATE_LIMIT_PER_TOKEN_MIN=600
# ST7-T13 เปิด ErpAdapter จำลอง (Demo — ST7-T14) นอก dev/test (staging/sandbox เท่านั้น) — production ไม่ตั้ง
# ERP_DEMO_ADAPTERS=1
# ST8-T01 mock KRS (packages/mock-krs — `pnpm --filter @tms/mock-krs dev`, ไม่ต่อ KRS จริง) · พอร์ต/คีย์ของ mock เท่านั้น
# MOCK_KRS_PORT=4784
# MOCK_KRS_API_KEY=mock-krs-key
# ST6-T01/T01c ปิดต้นทุนเที่ยว (COMPLETED → COSTED + ปันลง DO ตามสัดส่วนรายได้) — เปิดโดยค่าเริ่มต้น · kill switch: ตั้ง 0 = 409 trip_costing_unavailable
# TRIP_COSTING_ENABLED=0
FIELD_ENCRYPTION_KEYS=k1:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
BLIND_INDEX_KEY=YmxpbmQtaW5kZXgtZGV2LW9ubHktMDEyMzQ1Njc4OWE=

# ST1-T02: ตรวจรหัสผ่านที่รั่วกับ Have I Been Pwned (k-anonymity) — นอก dev/test เปิดเสมอ (ตั้ง false เพื่อปิดเท่านั้น)
HIBP_ENABLED=false

# ST1-T08: ลายเซ็น URL อัปโหลด/ดาวน์โหลดไฟล์ (≥ 32 ตัว; ไม่ตั้ง = ใช้ AUTH_JWT_SECRET แยก label) · ที่เก็บไฟล์ในเครื่อง · ฐาน URL สาธารณะของ API
# DOCUMENT_URL_SECRET=
FILES_ROOT=./.data/files

# ST9-T19 monitoring + alert (ทำงานในระบบเอง ไม่ส่งข้อมูลออกนอก — ตัวอย่าง Prometheus ใน infra/monitoring/ ไม่บังคับ)
#   /v1/healthz (liveness) · /v1/readyz (DB + migration + heartbeat worker; 503 = ไม่พร้อม) — public
#   /v1/metrics (Prometheus text) ต้องส่ง Authorization: Bearer <METRICS_TOKEN> (≥ 24 ตัว) · ไม่ตั้ง = 404 · เปิดเฉพาะเครือข่ายภายใน
# METRICS_TOKEN=
#   ผู้รับ alert (คั่นด้วย ,) — ไม่ตั้ง = ทีม Platform Console ที่ ACTIVE บทบาท SUPER_ADMIN / SUPPORT
# MONITOR_ALERT_EMAILS=oncall@innovera.co.th
#   ปรับเกณฑ์ (JSON บางส่วน — ค่าเริ่มใน apps/api/src/modules/monitoring/monitor-config.ts) เช่น {"outbox_lag":{"threshold":600}}
# MONITOR_RULES=
#   self-probe ทุกต้นนาที จากทั้ง worker และ API (นาทีละ 1 แถว — availability 99.5%) — worker อยู่คนละเครื่องกับ API ต้องตั้ง
#   ให้ชี้ API ผ่านเครือข่ายภายใน (ค่าเริ่ม http://127.0.0.1:$API_PORT/v1/readyz)
# MONITOR_PROBE_URL=
#   runbook: /v1/healthz, /v1/readyz เป็น public (ไม่ผ่าน rate limit ของ /v1 เพราะไม่รู้บริษัท) และ /v1/readyz อ่านฐานทุกครั้ง
#   → จำกัดอัตราต่อ IP ที่ proxy/load balancer (เช่น 60 req/นาที) หรือเปิดเฉพาะเครือข่ายภายใน
#   off = ปิด heartbeat/probe/evaluator ทั้ง worker และ API
# MONITOR=on
# PUBLIC_API_BASE_URL=https://api.example.com

# ST1-T06: ลายเซ็น magic link (≥ 32 ตัว; ไม่ตั้ง = ใช้ AUTH_JWT_SECRET แยก label) · rate limit ของ /v1/public/* ต่อ IP ต่อนาที
# MAGIC_LINK_SECRET=
# PUBLIC_RATE_LIMIT_PER_MIN=120
# ST7-T08 rate limit ของ /v1 (ต่อบริษัท/key/ผู้ใช้/คำขอหนัก — ค่าตาม profile ใน apps/api/src/http/rate-limit/profiles.ts)
#   off = ปิด (ค่าเริ่ม: เปิด ยกเว้น NODE_ENV=test) · เส้นตายถามที่เก็บ (มิลลิวินาที) เกินแล้วปล่อยผ่าน (fail-open) + log
# RATE_LIMIT=on
# RATE_LIMIT_TIMEOUT_MS=1000
#   pool แยกของตัวจำกัด (role platform) · key HMAC ของ IP ในที่เก็บ (base64 32 byte; ไม่ตั้ง = ใช้ BLIND_INDEX_KEY)
# RATE_LIMIT_POOL=4
# RATE_LIMIT_KEY=
# TOKEN_RATE_LIMIT_PER_IP_PER_MIN=120

# ST1-T03: อีเมล transactional — ยังไม่เลือกผู้ให้บริการ (D-32) · dev ใช้ log (เนื้อหาออก log ของ API/worker)
# นอก dev ต้องตั้ง EMAIL_TRANSPORT=smtp + EMAIL_SMTP_URL (smtps://user:pass@host:465) + EMAIL_FROM
# EMAIL_TRANSPORT=log
# EMAIL_SMTP_URL=
# EMAIL_FROM=TMS <no-reply@example.com>
# ฐาน URL ของเว็บ (ลิงก์ในอีเมล) — นอก dev ต้องตั้ง ห้ามเดาจาก Host header
# PUBLIC_WEB_BASE_URL=https://app.example.com

# ST2-T03: ผู้ให้บริการแผนที่/geocode/ระยะทาง — ยังไม่เลือก (Q-D3 / ADR ST0-T01) จึงมีแค่ 2 แบบที่ไม่ส่งข้อมูลออกนอกระบบ
# - mock : ค่าเริ่มต้นของ dev/test — ประมาณพิกัดจากชื่ออำเภอ/จังหวัดในที่อยู่ (ห้ามใช้นอก dev/test: ระบบไม่ยอมเริ่ม)
# - none : ค่าเริ่มต้นนอก dev/test — ไม่ geocode อัตโนมัติ ผู้ใช้ปักหมุด/กรอกระยะเอง
# เพิ่มผู้ให้บริการจริง = adapter 1 ไฟล์ใน apps/api/src/modules/geo/providers/ + เพิ่มใน providerFromEnv()
# GEO_PROVIDER=mock
# ST2-T03 review: ปุ่มประมาณจากที่อยู่ — 60 ครั้ง/นาที/บริษัท (ค่าเริ่มต้น) · เส้นตายต่อการเรียก (มิลลิวินาที, ค่าเริ่มต้น 5000)
# GEOCODE_RATE_PER_MIN=60
# GEO_TIMEOUT_MS=5000
# ST3-T21 ส่งลิงก์ทาง LINE / SMS — ไม่ตั้ง: dev/test = mock (ไม่ออกนอกเครื่อง), อื่น ๆ = none (ปิด → ผู้ใช้คัดลอกลิงก์เอง)
# production ตั้ง mock = ล้มตอนบูต · LINE channel access token ตั้งต่อบริษัทผ่าน PATCH /v1/settings/messaging (เข้ารหัสในฐาน)
# LINE_PROVIDER=line
# LINE_API_BASE=https://api.line.me
# SMS_PROVIDER=http
# SMS_HTTP_URL=https://sms-provider.example/v1/send
# SMS_HTTP_TOKEN=
# SMS_SENDER=TMS

# ทำงานขนานหลาย worktree (HANDOFF §ทำงานขนาน — ตั้งด้วย `bash scripts/lane-init.sh <lane> <portBase>`)
# ฐาน test/e2e = ชื่อฐานใน DATABASE_URL + _test / _e2e (tms → tms_test, tms_e2e)
# WEB_PORT=4420
# E2E_API_PORT=4510
# E2E_WEB_PORT=4520
# ST8-T16 mock AccountSystem (packages/mock-accountsystem — `pnpm --filter @tms/mock-accountsystem dev`, ไม่ต่อระบบจริง) · พอร์ต/คีย์ของ mock เท่านั้น
# MOCK_ACCOUNTSYSTEM_PORT=4785
# MOCK_ACCOUNTSYSTEM_API_KEY=inn_tms_mockkey000000000000000000
