# คัดลอกเป็น .env (ไม่ commit) — ค่าเหล่านี้ใช้กับ docker compose ใน dev เท่านั้น
DATABASE_URL=postgresql://tms:tms@localhost:54329/tms?schema=public
APP_DATABASE_URL=postgresql://tms_app:tms_app@localhost:54329/tms?schema=public
PLATFORM_DATABASE_URL=postgresql://tms_platform:tms_platform@localhost:54329/tms?schema=public
API_PORT=4410
NODE_ENV=development
# ชั่วคราว ST0 — ST1 แทนด้วย auth จริง (อย่างน้อย 32 ตัวอักษร)
AUTH_DEV_SECRET=dev-only-secret-change-me-0123456789abcdef
# key ring สำหรับเข้ารหัสฟิลด์ (keyId:base64 32 bytes, ตัวแรก = ใช้เข้ารหัส) — production ดึงจาก KMS
FIELD_ENCRYPTION_KEYS=k1:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
