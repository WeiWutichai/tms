# คัดลอกเป็น .env (ไม่ commit) — ค่าเหล่านี้ใช้กับ docker compose ใน dev เท่านั้น
DATABASE_URL=postgresql://tms:tms@localhost:54329/tms?schema=public
APP_DATABASE_URL=postgresql://tms_app:tms_app@localhost:54329/tms?schema=public
PLATFORM_DATABASE_URL=postgresql://tms_platform:tms_platform@localhost:54329/tms?schema=public
API_PORT=4410
NODE_ENV=development
# key เซ็น access token (HS256, >= 32 ตัว) นอก production — production ต้องตั้ง AUTH_JWT_SECRET จาก secret manager (ST1-T01/T04)
AUTH_DEV_SECRET=dev-only-secret-change-me-0123456789abcdef
# key ring สำหรับเข้ารหัสฟิลด์ (keyId:base64 32 bytes, ตัวแรก = ใช้เข้ารหัส) — production ดึงจาก KMS
FIELD_ENCRYPTION_KEYS=k1:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
BLIND_INDEX_KEY=YmxpbmQtaW5kZXgtZGV2LW9ubHktMDEyMzQ1Njc4OWE=

# ST1-T02: ตรวจรหัสผ่านที่รั่วกับ Have I Been Pwned (k-anonymity) — นอก dev/test เปิดเสมอ (ตั้ง false เพื่อปิดเท่านั้น)
HIBP_ENABLED=false

# ST1-T08: ลายเซ็น URL อัปโหลด/ดาวน์โหลดไฟล์ (≥ 32 ตัว; ไม่ตั้ง = ใช้ AUTH_JWT_SECRET แยก label) · ที่เก็บไฟล์ในเครื่อง · ฐาน URL สาธารณะของ API
# DOCUMENT_URL_SECRET=
FILES_ROOT=./.data/files
# PUBLIC_API_BASE_URL=https://api.example.com

# ST1-T06: ลายเซ็น magic link (≥ 32 ตัว; ไม่ตั้ง = ใช้ AUTH_JWT_SECRET แยก label) · rate limit ของ /v1/public/* ต่อ IP ต่อนาที
# MAGIC_LINK_SECRET=
# PUBLIC_RATE_LIMIT_PER_MIN=120

# ST1-T03: อีเมล transactional — ยังไม่เลือกผู้ให้บริการ (D-32) · dev ใช้ log (เนื้อหาออก log ของ API/worker)
# นอก dev ต้องตั้ง EMAIL_TRANSPORT=smtp + EMAIL_SMTP_URL (smtps://user:pass@host:465) + EMAIL_FROM
# EMAIL_TRANSPORT=log
# EMAIL_SMTP_URL=
# EMAIL_FROM=TMS <no-reply@example.com>
# ฐาน URL ของเว็บ (ลิงก์ในอีเมล) — นอก dev ต้องตั้ง ห้ามเดาจาก Host header
# PUBLIC_WEB_BASE_URL=https://app.example.com

# ST2-T03: ผู้ให้บริการแผนที่/geocode/ระยะทาง — ยังไม่เลือก (Q-D3 / ADR ST0-T01) จึงมีแค่ 2 แบบที่ไม่ส่งข้อมูลออกนอกระบบ
# - mock : ค่าเริ่มต้นของ dev/test — ประมาณพิกัดจากชื่ออำเภอ/จังหวัดในที่อยู่ (ห้ามใช้นอก dev/test: ระบบไม่ยอมเริ่ม)
# - none : ค่าเริ่มต้นนอก dev/test — ไม่ geocode อัตโนมัติ ผู้ใช้ปักหมุด/กรอกระยะเอง
# เพิ่มผู้ให้บริการจริง = adapter 1 ไฟล์ใน apps/api/src/modules/geo/providers/ + เพิ่มใน providerFromEnv()
# GEO_PROVIDER=mock
# ST2-T03 review: ปุ่มประมาณจากที่อยู่ — 60 ครั้ง/นาที/บริษัท (ค่าเริ่มต้น) · เส้นตายต่อการเรียก (มิลลิวินาที, ค่าเริ่มต้น 5000)
# GEOCODE_RATE_PER_MIN=60
# GEO_TIMEOUT_MS=5000
# ST3-T21 ส่งลิงก์ทาง LINE / SMS — ไม่ตั้ง: dev/test = mock (ไม่ออกนอกเครื่อง), อื่น ๆ = none (ปิด → ผู้ใช้คัดลอกลิงก์เอง)
# production ตั้ง mock = ล้มตอนบูต · LINE channel access token ตั้งต่อบริษัทผ่าน PATCH /v1/settings/messaging (เข้ารหัสในฐาน)
# LINE_PROVIDER=line
# LINE_API_BASE=https://api.line.me
# SMS_PROVIDER=http
# SMS_HTTP_URL=https://sms-provider.example/v1/send
# SMS_HTTP_TOKEN=
# SMS_SENDER=TMS
